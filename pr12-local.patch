+# Local diagnostics, not for committing. Paste into panarctic.jl just before `run!(simulation)`.
+# Every 6 hours: where are the fastest currents and the salinity extremes? Daily: full 3-D ocean output for the
+# strait and window tools. Uses `cpu_grid` and `wet` from the initial stability check earlier in the script.
+
+function report_extremes(sim)
+    ocean = sim.model.ocean.model
+    u, v, w = ocean.velocities
+    S = ocean.tracers.S
+    ℓ = (Center(), Center(), Center())
+
+    function locate(name, m, I, units)
+        i, j, k = Tuple(I)
+        iᶜ, jᶜ = min(i, Nx), min(j, Ny)
+        @info @sprintf("    %s = %.2f %s at (%d, %d, %d) ≈ %.1f°E %.1f°N, z = %.0f m, %d cells from an open edge",
+                       name, m, units, i, j, k,
+                       Oceananigans.Grids.λnode(iᶜ, jᶜ, k, cpu_grid, ℓ...), Oceananigans.Grids.φnode(iᶜ, jᶜ, k, cpu_grid, ℓ...),
+                       Oceananigans.Grids.znode(iᶜ, jᶜ, k, cpu_grid, ℓ...), min(j - 1, Ny - j))
+    end
+
+    for (name, φ) in (("max|u|", u), ("max|v|", v))
+        a = abs.(Array(interior(φ)))
+        replace!(a, NaN => 0)
+        locate(name, findmax(a)..., "m/s")
+    end
+
+    Sᵃ = Array(interior(S))
+    locate("min S", findmin(ifelse.(wet, Sᵃ, Inf))..., "psu")
+    locate("max S", findmax(ifelse.(wet, Sᵃ, -Inf))..., "psu")
+    return nothing
+end
+
+add_callback!(simulation, report_extremes, TimeInterval(6hours))
+
+ocean.output_writers[:full] = JLD2Writer(ocean.model, merge(ocean.model.tracers, (; u, v, w));
+                                         filename = joinpath(output_dir, "arctic_ocean_full.jld2"),
+                                         schedule = TimeInterval(1days),
+                                         overwrite_files = true)
+
 run!(simulation)
 
