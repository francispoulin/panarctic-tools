From a3f408ccf9097377bcb0c1cafe876737303126f2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 13:08:54 -0500
Subject: [PATCH] Restart probe on the ocean model itself; boundary bands and
 the GLORYS parent; restart_advance_parent

131's probe failed on reading ocean.model.velocities: ocean.model is NumericalEarth's NestedModel (parent: GLORYS at
the open sides, child: the ocean model, exchanger: the boundary bands). The probe now reads the child, and also prints
the child's and the GLORYS parent's clocks, the exchanger's band times and the ranges of every boundary band.

The checkpoint holds only the NestedModel's child, so after a restore the parent's clock and its two-day GLORYS window
are still at the start date, and 118's update_state! samples the bands for the restored day from that window. With
[output] restart_advance_parent = true, advance_parent! (what a run does after every step) brings the parent to the
restored time before the updates. config_smoke_restart_probe_parent.toml: the probe with it (submit with --force, after
config_smoke_restart_probe.toml, which is the probe without it).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Abhhvmt8meskhHGBgsw6yN
---
 config_smoke_restart_probe_parent.toml | 102 +++++++++++++++++++++++++
 panarctic.jl                           |  33 +++++++-
 2 files changed, 134 insertions(+), 1 deletion(-)
 create mode 100644 config_smoke_restart_probe_parent.toml

diff --git a/config_smoke_restart_probe_parent.toml b/config_smoke_restart_probe_parent.toml
new file mode 100644
index 0000000..238c0e5
--- /dev/null
+++ b/config_smoke_restart_probe_parent.toml
@@ -0,0 +1,102 @@
+# Patch 132. Restart probe with [output] restart_advance_parent (the GLORYS parent moved to the restored time before the
+# updates); otherwise as config_smoke_restart_probe.toml (patch 131): as part b of the restart test (config_smoke_restart_b.toml), but with [output] restart_probe:
+# after the restore it synchronises CUDA after each update and each component's first step, to find the stage whose
+# kernel throws the DomainError, prints the range of the restored fields and fluxes, and does not run. Submit with
+# --force (smoke_restart has output). Send the "Restart probe" lines of the runner log.
+# Patch 112. Restart test, part b: continues smoke_restart (part a) from its latest checkpoint ([output] restart) to
+# 6 Sep 2005, appending to its output. Must run after part a has finished.
+
+
+architecture = "GPU"   # "GPU" or "CPU"
+experiment   = "smoke_restart"  # name of the run: output and figures go to output_dir/<experiment> and figure_dir/<experiment>
+
+[grid]
+spacing_km = 100     # largest horizontal grid spacing [km] (at the pole; ~15% finer near the Atlantic edge)
+Nz         = 100    # vertical levels
+depth      = 5000   # maximum depth (m)
+bathymetry       = "GEBCO2026"   # "GEBCO2026" (15″, with IBCAO), "ETOPO" (ETOPO 2022, 60″) or "GLORYS" (GLORYS's own sea floor)
+bottom           = "partial"     # "partial": bottom cells cut at the sea floor; "full": whole cells
+partial_cell_fix = true          # with partial cells: flux-form momentum advection at bottom-cell thickness jumps
+                                 # (Oceananigans.jl#6533), which removes the bottom jets of issue #6532
+
+[time]
+start_date = 2005-09-01   # initial condition (GLORYS); the run starts at 00:00 on this date
+end_date   = 2005-09-06   # the run ends at 00:00 on this date; for short tests a date and time, e.g. 1993-01-01T03:00
+dt_minutes = 10           # time step
+
+[atmosphere]
+jra55 = "multi_year"   # "multi_year": JRA55 for the run's own dates; "repeat_year": the 1990–91 repeat year
+pressure = false           # true: JRA55's sea-level pressure acts on the ocean (nested_pressure_fix.jl). Off for now: with it,
+                           # Fram Strait drifts far from GLORYS (1–5 Jan 1993, 15 km: day 4 −12.4 Sv, GLORYS −2.1, −5.6
+                           # without pressure; the same at 100 km), which looks like an error in the pressure path, not
+                           # physics. Main has had no pressure on the ocean since #43.
+inverse_barometer = false  # with pressure = true: GLORYS's η carries no response to the pressure (issue #37), so add the
+                           # inverse-barometer sea level −(pᵃ − ⟨pᵃ⟩)/(ρ₀g) to GLORYS's η at the open sides (Flather) and
+                           # to the initial free surface; its domain mean is removed, so the volume is unchanged.
+                           # Keep false with pressure = false: then neither the model nor GLORYS feels the pressure
+
+[output]
+checkpoint_cleanup = false   # true: only the latest checkpoint is kept (patch 112)
+scorecard       = false   # no scorecard from the runner (patch 112); analyses run by hand afterwards
+average_hours   = 24      # time-averaged output (3D ocean, free surface, sea ice), written to output_dir
+checkpoint_days = 1      # how often the full model state is saved for restarts
+restart         = true   # true: continue from the latest checkpoint in output_dir
+restart_probe   = true   # find the stage that fails after the restore; no run (patch 131)
+restart_advance_parent = true   # bring the ocean's GLORYS parent to the restored time first (patch 132)
+monitor_hours   = 1       # monitor.csv: transports through the open sides, mean η against GLORYS's, volume budget,
+                          # fastest point (plotting/volume_budget.jl, plotting/max_speed.jl); 0 = off
+mixing_depth    = 0      # daily CATKE κᶜ and e over the top this many metres in arctic_mixing.jld2; 0 = off
+post_run_analysis = false # the runner's scorecard step is skipped too (scorecard = false below)
+
+[transports]
+# Volume, heat, salt and freshwater transports through the sections below and the open boundaries (see transports.jl).
+online                = true   # true: computed every time step and averaged over average_hours, written to arctic_transports.jld2
+reference_temperature = 0      # heat transport relative to this temperature (°C)
+reference_salinity    = 34.8   # freshwater transport relative to this salinity (g/kg)
+
+# Each section is a great-circle path through (longitude, latitude) waypoints. Positive transport flows to the right,
+# walking from the first waypoint to the last; these are ordered so that positive is into the Arctic. Both ends should
+# be on land, so the section spans the whole strait on any grid. Check with plotting/transport_sections.jl.
+[transports.sections]
+# Fram Strait follows the mooring array at 78°50′N; intermediate waypoints keep the great circles on that latitude.
+fram_strait         = { lon = [15.0, 10.0, 5.0, 0.0, -5.0, -10.0, -15.0, -20.0],
+                        lat = [78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333] }
+# Barents Sea Opening follows the mooring line from Norway (Fugløya) via Bjørnøya to Sørkapp, Svalbard.
+barents_sea_opening = { lon = [20.0, 19.0, 16.5],  lat = [70.0, 74.45, 77.0] }
+bering_strait       = { lon = [-166.0, -171.0], lat = [66.0, 66.0] }
+davis_strait        = { lon = [-53.0, -63.0],   lat = [67.0, 66.5] }
+
+[paths]
+data_dir   = ""   # where downloads are stored; "" = each dataset's default cache
+output_dir = "output"    # model output: time averages (.jld2), checkpoints and the config; one folder per experiment
+figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
+
+[boundaries]
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
+tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
+relaxation_hours     = 6   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
+                           # over this timescale; 0 = off (nested_ocean_model's default is 6)
+
+# Volume control (volume_control.jl): the net inflow through the two open sides together is pinned at every barotropic
+# substep, as NEMO and ROMS do; Flather splits it between the sides. Without it the domain's volume drifts from GLORYS's.
+follow_glorys_volume      = true   # true: the net inflow follows GLORYS's domain-mean η, with the surface freshwater handed back
+volume_relaxation_days    = 1      # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency    = false  # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+# net_inflow_Sv           = 0.0    # with follow_glorys_volume = false: a constant net inflow instead (Sv, positive into the domain);
+                                   # with neither, Flather alone (no volume control)
+net_inflow_depth_exponent = 0.5    # the pin's correction to each boundary column ∝ Hᵖ: 0 uniform per length, 1 uniform velocity
+                                   # (NEMO, ROMS), 0.5 a uniform shift of GLORYS's η in Flather
+
+[ocean]
+closure = "NEMO"   # NEMO's TKE scheme (patch 085): "CATKE" (default), "NEMO", "RiBased", "TKEDissipation" or "none"
+nemo_parameters = "glorys12"          # "reference" (NEMO 3.6-4.x namelist) or "glorys12" (NEMO 3.1 code defaults; patch 087)
+# nemo_surface_tke = 3.75             # surface TKE = this × u★² (NEMO's rn_ebb; default: the preset's)
+# nemo_convective_diffusivity = 100   # m²/s where N² < 0 (NEMO's rn_evd; 0 = off)
+
+[sea_ice]
+ice_salinity               = 6        # g/kg (default 4)
+ice_ocean_drag_coefficient = 5e-3     # (default 5.5e-3)
+ice_compressive_strength   = 20000    # P*, N/m² (default 27 500)
+albedo                     = "ccsm3"  # "constant" (0.7, default) or "ccsm3" (state-dependent, SeaIceAlbedo)
diff --git a/panarctic.jl b/panarctic.jl
index 0bb114e..13c8158 100644
--- a/panarctic.jl
+++ b/panarctic.jl
@@ -456,8 +456,28 @@ function probe_ranges(prefix, fields)
     return nothing
 end
 
+# ocean.model is a NestedModel (parent: GLORYS at the open sides; child: the ocean model; exchanger: the boundary bands)
+ocean_child = hasproperty(ocean.model, :child) ? ocean.model.child : ocean.model
+
+# The clock of the ocean's GLORYS parent and the boundary bands the exchanger samples from it, with their times
+function probe_boundaries(label)
+    hasproperty(ocean.model, :parent) || return nothing
+    @info @sprintf("Restart probe: %s: child at day %.4f, GLORYS parent at day %.4f", label,
+                   ocean_child.clock.time / 86400, ocean.model.parent.clock.time / 86400)
+    exchanger = ocean.model.exchanger
+    hasproperty(exchanger, :bands) || return nothing
+    @info @sprintf("Restart probe: %s: boundary bands at days %.4f (previous) and %.4f (current)", label,
+                   exchanger.times.previous / 86400, exchanger.times.current / 86400)
+    for side in keys(exchanger.bands), name in keys(exchanger.bands[side])
+        band = exchanger.bands[side][name]
+        probe_ranges("$label band $side.$name", (; previous = band.previous, current = band.current))
+    end
+    return nothing
+end
+
 function probe_all_ranges(label)
-    probe_ranges("$label ocean", merge(ocean.model.velocities, ocean.model.tracers, (; η = ocean.model.free_surface.η)))
+    probe_boundaries(label)
+    probe_ranges("$label ocean", merge(ocean_child.velocities, ocean_child.tracers, (; η = ocean_child.free_surface.η)))
     probe_ranges("$label sea_ice", (; h = sea_ice.model.ice_thickness, ℵ = sea_ice.model.ice_concentration,
                                      u = sea_ice.model.velocities.u, v = sea_ice.model.velocities.v))
     probe_ranges("$label sea_ice.dynamics", sea_ice.model.dynamics.auxiliaries.fields)
@@ -468,6 +488,17 @@ function probe_all_ranges(label)
     return nothing
 end
 
+# [output] restart_advance_parent = true (patch 132): bring the ocean's GLORYS parent to the restored time before the
+# updates, as advance_parent! does after every step of a run. The checkpoint holds only the NestedModel's child, so after
+# a restore the parent's clock and its two-day GLORYS window are still at the start date, and the exchanger samples the
+# boundary bands for the restored day from that window.
+restart_probe && probe_boundaries("restored, before the updates")
+if restart && get(output, "restart_advance_parent", false) && hasproperty(ocean.model, :parent)
+    NumericalEarth.NestedModels.advance_parent!(ocean.model.parent, ocean_child.clock)
+    restart_probe && probe_sync("advance_parent! of the ocean's GLORYS parent")
+    @info @sprintf("Restart: the ocean's GLORYS parent moved to day %.4f", ocean.model.parent.clock.time / 86400)
+end
+
 if restart
     for component in (coupled_model.radiation, coupled_model.atmosphere, coupled_model.land)
         isnothing(component) || Oceananigans.TimeSteppers.update_state!(component)
