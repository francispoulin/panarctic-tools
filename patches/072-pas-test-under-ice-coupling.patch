+# Two under-ice options for the tests of issue #48 (see panarctic-tools/docs/sea-ice-coupling-review.md).
+#
+# [ocean] catke_under_ice: CATKE's surface shear-driven TKE flux, Cᵂu★ u★³, times a function of the ice concentration ℵ,
+#   as NEMO 4 attenuates its surface TKE input under ice (nn_eice; Allende et al. 2024, GMD 17, 7445):
+#   "open_water" → 1 − ℵ, "tanh" → 1 − tanh(10ℵ) (NEMO's default), "none" (default) → stock CATKE.
+#   The convective part of the flux is unchanged.
+# [sea_ice] ice_ocean_friction_velocity: the u★ of the three-equation ice–ocean heat and salt exchange.
+#   "constant" (default): NumericalEarth's 0.002 m/s. "drag": √Cᴰ |uⁱ − uᵒ| from the ice and top-cell velocities and
+#   the ice–ocean drag coefficient, as LIM2 (McPhee), never below 0.002 m/s.
+
+using Oceananigans.Architectures: Adapt
+using Oceananigans.BoundaryConditions: FluxBoundaryCondition
+using Oceananigans.TurbulenceClosures.TKEBasedVerticalDiffusivities: TKETopBoundaryConditionParameters,
+    CATKEVerticalDiffusivity, top_tke_flux, friction_velocity
+using NumericalEarth.EarthSystemModels: ThreeEquationHeatFlux
+using NumericalEarth.EarthSystemModels: InterfaceComputations
+
+#####
+##### CATKE's surface TKE flux under ice
+#####
+
+struct OpenWaterFraction end
+struct TanhAttenuation end
+
+@inline under_ice_factor(::OpenWaterFraction, ℵ) = 1 - ℵ
+@inline under_ice_factor(::TanhAttenuation, ℵ)   = 1 - tanh(10ℵ)
+
+@inline function under_ice_top_tke_flux(i, j, grid, clock, fields, parameters, closure::CATKEVerticalDiffusivity, buoyancy)
+    J  = top_tke_flux(i, j, grid, clock, fields, parameters, closure, buoyancy)
+    u★ = friction_velocity(i, j, grid, clock, fields, parameters.top_velocity_boundary_conditions)
+    ice = parameters.top_tracer_boundary_conditions
+    @inbounds ℵ = ice.ice_concentration[i, j, 1]
+    f = under_ice_factor(ice.attenuation, ℵ)
+    return J + (1 - f) * closure.turbulent_kinetic_energy_equation.Cᵂu★ * u★^3
+end
+
+function attenuate_catke_under_ice!(ocean_model, ice_concentration, choice)
+    attenuation = choice == "open_water" ? OpenWaterFraction() :
+                  choice == "tanh"       ? TanhAttenuation() :
+                  error("[ocean] catke_under_ice must be \"none\", \"open_water\" or \"tanh\", not \"$choice\"")
+    ocean_model.closure isa CATKEVerticalDiffusivity ||
+        error("[ocean] catke_under_ice needs closure = \"CATKE\"")
+
+    e_bcs = ocean_model.tracers.e.boundary_conditions
+    stock = e_bcs.top.condition.parameters
+    tracer_bcs = merge(stock.top_tracer_boundary_conditions, (; ice_concentration, attenuation))
+    parameters = TKETopBoundaryConditionParameters(tracer_bcs, stock.top_velocity_boundary_conditions)
+    e_bcs.top = FluxBoundaryCondition(under_ice_top_tke_flux; discrete_form = true, parameters)
+
+    @info "CATKE surface shear-driven TKE flux under ice × " * (choice == "tanh" ? "(1 − tanh(10ℵ))" : "(1 − ℵ)")
+    return nothing
+end
+
+#####
+##### Ice–ocean friction velocity from the drag
+#####
+
+struct DragFrictionVelocity{U, V, I, J, FT}
+    uᵒ :: U
+    vᵒ :: V
+    uⁱ :: I
+    vⁱ :: J
+    drag_coefficient :: FT
+    minimum_friction_velocity :: FT
+    kᴺ :: Int
+end
+
+Adapt.adapt_structure(to, f::DragFrictionVelocity) =
+    DragFrictionVelocity(Adapt.adapt(to, f.uᵒ), Adapt.adapt(to, f.vᵒ), Adapt.adapt(to, f.uⁱ), Adapt.adapt(to, f.vⁱ),
+                         f.drag_coefficient, f.minimum_friction_velocity, f.kᴺ)
+
+@inline Δu²(i, j, f) = @inbounds (f.uⁱ[i, j, 1] - f.uᵒ[i, j, f.kᴺ])^2
+@inline Δv²(i, j, f) = @inbounds (f.vⁱ[i, j, 1] - f.vᵒ[i, j, f.kᴺ])^2
+
+# Squared velocity difference at the cell centre as the mean over its four faces, as LIM2's ust2s
+@inline function InterfaceComputations.get_friction_velocity(f::DragFrictionVelocity, i, j, grid, τˣ, τʸ, ρᵒᶜ)
+    Δ² = (Δu²(i, j, f) + Δu²(i + 1, j, f) + Δv²(i, j, f) + Δv²(i, j + 1, f)) / 2
+    return max(f.minimum_friction_velocity, sqrt(f.drag_coefficient * Δ²))
+end
+
+function drag_based_heat_flux(sea_ice, ocean_model)
+    uⁱ, vⁱ = sea_ice.model.velocities.u, sea_ice.model.velocities.v
+    Cᴰ = sea_ice.model.dynamics.external_momentum_stresses.bottom.Cᴰ
+    u★ = DragFrictionVelocity(ocean_model.velocities.u, ocean_model.velocities.v, uⁱ, vⁱ,
+                              Cᴰ, convert(typeof(Cᴰ), 0.002), size(ocean_model.grid, 3))
+
+    @info "Ice–ocean heat and salt exchange with u★ = max(√Cᴰ |uⁱ − uᵒ|, 0.002 m/s), Cᴰ = $Cᴰ"
+    return ThreeEquationHeatFlux(sea_ice; friction_velocity = u★)
+end
