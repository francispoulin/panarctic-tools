@@ -0,0 +1,222 @@
+# Freshwater budget by region: does the river water leave the shelves, and where does it go?
+#
+#   julia +1.13 --project=. analysis/freshwater_budget.jl [config.toml]
+#
+# Why (25 Nov 2026): in the four-month NEMO runs every basin region is too salty at the surface (Beaufort Gyre +0.18,
+# Central Arctic +0.19) while the Siberian shelves are slightly fresh (−0.04), and narrowing the river footprint from
+# 1.2° to 0.3° made the shelves fresher and the Beaufort saltier without changing much else. The Beaufort Gyre receives
+# no river water directly (rivers.md, table 2): its fresh water comes from the shelves and Bering Strait. This measures
+# that supply.
+#
+# For each region (those of salinity_drift.jl and rivers.md, first match, and the rest of the domain split at 66°N):
+#
+#   FW      = Σ (34.8 − S) / 34.8 × cell volume, full depth, every cell (saltier ones counting negative), with the
+#             cells' z⋆ volumes: minus the salt content, in fresh water units;
+#   lateral = Σ over the faces between this region and its neighbours of u × face area × (34.8 − S_face) / 34.8, inward,
+#             with S_face the mean of the two cells (as transports.jl);
+#   surface = dFW/dt − lateral: what entered across the surface (rivers, icebergs, precipitation − evaporation, ice melt
+#             minus ice growth), plus the sub-daily covariance of u and S that daily averages miss;
+#   ice     = d/dt of the region's sea-ice volume Σ h ℵ A, as liquid fresh water (× ρᵢ/ρ₀ × (1 − Sᵢ/34.8)): ice grown
+#             in the region or carried in.
+#
+# Rates are monthly means in mSv (1 mSv = 1000 m³/s), from the change between the last daily averages of consecutive
+# months (the first month from the first daily average). Compare "surface" with rivers.md (table 2, same regions):
+# surface ≈ rivers + icebergs + P − E − (ice grown locally). "rest, south of 66°N" touches the open boundaries, which
+# are not region faces here: its "surface" also holds what enters through them.
+#
+# Reads arctic_ocean.jld2 (daily S, u, v, η) and arctic_sea_ice.jld2 (h, ℵ) from `output_dir`. Writes
+# freshwater_budget.md to `output_dir` and freshwater_budget.png (cumulative budget per region) to `figure_dir`. CPU,
+# one day at a time: minutes for a four-month run.
+
+include("../config.jl")
+include("../transports.jl")
+
+using Oceananigans.Operators: Azᶜᶜᶜ, Vᶜᶜᶜ, Δzᶜᶜᶜ
+using Oceananigans.OutputReaders: OnDisk
+using Oceananigans.Models.HydrostaticFreeSurfaceModels: update_zstar_scaling!
+using CairoMakie, Dates
+
+start_date = DateTime(config["time"]["start_date"])
+window     = config["output"]["average_hours"] / 24     # days
+S_ref      = 34.8
+ice_salinity = get(get(config, "sea_ice", Dict{String, Any}()), "ice_salinity", 4)
+ice_to_liquid = 900 / 1020 * (1 - ice_salinity / S_ref)   # ClimaSeaIce's ice density, NumericalEarth's reference density
+
+#####
+##### Grid and regions
+#####
+
+St = FieldTimeSeries(ocean_output_file, "S"; backend = OnDisk())
+ut = FieldTimeSeries(ocean_output_file, "u"; backend = OnDisk())
+vt = FieldTimeSeries(ocean_output_file, "v"; backend = OnDisk())
+ηt = FieldTimeSeries(ocean_output_file, "η"; backend = OnDisk())
+ht = FieldTimeSeries(sea_ice_output_file, "h"; backend = OnDisk())
+ℵt = FieldTimeSeries(sea_ice_output_file, "ℵ"; backend = OnDisk())
+
+zgrid = ηt.grid   # the z⋆ scaling is updated on this grid each day, as in analysis/arctic_volume.jl
+Nx, Ny, Nz = size(zgrid)
+C = Center()
+ccc = (C, C, C)
+cell_λ = [mod(λnode(i, j, Nz, zgrid, ccc...) + 180, 360) - 180 for i in 1:Nx, j in 1:Ny]
+cell_φ = [φnode(i, j, Nz, zgrid, ccc...) for i in 1:Nx, j in 1:Ny]
+wet    = [!inactive_node(i, j, Nz, zgrid, ccc...) for i in 1:Nx, j in 1:Ny]
+area   = [Azᶜᶜᶜ(i, j, Nz, zgrid) for i in 1:Nx, j in 1:Ny]
+depth  = [sum(Δzᶜᶜᶜ(i, j, k, zgrid) for k in 1:Nz if !inactive_node(i, j, k, zgrid, ccc...); init = 0.0) for i in 1:Nx, j in 1:Ny]
+
+regions = [("Beaufort Gyre",    (λ, φ, H) -> 70.5 ≤ φ ≤ 80.5 && -170 ≤ λ ≤ -130 && H > 300),
+           ("Central Arctic",   (λ, φ, H) -> φ > 82),
+           ("Siberian shelves", (λ, φ, H) -> 66 ≤ φ ≤ 82 && (λ ≥ 60 || λ ≤ -170) && H < 200),
+           ("Barents Sea",      (λ, φ, H) -> 68 ≤ φ ≤ 80 && 15 ≤ λ < 60),
+           ("Nordic Seas",      (λ, φ, H) -> 62 ≤ φ ≤ 79 && -20 ≤ λ < 15),
+           ("Archipelago",      (λ, φ, H) -> 68 ≤ φ ≤ 82 && -125 ≤ λ ≤ -80),
+           ("Baffin Bay",       (λ, φ, H) -> 67 ≤ φ ≤ 78 && -80 < λ ≤ -55),
+           ("rest, north of 66°N", (λ, φ, H) -> φ ≥ 66),
+           ("rest, south of 66°N", (λ, φ, H) -> true)]
+region_names = first.(regions)
+Nr = length(regions)
+region_of = [wet[i, j] ? findfirst(r -> r[2](cell_λ[i, j], cell_φ[i, j], depth[i, j]), regions) : 0 for i in 1:Nx, j in 1:Ny]
+
+# Faces between two regions: (location, i, j, region on the low-index side, region on the high-index side)
+interfaces = Tuple{Symbol, Int, Int, Int, Int}[]
+for j in 1:Ny, i in 2:Nx
+    a, b = region_of[i-1, j], region_of[i, j]
+    a > 0 && b > 0 && a != b && push!(interfaces, (:u, i, j, a, b))
+end
+for j in 2:Ny, i in 1:Nx
+    a, b = region_of[i, j-1], region_of[i, j]
+    a > 0 && b > 0 && a != b && push!(interfaces, (:v, i, j, a, b))
+end
+@info "$(length(interfaces)) faces between regions"
+
+#####
+##### Daily freshwater content, lateral exchange and ice volume
+#####
+
+saved = findall(>(0), ηt.times)
+time_days  = ηt.times[saved] ./ 86400 .- window / 2
+Nt    = length(saved)
+
+function region_freshwater(S)
+    total = zeros(Nr)
+    for k in 1:Nz, j in 1:Ny, i in 1:Nx
+        r = region_of[i, j]
+        r > 0 && !inactive_node(i, j, k, zgrid, ccc...) && (total[r] += (S_ref - S[i, j, k]) / S_ref * Vᶜᶜᶜ(i, j, k, zgrid))
+    end
+    return total
+end
+
+# exchange[a, b]: fresh water flowing from region a into region b (m³/s), net
+function freshwater_exchange(u, v, S)
+    exchange = zeros(Nr, Nr)
+    for (ℓ, i, j, a, b) in interfaces, k in 1:Nz
+        if ℓ == :u
+            open_face(i, j, k, zgrid, fcc...) || continue
+            flux = u[i, j, k] * Axᶠᶜᶜ(i, j, k, zgrid) * (S_ref - (S[i-1, j, k] + S[i, j, k]) / 2) / S_ref
+        else
+            open_face(i, j, k, zgrid, cfc...) || continue
+            flux = v[i, j, k] * Ayᶜᶠᶜ(i, j, k, zgrid) * (S_ref - (S[i, j-1, k] + S[i, j, k]) / 2) / S_ref
+        end
+        exchange[a, b] += flux
+        exchange[b, a] -= flux
+    end
+    return exchange
+end
+
+function region_ice(h, ℵ)
+    total = zeros(Nr)
+    for j in 1:Ny, i in 1:Nx
+        r = region_of[i, j]
+        r > 0 && (total[r] += h[i, j, 1] * ℵ[i, j, 1] * area[i, j])
+    end
+    return total * ice_to_liquid
+end
+
+freshwater = zeros(Nt, Nr)       # m³
+exchange   = zeros(Nt, Nr, Nr)   # m³/s
+ice        = zeros(Nt, Nr)       # m³ of liquid fresh water
+for (n, m) in enumerate(saved)
+    update_zstar_scaling!(zgrid, ηt[m])
+    S = Array(interior(St[m]))
+    freshwater[n, :]  = region_freshwater(S)
+    exchange[n, :, :] = freshwater_exchange(ut[m], vt[m], S)
+    ice_index = findfirst(t -> abs(t - ηt.times[m]) < 60, ht.times)
+    ice[n, :]         = region_ice(ht[ice_index], ℵt[ice_index])
+    n % 10 == 0 && @info @sprintf("freshwater budget: day %d / %d", n, Nt)
+end
+
+lateral = [-sum(exchange[n, r, :]) for n in 1:Nt, r in 1:Nr]   # into each region, m³/s
+lateral_integrated = zeros(Nt, Nr)
+for n in 2:Nt
+    lateral_integrated[n, :] = lateral_integrated[n-1, :] .+ (lateral[n, :] .+ lateral[n-1, :]) ./ 2 .* (time_days[n] - time_days[n-1]) * 86400
+end
+
+#####
+##### Monthly means
+#####
+
+dates = start_date .+ Millisecond.(round.(Int, time_days .* 86400e3))
+month_ends = Int[]
+for n in 1:Nt
+    (n == Nt || month(dates[n + 1]) != month(dates[n])) && push!(month_ends, n)
+end
+month_starts = [1; month_ends[1:end-1]]
+mSv(Δ, a, b) = Δ / ((time_days[b] - time_days[a]) * 86400) / 1000
+
+io = IOBuffer()
+println(io, "# Freshwater budget by region: $experiment\n")
+println(io, "Relative to $S_ref, full depth, from the daily averages. mSv (1 mSv = 1000 m³/s), monthly means. dFW/dt: change ",
+            "of the region's fresh water (minus its salt content); lateral: fresh water carried in across the region's sides; ",
+            "surface = dFW/dt − lateral (rivers, icebergs, P − E, ice melt − growth, and sub-daily u S covariance); ice: change ",
+            "of the region's sea-ice volume as liquid fresh water (positive: ice gained, grown or carried in). ",
+            "Compare surface with rivers.md, table 2.\n")
+println(io, "## 1. By region and month\n")
+println(io, "| Region | Month | dFW/dt | lateral | surface | ice | largest exchanges (into the region) |")
+println(io, "|---|---|---|---|---|---|---|")
+for r in 1:Nr, (a, b) in zip(month_starts, month_ends)
+    dFW  = mSv(freshwater[b, r] - freshwater[a, r], a, b)
+    lat  = mSv(lateral_integrated[b, r] - lateral_integrated[a, r], a, b)
+    dice = mSv(ice[b, r] - ice[a, r], a, b)
+    into = [sum(-exchange[a:b, r, s]) / (b - a + 1) / 1000 for s in 1:Nr]   # mSv from region s into r
+    partners = sort(filter(s -> s != r, 1:Nr), by = s -> -abs(into[s]))[1:2]
+    println(io, @sprintf("| %s | %s | %+.0f | %+.0f | %+.0f | %+.0f | %s |", region_names[r], Dates.format(dates[b], "u yyyy"),
+                         dFW, lat, dFW - lat, dice, join([@sprintf("%s %+.0f", region_names[s], into[s]) for s in partners], ", ")))
+end
+
+println(io, "\n## 2. Exchanges between regions, whole run (mSv, net, largest first)\n")
+println(io, "| From | To | mSv |")
+println(io, "|---|---|---|")
+run_mean = dropdims(sum(exchange, dims = 1), dims = 1) ./ Nt ./ 1000
+region_pairs = [(a, b) for a in 1:Nr, b in 1:Nr if a < b && run_mean[a, b] != 0]
+sort!(region_pairs, by = p -> -abs(run_mean[p...]))
+for (a, b) in region_pairs
+    from, to = run_mean[a, b] > 0 ? (a, b) : (b, a)
+    println(io, @sprintf("| %s | %s | %.1f |", region_names[from], region_names[to], abs(run_mean[a, b])))
+end
+
+table_text = String(take!(io))
+print(table_text)
+table_file = joinpath(output_dir, "freshwater_budget.md")
+write(table_file, table_text)
+@info "Wrote $table_file"
+
+#####
+##### Cumulative budget per region (km³)
+#####
+
+fig = Figure(size = (1500, 800))
+for r in 1:Nr
+    ax = Axis(fig[fldmod1(r, 5)...]; title = region_names[r], xlabel = "days since $(Date(start_date))",
+              ylabel = mod1(r, 5) == 1 ? "since the first day (km³)" : "")
+    hlines!(ax, 0; color = :black, linewidth = 0.5)
+    ΔFW = (freshwater[:, r] .- freshwater[1, r]) ./ 1e9
+    ∫lateral = lateral_integrated[:, r] ./ 1e9
+    lines!(ax, time_days, ΔFW; color = :black, label = "ΔFW")
+    lines!(ax, time_days, ∫lateral; color = :blue, label = "lateral")
+    lines!(ax, time_days, ΔFW .- ∫lateral; color = :red, label = "surface")
+    lines!(ax, time_days, (ice[:, r] .- ice[1, r]) ./ 1e9; color = :gray, linestyle = :dash, label = "ice")
+    r == 1 && axislegend(ax; position = :lt, framevisible = false, labelsize = 10)
+end
+Label(fig[0, :], "$experiment: freshwater budget relative to $S_ref"; fontsize = 18)
+file = joinpath(figure_dir, "freshwater_budget.png")
+save(file, fig)
+@info "Wrote $file"
