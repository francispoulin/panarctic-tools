From 80cc86f759eebd069540f1e7c8e44fe8cc385db7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 21:03:57 -0500
Subject: [PATCH] nested: setup.jl and gateways.jl import what they use
 (on_architecture and others came from monitor.jl)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvpGsnzaJJu3V9mqrum
---
 nested/gateways.jl | 7 +++++--
 nested/setup.jl    | 1 +
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/nested/gateways.jl b/nested/gateways.jl
index 336ccf7..7b7b233 100644
--- a/nested/gateways.jl
+++ b/nested/gateways.jl
@@ -7,8 +7,11 @@
 # and warns when an end is in water. Hourly snapshots go to <output_dir>/gateways.csv; plot_gateways.jl takes daily
 # means and compares them with the mooring estimates. glorys_gateways (below) puts GLORYS through the same sections.
 
-using Oceananigans.Grids: inactive_node
-using NumericalEarth.NestedModels: child_frame_sources, parent_ocean_sources
+using Oceananigans.Architectures: on_architecture
+using Oceananigans.Grids: inactive_node, λnode, φnode
+using NumericalEarth.DataWrangling: default_download_directory, default_horizontal_padding
+using NumericalEarth.NestedModels: boundary_location, child_frame_sources, parent_ocean_sources, sample_parent!
+using Printf
 using Oceananigans.Operators: Δxᶜᶠᶜ, Δyᶠᶜᶜ, Δzᶜᶠᶜ, Δzᶠᶜᶜ
 
 const ρ₀cₚ = 1026 * 3991.9   # J m⁻³ K⁻¹
diff --git a/nested/setup.jl b/nested/setup.jl
index cdc8c4f..6d5c7c6 100644
--- a/nested/setup.jl
+++ b/nested/setup.jl
@@ -7,6 +7,7 @@ config = TOML.parsefile(config_file)
 @info "Settings from $config_file" config
 
 using NumericalEarth, Oceananigans, Oceananigans.Units
+using Oceananigans.Architectures: on_architecture
 using Oceananigans.OrthogonalSphericalShellGrids: ConformalConicGrid
 using NumericalEarth.DataWrangling: GEBCO2026
 using CopernicusMarine   # enables the GLORYS download extension
