From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 06:53:02 -0500
Subject: [PATCH 42/43] Smoke-test config (~100 km, four days) and a script
 comparing the transports of two experiments

config_smoke_test.toml is config.toml on a ~100 km grid from 1 to 5 January 1993, for a quick check
that the model builds and runs after a change. analysis/compare_transports.jl prints, for every section
and quantity in arctic_transports.jld2, the largest difference between two experiments, so a change that
should leave the answer alone can be checked, and one that should not can be measured.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Abhhvkp8Pai9cvvctGUDX5
---
 analysis/compare_transports.jl | 32 +++++++++++++++++++
 config_smoke_test.toml         | 58 ++++++++++++++++++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 analysis/compare_transports.jl
 create mode 100644 config_smoke_test.toml

diff --git a/analysis/compare_transports.jl b/analysis/compare_transports.jl
new file mode 100644
index 0000000..08a851d
--- /dev/null
+++ b/analysis/compare_transports.jl
@@ -0,0 +1,32 @@
+# Compare the online transports (arctic_transports.jld2) of two experiments: for every section and quantity, the
+# largest difference between their averages at the times both have, and the largest value, for scale.
+#
+#   julia +1.13 --project=. analysis/compare_transports.jl output/<experiment_a> output/<experiment_b>
+#
+# Used to check that a change leaves the model's answer alone (smoke test before and after), or to see what it moved.
+
+using Pkg
+Pkg.activate(joinpath(@__DIR__, ".."))
+
+using JLD2, Printf
+
+length(ARGS) == 2 || error("Usage: analysis/compare_transports.jl <output folder a> <output folder b>")
+files = map(dir -> joinpath(dir, "arctic_transports.jld2"), ARGS)
+
+jldopen(files[1]) do a
+    jldopen(files[2]) do b
+        units = a["metadata/units"]
+        names = sort(intersect(keys(a["timeseries"]), keys(b["timeseries"])))
+        @printf("%-40s %12s %12s   %s\n", "transport", "max |a - b|", "max |a|", "averages compared")
+        for name in names
+            name == "t" && continue
+            iterations = sort(intersect(filter(!=("serialized"), keys(a["timeseries/$name"])),
+                                        filter(!=("serialized"), keys(b["timeseries/$name"]))), by = s -> parse(Int, s))
+            isempty(iterations) && continue
+            va = [only(a["timeseries/$name/$i"]) for i in iterations]
+            vb = [only(b["timeseries/$name/$i"]) for i in iterations]
+            unit = units[last(split(name, "_"))]
+            @printf("%-40s %12.3e %12.3e   %d   %s\n", name, maximum(abs, va .- vb), maximum(abs, va), length(iterations), unit)
+        end
+    end
+end
diff --git a/config_smoke_test.toml b/config_smoke_test.toml
new file mode 100644
index 0000000..ee6736c
--- /dev/null
+++ b/config_smoke_test.toml
@@ -0,0 +1,58 @@
+# Smoke test: config.toml on a ~100 km grid for four days, to check that the model builds and runs after a change.
+# Run it before and after the change (with different `experiment` names, or renaming the output folder in between)
+# and compare the two with analysis/compare_transports.jl. With all defaults unchanged, the transports should agree.
+#
+# Run with:  julia +1.13 --project=. panarctic.jl config_smoke_test.toml
+#
+# Note: a grid spacing that has not been run before needs the GEBCO regridding once (~55 GB of memory; cached after).
+
+architecture = "GPU"   # "GPU" or "CPU"
+experiment   = "smoke_test"  # name of the run: output and figures go to output_dir/<experiment> and figure_dir/<experiment>
+
+[grid]
+spacing_km = 100    # largest horizontal grid spacing [km] (at the pole; ~15% finer near the Atlantic edge)
+Nz         = 20     # vertical levels
+depth      = 5000   # maximum depth (m)
+
+[time]
+start_date = 1993-01-01   # initial condition (GLORYS); the run starts at 00:00 on this date
+end_date   = 1993-01-05   # the run ends at 00:00 on this date; for short tests a date and time, e.g. 1993-01-01T03:00
+dt_minutes = 10           # time step
+
+[atmosphere]
+jra55 = "multi_year"   # "multi_year": JRA55 for the run's own dates; "repeat_year": the 1990–91 repeat year
+
+[output]
+average_hours   = 24      # time-averaged output (3D ocean, free surface, sea ice), written to output_dir
+checkpoint_days = 30      # how often the full model state is saved for restarts
+restart         = false   # true: continue from the latest checkpoint in output_dir
+
+[transports]
+# Volume, heat, salt and freshwater transports through the sections below and the open boundaries (see transports.jl).
+online                = true   # true: computed every time step and averaged over average_hours, written to arctic_transports.jld2
+reference_temperature = 0      # heat transport relative to this temperature (°C)
+reference_salinity    = 34.8   # freshwater transport relative to this salinity (g/kg)
+
+# Each section is a great-circle path through (longitude, latitude) waypoints. Positive transport flows to the right,
+# walking from the first waypoint to the last; these are ordered so that positive is into the Arctic. Both ends should
+# be on land, so the section spans the whole strait on any grid. Check with plotting/transport_sections.jl.
+[transports.sections]
+# Fram Strait follows the mooring array at 78°50′N; intermediate waypoints keep the great circles on that latitude.
+fram_strait         = { lon = [15.0, 10.0, 5.0, 0.0, -5.0, -10.0, -15.0, -20.0],
+                        lat = [78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333] }
+# Barents Sea Opening follows the mooring line from Norway (Fugløya) via Bjørnøya to Sørkapp, Svalbard.
+barents_sea_opening = { lon = [20.0, 19.0, 16.5],  lat = [70.0, 74.45, 77.0] }
+bering_strait       = { lon = [-166.0, -171.0], lat = [66.0, 66.0] }
+davis_strait        = { lon = [-53.0, -63.0],   lat = [67.0, 66.5] }
+
+[paths]
+data_dir   = ""   # where downloads are stored; "" = each dataset's default cache
+output_dir = "output"    # model output: time averages (.jld2), checkpoints and the config; one folder per experiment
+figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
+
+[boundaries]
+velocity_inflow_days = 1   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow
+tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
+relaxation_hours     = 0   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
+                           # over this timescale; 0 = off (nested_ocean_model's default is 6)
+
