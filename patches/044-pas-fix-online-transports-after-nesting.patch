From fff015ed94bfef557baa85d733391ffcf993b5d6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 07:26:08 -0500
Subject: [PATCH] Online transports on the nested ocean's child (after #43)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

#41 was written before #43, where ocean.model became the NestedModel (GLORYS parent and child), so
ocean.model.tracers no longer exists and every run with [transports] online = true stopped before
time stepping (FieldError: type NestedModel has no field tracers). The transports now take the child's
tracers, are written from the child like the other output, and use the child's grid, which the model runs
on (Open sides, bathymetry blended toward GLORYS near them), for the section faces.

Also: "$λ°E" in the section-end warning read λ°E as one variable name (UndefVarError), so the warning
itself failed; now "$(λ)°E".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Abhhvkp8Pai9cvvctGUDX5
---
 panarctic.jl  | 7 ++++---
 transports.jl | 2 +-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/panarctic.jl b/panarctic.jl
index e2bcd98..e4a4665 100644
--- a/panarctic.jl
+++ b/panarctic.jl
@@ -164,12 +164,13 @@ simulation.output_writers[:sea_ice] = JLD2Writer(sea_ice.model, sea_ice_outputs;
 # averaged over the same interval, so they include the covariance of velocity and tracers within each average, which
 # transports computed offline from the averaged fields (analysis/transports.jl) miss.
 if get(transport_settings(config), "online", false)
-    sections = vcat(gateway_sections(grid, config), boundary_sections(grid))
+    # On the child's grid, which the model runs on (Open sides, bathymetry blended toward GLORYS near them)
+    sections = vcat(gateway_sections(child.grid, config), boundary_sections(child.grid))
     ρ₀, cₚ = reference_density(ocean), heat_capacity(ocean)
-    transports = section_transports(grid, u, v, ocean.model.tracers.T, ocean.model.tracers.S, sections;
+    transports = section_transports(child.grid, u, v, child.tracers.T, child.tracers.S, sections;
                                     reference_values(config)..., reference_density = ρ₀, heat_capacity = cₚ)
 
-    simulation.output_writers[:transports] = JLD2Writer(ocean.model, transports;
+    simulation.output_writers[:transports] = JLD2Writer(child, transports;
                                                         filename = transport_output_file,
                                                         schedule = AveragedTimeInterval(output["average_hours"] * hours),
                                                         init = (file, model) -> save_transport_metadata!(file, config, sections;
diff --git a/transports.jl b/transports.jl
index 137a0ff..746f6c6 100644
--- a/transports.jl
+++ b/transports.jl
@@ -134,7 +134,7 @@ function gateway_sections(grid, config)
         for (λ, φ) in ((first(lons), first(lats)), (last(lons), last(lats)))
             i, j = Tuple(argmax(dot3.(x, Ref(unit_vector(λ, φ)))))   # nearest cell centre
             inactive_node(i, j, Nz, cpu_grid, ccc...) ||
-                @warn "Section $name ends in the ocean at ($λ°E, $φ°N), cell ($i, $j): move the waypoint onto land."
+                @warn "Section $name ends in the ocean at ($(λ)°E, $(φ)°N), cell ($i, $j): move the waypoint onto land."
         end
 
         @info @sprintf("Section %s: %d open faces at the surface (%d u, %d v), deepest %.0f m",
-- 
2.43.0

