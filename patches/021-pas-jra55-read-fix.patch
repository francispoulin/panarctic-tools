From 6dc87a6577452c0d4e7839203d907294cd0f695b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 13:55:09 -0500
Subject: [PATCH] Workaround: JRA55 reads for runs that do not start on 1
 January

NumericalEarth's jra55_read_data splits a wrapped (Cyclical) index list where
the index equals 1, which exists only for runs starting on the first record of
the year's file. A 1 September 2005 start fails in build_flux_routing with
-(::Nothing, ::Int64). jra55_read_fix.jl reads in sorted order and restores the
requested order. To be fixed upstream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvmJrXadb5LQWtyUVrz
---
 nested/jra55_read_fix.jl   | 14 ++++++++++++++
 nested/panarctic_nested.jl |  1 +
 2 files changed, 15 insertions(+)
 create mode 100644 nested/jra55_read_fix.jl

diff --git a/nested/jra55_read_fix.jl b/nested/jra55_read_fix.jl
new file mode 100644
index 0000000..cbc398e
--- /dev/null
+++ b/nested/jra55_read_fix.jl
@@ -0,0 +1,14 @@
+# Workaround for NumericalEarth's `jra55_read_data` (DataWrangling/JRA55/JRA55_field_time_series.jl): with
+# `Cyclical()` time indexing, the records held in memory wrap from the end of the run back to its start, so the
+# indices into the year's JRA55 file are not sorted. NumericalEarth splits them where the index equals 1, which
+# exists only when the run starts on the first record of the file (1 January). Any other start date (here
+# 1 September 2005) fails with `MethodError: no method matching -(::Nothing, ::Int64)` while building the river
+# routing, or later when a reload wraps. Read the indices in sorted order and put them back in the requested order.
+# To be fixed upstream; remove this file then.
+
+@eval NumericalEarth.DataWrangling.JRA55 function jra55_read_data(ds, name, i, j, nn)
+    issorted(nn) && return ds[name][i, j, nn]
+    order = sortperm(nn)
+    data  = ds[name][i, j, nn[order]]
+    return data[:, :, invperm(order)]
+end
diff --git a/nested/panarctic_nested.jl b/nested/panarctic_nested.jl
index 37fc4cb..79ab540 100644
--- a/nested/panarctic_nested.jl
+++ b/nested/panarctic_nested.jl
@@ -15,6 +15,7 @@
 # hour to <output_dir>/nested_surface.jld2 and nested_free_surface.jld2.
 
 include("setup.jl")
+include("jra55_read_fix.jl")   # JRA55 reads for runs that do not start on 1 January
 include("monitor.jl")
 include("gateways.jl")
 include("net_inflow_control.jl")
