From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 06:46:08 -0500
Subject: [PATCH] =?UTF-8?q?NEMOMixingLength:=20separate=20surface=20floor?=
 =?UTF-8?q?=20=E2=84=93=E2=82=80=E1=B5=90=E2=81=B1=E2=81=BF=20for=20the=20?=
 =?UTF-8?q?surface=20mixing=20length?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The surface mixing length is now max(ℓ₀ᵐⁱⁿ, Cᴿ u★²). The default ℓ₀ᵐⁱⁿ = 0.01 m (= ℓᵐⁱⁿ) keeps the previous behaviour;
Cᴿ = 0, ℓ₀ᵐⁱⁿ = 0.4 m, ℓᵐⁱⁿ = 0.1 m reproduce NEMO 3.1-3.2 defaults (ln_mxl0 = false, rn_lmin0, rn_lmin), the TKE code
GLORYS12 runs. Test added.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvoXen2vZSP4ZrEkbYa
---
 .../nemo_tke_vertical_diffusivity.jl             | 13 ++++++++++---
 test/turbulence_closures/nemo_tke.jl             | 16 ++++++++++++++++
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/src/TurbulenceClosures/turbulence_closure_implementations/TKEBasedVerticalDiffusivities/nemo_tke_vertical_diffusivity.jl b/src/TurbulenceClosures/turbulence_closure_implementations/TKEBasedVerticalDiffusivities/nemo_tke_vertical_diffusivity.jl
index bb7c232..10188b2 100644
--- a/src/TurbulenceClosures/turbulence_closure_implementations/TKEBasedVerticalDiffusivities/nemo_tke_vertical_diffusivity.jl
+++ b/src/TurbulenceClosures/turbulence_closure_implementations/TKEBasedVerticalDiffusivities/nemo_tke_vertical_diffusivity.jl
@@ -8,7 +8,8 @@
 #   ∂t e = ∂z(κᵉ ∂z e) + νᵉ S² − κᶜ N² − Cᴰ e^{3/2} / ℓ,       κᵉ = νᵉ,  νᵉ = max(Cᵏ ℓ √e, νᵇ)
 #   κᶜ = max(Pr⁻¹ max(Cᵏ ℓ √e, κᵇ), κᵇ),   Pr⁻¹ = max(1 / Prᵐᵃˣ, Riᶜ / max(Riᶜ, Ri))                (nn_pdl = 1)
 #   ℓ = √(2e) / N on faces, then limited so that it grows by at most the distance between faces away from the sea
-#       floor (ℓᵐⁱⁿ) and the surface (ℓ₀ = Cᴿ u★², the stress-dependent surface length of ln_mxl0)         (nn_mxl = 2)
+#       floor (ℓᵐⁱⁿ) and the surface (ℓ₀ = max(ℓ₀ᵐⁱⁿ, Cᴿ u★²), the stress-dependent surface length of ln_mxl0;
+#       Cᴿ = 0 and ℓ₀ᵐⁱⁿ = 0.4 m is NEMO 3.1-3.2's default, ln_mxl0 = false)                            (nn_mxl = 2)
 #   e = e₀ = max(e₀ᵐⁱⁿ, Cᵉᵇ u★²) at the surface (rn_ebb: wave breaking, kept under ice as in NEMO), e ≥ minimum_tke
 #   κᶜ = κᵉᵛᵈ where N² < −10⁻¹² (enhanced vertical diffusion, ln_zdfevd; νᵉᵛᵈ for momentum, off by default: nn_evdm = 0)
 #
@@ -34,7 +35,10 @@ with NEMO's reference values as defaults:
 
 - `Cᵏ`: eddy diffusivity coefficient, νᵉ = Cᵏ ℓ √e (`rn_ediff` = 0.1)
 - `Cᴿ`: surface mixing length ℓ₀ = Cᴿ u★², the von Kármán constant times Stacey's 2 × 10⁵ over g (`ln_mxl0`)
-- `ℓᵐⁱⁿ`: smallest mixing length, 10⁻⁶ / (rn_ediff √rn_emin) = 0.01 m
+- `ℓᵐⁱⁿ`: smallest mixing length in the interior and at the sea floor, 10⁻⁶ / (rn_ediff √rn_emin) = 0.01 m
+  (NEMO 3.1-3.2: `rn_lmin` = 0.1 m)
+- `ℓ₀ᵐⁱⁿ`: smallest mixing length at the surface (0.01 m; NEMO 3.1-3.2: `rn_lmin0` = 0.4 m, and with
+  `ln_mxl0 = false` the surface length is this value: `Cᴿ = 0`)
 - `Riᶜ`: critical Richardson number of the Prandtl number, 2 / (2 + rn_ediss / rn_ediff) = 2/9
 - `Prᵐᵃˣ`: largest Prandtl number (10)
 - `νᵇ`, `κᵇ`: background viscosity and diffusivity (`rn_avm0` = 1.2 × 10⁻⁴, `rn_avt0` = 1.2 × 10⁻⁵ m² s⁻¹)
@@ -45,6 +49,7 @@ Base.@kwdef struct NEMOMixingLength{FT}
     Cᵏ    :: FT = 0.1
     Cᴿ    :: FT = 0.4 * 2e5 / 9.80665
     ℓᵐⁱⁿ  :: FT = 0.01
+    ℓ₀ᵐⁱⁿ :: FT = 0.01
     Riᶜ   :: FT = 2 / 9
     Prᵐᵃˣ :: FT = 10.0
     νᵇ    :: FT = 1.2e-4
@@ -245,6 +250,7 @@ end
     closure_ij = getclosure(i, j, closure)
     ℓᵐⁱⁿ = closure_ij.mixing_length.ℓᵐⁱⁿ
     Cᴿ = closure_ij.mixing_length.Cᴿ
+    ℓ₀ᵐⁱⁿ = closure_ij.mixing_length.ℓ₀ᵐⁱⁿ
     Cᵉᵇ = closure_ij.turbulent_kinetic_energy_equation.Cᵉᵇ
     e₀ᵐⁱⁿ = closure_ij.turbulent_kinetic_energy_equation.e₀ᵐⁱⁿ
     eᵐⁱⁿ = closure_ij.minimum_tke
@@ -261,7 +267,7 @@ end
     end
 
     # ... and down from the surface, where ℓ = ℓ₀
-    @inbounds ℓ[i, j, Nz+1] = max(ℓᵐⁱⁿ, Cᴿ * u★^2)
+    @inbounds ℓ[i, j, Nz+1] = max(ℓ₀ᵐⁱⁿ, Cᴿ * u★^2)
     for k in Nz:-1:2
         @inbounds ℓ[i, j, k] = min(ℓ[i, j, k], ℓ[i, j, k+1] + Δzᶜᶜᶜ(i, j, k, grid))
     end
@@ -401,6 +407,7 @@ function Base.show(io::IO, closure::NEMOTKEVD)
               "│   ├── Cᵏ:    ", prettysummary(ℓ.Cᵏ), '\n',
               "│   ├── Cᴿ:    ", prettysummary(ℓ.Cᴿ), '\n',
               "│   ├── ℓᵐⁱⁿ:  ", prettysummary(ℓ.ℓᵐⁱⁿ), '\n',
+              "│   ├── ℓ₀ᵐⁱⁿ: ", prettysummary(ℓ.ℓ₀ᵐⁱⁿ), '\n',
               "│   ├── Riᶜ:   ", prettysummary(ℓ.Riᶜ), '\n',
               "│   ├── Prᵐᵃˣ: ", prettysummary(ℓ.Prᵐᵃˣ), '\n',
               "│   ├── νᵇ:    ", prettysummary(ℓ.νᵇ), '\n',
diff --git a/test/turbulence_closures/nemo_tke.jl b/test/turbulence_closures/nemo_tke.jl
index fa5bcdd..a7aa5fd 100644
--- a/test/turbulence_closures/nemo_tke.jl
+++ b/test/turbulence_closures/nemo_tke.jl
@@ -48,6 +48,22 @@ end
             @test κc[k] ≈ 0.01 * sqrt(2e / N²) * sqrt(e) rtol = 1e-10
         end
 
+        @testset "Fixed surface mixing length (NEMO 3.1-3.2, ln_mxl0 = false) [$(typeof(arch))]" begin
+            mixing_length = NEMOMixingLength(Cᴿ = 0.0, ℓᵐⁱⁿ = 0.1, ℓ₀ᵐⁱⁿ = 0.4)
+            grid = RectilinearGrid(arch, size = 32, z = (-128, 0), topology = (Flat, Flat, Bounded))
+            u_bcs = FieldBoundaryConditions(top = FluxBoundaryCondition(-1e-4))
+            model = HydrostaticFreeSurfaceModel(grid; closure = NEMOTKEVerticalDiffusivity(; mixing_length),
+                                                boundary_conditions = (; u = u_bcs), buoyancy = BuoyancyTracer(),
+                                                tracers = :b, coriolis = FPlane(f = 1e-4))
+            N², e = 1e-5, 1e-4
+            set!(model, b = z -> N² * z, e = e)
+            update_state!(model)
+            zᶠ = znodes(model.grid, Face())
+            expected = [min(sqrt(2e / N²), 0.1 + (z + 128), 0.4 - z) for z in zᶠ]
+            expected[1], expected[end] = 0.1, 0.4
+            @test Array(interior(model.closure_fields.ℓ, 1, 1, :)) ≈ expected rtol = 1e-10
+        end
+
         @testset "Enhanced vertical diffusion where N² < 0 [$(typeof(arch))]" begin
             model = nemo_column(arch)
             set!(model, b = z -> - 1e-5 * z, e = 1e-4)
