diff --git a/nested/glorys_bathymetry.jl b/nested/glorys_bathymetry.jl
new file mode 100644
index 0000000..515fd6f
--- /dev/null
+++ b/nested/glorys_bathymetry.jl
@@ -0,0 +1,54 @@
+# GLORYS's own sea floor (`deptho`, static file) regridded onto the model grid, for [grid] bathymetry = "GLORYS", so the
+# gateways and sills have the depths GLORYS's transports were computed over. Same steps as NumericalEarth's
+# regrid_bathymetry (interpolation passes, minimum depth, removal of minor basins). NumericalEarth cannot read `deptho`
+# as a bathymetry (it has no value on land), so the file is read here and land is set to `land_height` first, as
+# `height_above_water` does in regrid_bathymetry. Adapted from the port (fjp/hybrid-obc).
+
+using NumericalEarth.DataWrangling: NCDatasets, metadata_path, BoundingBox, Metadatum
+using NumericalEarth.DataWrangling: default_horizontal_padding
+using NumericalEarth.DataWrangling.GLORYS: GLORYSStatic, GLORYSDaily
+using .NCDatasets: Dataset, dimnames
+using Oceananigans.BoundaryConditions: fill_halo_regions!
+using Oceananigans.Utils: launch!
+using Downloads
+
+function glorys_bottom_height(target_grid; minimum_depth = 15, interpolation_passes = 2, major_basins = 1, land_height = 50)
+    region = BoundingBox(target_grid; padding = default_horizontal_padding(GLORYSDaily()))
+    metadatum = Metadatum(:depth; dataset = GLORYSStatic(), region, dir_kw...)
+    Downloads.download(metadatum)
+    path = metadata_path(metadatum)
+    ds = Dataset(path)
+    var = ds["deptho"]
+    names = dimnames(var)
+    lon = Float64.(ds["longitude"][:])
+    lat = Float64.(ds["latitude"][:])
+    depth = Float64.(coalesce.(var[:, :], NaN))                    # positive down; missing on land
+    close(ds)
+    names[1] == "longitude" || (depth = permutedims(depth))
+    size(depth) == (length(lon), length(lat)) || error("unexpected shape $(size(depth)) of deptho in $path")
+
+    z = ifelse.(isnan.(depth) .| (depth .≤ 0), Float64(land_height), -depth)
+
+    Δλ, Δφ = lon[2] - lon[1], lat[2] - lat[1]
+    periodic = isapprox(length(lon) * Δλ, 360; atol = Δλ / 2)
+    TX = periodic ? Periodic : Bounded
+    west = lon[1] - Δλ / 2
+    east = periodic ? west + 360 : lon[end] + Δλ / 2
+    native_grid = LatitudeLongitudeGrid(CPU(); size = (length(lon), length(lat), 1),
+                                        longitude = (west, east),
+                                        latitude  = (lat[1] - Δφ / 2, min(90, lat[end] + Δφ / 2)),
+                                        z = (0, 1), topology = (TX, Bounded, Bounded), halo = (10, 10, 1))
+    native_z = Field{Center, Center, Nothing}(native_grid)
+    set!(native_z, z)
+    fill_halo_regions!(native_z)
+
+    target_z = NumericalEarth.Bathymetry.interpolate_bathymetry_in_passes(native_z, target_grid; passes = interpolation_passes)
+    minimum_depth > 0 &&
+        launch!(CPU(), target_grid, :xy, NumericalEarth.Bathymetry._enforce_minimum_depth!, target_z, minimum_depth)
+    NumericalEarth.Bathymetry.remove_minor_basins!(target_z, major_basins)
+    fill_halo_regions!(target_z)
+
+    @info @sprintf("GLORYS bathymetry from %s: %d of %d columns wet, deepest %.0f m", path,
+                   count(<(0), interior(target_z)), length(interior(target_z)), -minimum(interior(target_z)))
+    return target_z
+end
diff --git a/nested/runs/tsubouchi-2005-15km-partial-hybridwet-nz50-glorysbathy-2mo.toml b/nested/runs/tsubouchi-2005-15km-partial-hybridwet-nz50-glorysbathy-2mo.toml
new file mode 100644
index 0000000..214c903
--- /dev/null
+++ b/nested/runs/tsubouchi-2005-15km-partial-hybridwet-nz50-glorysbathy-2mo.toml
@@ -0,0 +1,46 @@
+# As tsubouchi-2005-15km-partial-hybridwet-nz50-2mo (50 levels) but with GLORYS's own sea floor ([grid] bathymetry =
+# "GLORYS"), so the gateways have GLORYS's depths. Production settings from 15 November 2026 otherwise: September–October 2005, 15 km, 20 levels, partial bottom cells with the
+# mass-consistent bottom advection fix (Oceananigans PR #6533; here as a run-time override), volume following GLORYS,
+# pressure off, sea ice. Daily averages of the 3-D T, S, u, v (about 8 GB for 61 days) for the gateway sections
+# (heat and freshwater through the BSO and Fram) and the Atlantic Water layer.
+#
+# Load the fix in the REPL first, wet cells only (the version in PR #6533):
+#
+#   include("../../panarctic-tools/sandbox/lake_at_rest/thickness_jump_fixes.jl")   # path from nested/
+#   set_momentum_fix!("hybrid"); set_jump_walls!(false)
+#   empty!(ARGS); push!(ARGS, "runs/tsubouchi-2005-15km-partial-hybridwet-nz50-glorysbathy-2mo.toml"); include("panarctic_nested.jl")
+#
+# Run from the nested/ folder:  julia +1.13 --project=. panarctic_nested.jl [config file]
+
+architecture = "GPU"   # "GPU" or "CPU"
+
+[grid]
+spacing_km = 15
+Nz         = 50
+depth      = 5000        # m
+bathymetry = "GLORYS"
+bottom     = "partial"
+
+[time]
+start_date = 2005-09-01
+days       = 61
+dt_minutes = 10
+
+[boundaries]
+zero_net_inflow = false
+net_inflow_control = false
+follow_glorys_volume = true
+volume_relaxation_days = 1
+follow_glorys_tendency = false
+net_inflow_depth_exponent = 0.5
+
+[coupling]
+coupled  = true
+pressure = false
+
+[output]
+ocean_3d_days = 1        # daily averages of the 3-D T, S, u, v
+
+[paths]
+data_dir   = ""
+output_dir = "output-tsubouchi-2005-15km-partial-hybridwet-nz50-glorysbathy-2mo"
diff --git a/nested/setup.jl b/nested/setup.jl
index 1f5120f..7cb3cd9 100644
--- a/nested/setup.jl
+++ b/nested/setup.jl
@@ -41,11 +41,14 @@ underlying_grid = ConformalConicGrid(arch;
 Nx, Ny = size(underlying_grid)[1:2]
 @info "Grid: $Nx × $Ny × $Nz, largest spacing $(spacing / 1e3) km"
 
-# Regridded on a CPU copy of the grid, as in setup.jl; the result is cached
+# Regridded on a CPU copy of the grid, as in setup.jl; ETOPO and GEBCO results are cached, GLORYS's are recomputed
 bathymetry_kw = (; minimum_depth = 15, interpolation_passes = 2, major_basins = 1)
 cpu_grid = on_architecture(CPU(), underlying_grid)
+include("glorys_bathymetry.jl")
 bottom_height = if config["grid"]["bathymetry"] == "GEBCO2026"
     regrid_bathymetry(cpu_grid, Metadatum(:bottom_height; dataset = GEBCO2026(), dir_kw...); bathymetry_kw...)
+elseif config["grid"]["bathymetry"] == "GLORYS"
+    glorys_bottom_height(cpu_grid; bathymetry_kw...)
 else
     regrid_bathymetry(cpu_grid; bathymetry_kw...)
 end
