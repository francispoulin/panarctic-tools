--- /dev/null
+++ b/nemo_tke_presets.jl
@@ -0,0 +1,46 @@
+# Parameter sets for NEMO's TKE scheme ([ocean] closure = "NEMO", [ocean] nemo_parameters), used by panarctic.jl and
+# by panarctic-tools/les_under_ice/nemo_closure_columns.jl. Each returns the keyword arguments of NEMOMixingLength and
+# NEMOTKEEquation and the minimum TKE (NEMOTKEVerticalDiffusivity's minimum_tke).
+#
+# "reference": NEMO 3.6-4.x's reference namelist (namzdf_tke), the closure's defaults: surface TKE 67.83 u★² with the
+#     stress-dependent surface mixing length (ln_mxl0 = true), minimum length 0.01 m, Riᶜ = 2/9, background
+#     1.2e-4 / 1.2e-5 m²/s.
+# "glorys12": what GLORYS12V1 most likely runs. GLORYS12 is NEMO 3.1 (Copernicus QUID GLO-001-030; Lellouche et al.
+#     2018, 2021) and its TKE module is zdftke2.F90 of September 2008 (which became zdftke.F90 in NEMO 3.2). Its
+#     defaults: rn_ebb = 3.75 (written 0.5 rn_ebb |τ| with τ summed over two u points, so e₀ = 3.75 u★²), ln_mxl0 =
+#     false (surface mixing length fixed at rn_lmin0 = 0.4 m), rn_lmin = 0.1 m in the interior and at the sea floor,
+#     Prandtl number max(0.1, 0.2 / max(0.2, Ri)), rn_emin = 0.7071e-6. Background avm0 = 1e-4, avt0 = 1e-5 m²/s and
+#     convection by enhanced vertical diffusion: Mercator's GLORYS12 product sheet (rn_avevd not published; NEMO's
+#     default 100 m²/s is kept). Mercator does not publish its namelist: these are the code defaults, an assumption.
+#     Not included: the TKE penetration below the mixed layer (nn_etau; "mixing length set to 10 m" in the QUID is
+#     most likely its decay depth, nn_htau = 0), which NEMO multiplies by (1 − ice fraction), and Langmuir cells.
+
+function nemo_tke_preset(name)
+    if name == "reference"
+        return (mixing_length = NamedTuple(), tke_equation = NamedTuple(), minimum_tke = 1e-6)
+    elseif name == "glorys12"
+        return (mixing_length = (Cᴿ = 0.0, ℓᵐⁱⁿ = 0.1, ℓ₀ᵐⁱⁿ = 0.4, Riᶜ = 0.2, Prᵐᵃˣ = 10.0, νᵇ = 1e-4, κᵇ = 1e-5),
+                tke_equation = (Cᴰ = 0.7, Cᵉᵇ = 3.75, e₀ᵐⁱⁿ = 1e-4),
+                minimum_tke = 0.7071e-6)
+    else
+        error("[ocean] nemo_parameters must be \"reference\" or \"glorys12\", not \"$name\"")
+    end
+end
+
+# The closure for a preset; `κᵉᵛᵈ` and `Cᵉᵇ` (nothing: the preset's) override it. Loads the closure into Oceananigans
+# if needed (the vendored copy next to this file).
+function nemo_tke_closure(name = "reference"; κᵉᵛᵈ = nothing, Cᵉᵇ = nothing)
+    TKE = Oceananigans.TurbulenceClosures.TKEBasedVerticalDiffusivities
+    if !isdefined(TKE, :NEMOTKEVerticalDiffusivity)
+        Base.include(TKE, joinpath(@__DIR__, "nemo_tke_vertical_diffusivity.jl"))
+    end
+    :ℓ₀ᵐⁱⁿ in Base.invokelatest(fieldnames, TKE.NEMOMixingLength) ||
+        error("This Julia process has an older NEMO closure loaded (before patch 087): start a new REPL")
+    preset = nemo_tke_preset(name)
+    mixing_length = isnothing(κᵉᵛᵈ) ? preset.mixing_length : merge(preset.mixing_length, (; κᵉᵛᵈ = Float64(κᵉᵛᵈ)))
+    tke_equation = isnothing(Cᵉᵇ) ? preset.tke_equation : merge(preset.tke_equation, (; Cᵉᵇ = Float64(Cᵉᵇ)))
+    return Base.invokelatest(TKE.NEMOTKEVerticalDiffusivity;
+                             mixing_length = Base.invokelatest(TKE.NEMOMixingLength; mixing_length...),
+                             turbulent_kinetic_energy_equation = Base.invokelatest(TKE.NEMOTKEEquation; tke_equation...),
+                             minimum_tke = preset.minimum_tke)
+end
