+++ b/analysis/mixing_timeseries.jl
@@ -0,0 +1,112 @@
+# When and where does CATKE mix the upper ocean? Region means of CATKE's tracer diffusivity κᶜ and turbulent kinetic
+# energy e against depth and time, from the daily averages written with [output] mixing_depth (arctic_mixing.jld2).
+# Mixing all month points to shear; mixing that starts or deepens as the surface cools points to convection.
+#
+#   julia --project=. analysis/mixing_timeseries.jl [config.toml]
+#
+# Writes mixing_timeseries.md (region-mean κᶜ at a few depths, per third of the run) to `output_dir` and
+# mixing_timeseries.png (depth–time sections of log₁₀ κᶜ and log₁₀ e by region) to `figure_dir`.
+
+include("../config.jl")
+
+using Oceananigans
+using Oceananigans.Operators: Azᶜᶜᶜ
+using Oceananigans.OutputReaders: OnDisk
+using CairoMakie, Printf, Statistics
+
+mixing_file = joinpath(output_dir, "arctic_mixing.jld2")
+κt = FieldTimeSeries(mixing_file, "κc"; backend = OnDisk())
+et = FieldTimeSeries(mixing_file, "e";  backend = OnDisk())
+
+grid  = κt.grid
+times = κt.times ./ 86400              # days
+Nx, Ny, Nz = size(grid)
+ug = grid.underlying_grid
+levels = κt.indices[3]                  # the saved levels, k₀:Nz
+zᶠ = [Float64(ug.z.cᵃᵃᶠ[k]) for k in levels]
+zᶜ = [Float64(ug.z.cᵃᵃᶜ[k]) for k in levels]
+
+bottom_height = grid.immersed_boundary.bottom_height
+hb = [Float64(bottom_height[i, j, 1]) for i in 1:Nx, j in 1:Ny]
+λ  = mod.(Array(λnodes(ug, Center(), Center(), Center())) .+ 180, 360) .- 180
+φ  = Array(φnodes(ug, Center(), Center(), Center()))
+A  = [Azᶜᶜᶜ(i, j, 1, ug) for i in 1:Nx, j in 1:Ny]
+H  = max.(-hb, 0)
+ocean = H .> 0
+
+# Regions as in salinity_drift.jl (longitude −180 to 180)
+regions = [("Beaufort Gyre",    (λ, φ, H) -> 70.5 ≤ φ ≤ 80.5 && -170 ≤ λ ≤ -130 && H > 300),
+           ("Central Arctic",   (λ, φ, H) -> φ > 82),
+           ("Siberian shelves", (λ, φ, H) -> 66 ≤ φ ≤ 82 && (λ ≥ 60 || λ ≤ -170) && H < 200),
+           ("Barents Sea",      (λ, φ, H) -> 68 ≤ φ ≤ 80 && 15 ≤ λ < 60),
+           ("Nordic Seas",      (λ, φ, H) -> 62 ≤ φ ≤ 79 && -20 ≤ λ < 15),
+           ("Archipelago",      (λ, φ, H) -> 68 ≤ φ ≤ 82 && -125 ≤ λ ≤ -80),
+           ("Baffin Bay",       (λ, φ, H) -> 67 ≤ φ ≤ 78 && -80 < λ ≤ -55)]
+masks = [[ocean[i, j] && test(λ[i, j], φ[i, j], H[i, j]) for i in 1:Nx, j in 1:Ny] for (_, test) in regions]
+
+# Area-weighted region mean at each saved level, over the columns where that level is above the seafloor
+function region_profile(c, mask, z)
+    profile = fill(NaN, length(z))
+    for n in eachindex(z)
+        w = A .* mask .* (hb .< z[n])
+        W = sum(w)
+        W > 0 && (profile[n] = sum(w .* c[:, :, n]) / W)
+    end
+    return profile
+end
+
+Nt = length(times)
+κ = [zeros(Nt, length(zᶠ)) for _ in regions]
+e = [zeros(Nt, length(zᶜ)) for _ in regions]
+for t in 1:Nt
+    κn = interior(κt[t])
+    en = interior(et[t])
+    for (r, mask) in enumerate(masks)
+        κ[r][t, :] = region_profile(κn, mask, zᶠ)
+        e[r][t, :] = region_profile(en, mask, zᶜ)
+    end
+end
+
+#####
+##### Table: region-mean κᶜ at a few depths, per third of the run
+#####
+
+depths = filter(d -> d < -minimum(zᶠ), [5, 10, 20, 40])
+thirds = [(1, Nt ÷ 3), (Nt ÷ 3 + 1, 2Nt ÷ 3), (2Nt ÷ 3 + 1, Nt)]
+nearest(d) = argmin(abs.(zᶠ .+ d))
+
+io = IOBuffer()
+println(io, "# CATKE mixing: $experiment\n")
+println(io, "Region-mean tracer diffusivity κᶜ (m²/s) from the daily averages, at the level interface nearest each depth, ",
+            "averaged over each third of the run (days).\n")
+println(io, "| Region | Days | " * join(["κᶜ at $(round(-zᶠ[nearest(d)], digits = 1)) m" for d in depths], " | ") * " |")
+println(io, "|---|---|" * repeat("---|", length(depths)))
+for (r, (name, _)) in enumerate(regions), (t₁, t₂) in thirds
+    values = [mean(filter(isfinite, κ[r][t₁:t₂, nearest(d)])) for d in depths]
+    println(io, "| $name | $(round(Int, times[t₁] - 1))–$(round(Int, times[t₂])) | " *
+                join([@sprintf("%.1e", v) for v in values], " | ") * " |")
+end
+table = String(take!(io))
+print(table)
+table_file = joinpath(output_dir, "mixing_timeseries.md")
+write(table_file, table)
+@info "Wrote $table_file"
+
+#####
+##### Figure: depth–time sections by region
+#####
+
+fig = Figure(size = (320 * length(regions), 620))
+for (r, (name, _)) in enumerate(regions)
+    for (row, (field, z, label, limits)) in enumerate(((κ[r], zᶠ, "log₁₀ κᶜ (m²/s)", (-5, -1)),
+                                                      (e[r], zᶜ, "log₁₀ e (m²/s²)", (-7, -3))))
+        ax = Axis(fig[row, r]; title = row == 1 ? name : "", xlabel = row == 2 ? "days" : "",
+                  ylabel = r == 1 ? "z (m)" : "")
+        hm = heatmap!(ax, times, z, log10.(max.(field, 1e-12)); colorrange = limits, colormap = :viridis)
+        r == length(regions) && Colorbar(fig[row, length(regions) + 1], hm; label)
+    end
+end
+Label(fig[0, :], "$experiment: CATKE mixing, region means"; fontsize = 18)
+file = joinpath(figure_dir, "mixing_timeseries.png")
+save(file, fig)
+@info "Wrote $file"
