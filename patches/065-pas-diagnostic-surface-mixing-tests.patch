diff --git a/panarctic.jl b/panarctic.jl
index ca851ff..0109c7e 100644
--- a/panarctic.jl
+++ b/panarctic.jl
@@ -36,6 +36,21 @@ using NumericalEarth.EarthSystemModels: reference_density, heat_capacity
 # The child grid is a copy of `grid` with Open sides and the blended bathymetry: use child.grid below.
 
 bc = config["boundaries"]
+
+# Vertical mixing ([ocean] closure): "CATKE" (default), "RiBased" (Richardson-number based, as in Pacanowski & Philander
+# and NEMO-style schemes; no extra tracers) or "TKEDissipation" (k–ε). For testing how much of the upper-ocean
+# mixing comes from CATKE.
+closure_name = get(get(config, "ocean", Dict{String, Any}()), "closure", "CATKE")
+closure = if closure_name == "CATKE"
+    CATKEVerticalDiffusivity()
+elseif closure_name == "RiBased"
+    Oceananigans.TurbulenceClosures.RiBasedVerticalDiffusivity()
+elseif closure_name == "TKEDissipation"
+    Oceananigans.TurbulenceClosures.TKEDissipationVerticalDiffusivity()
+else
+    error("[ocean] closure must be \"CATKE\", \"RiBased\" or \"TKEDissipation\", not \"$closure_name\"")
+end
+@info "Vertical mixing: $closure_name"
 Δt = config["time"]["dt_minutes"] * minutes
 time_discretization = AdaptiveVerticallyImplicitDiscretization(cfl=0.5)
 net_inflow = net_inflow_setting(bc)
@@ -55,7 +70,7 @@ ocean = nested_ocean_simulation(grid, dataset;
                                 free_surface = SplitExplicitFreeSurface(grid; cfl = 0.7, fixed_Δt = Δt),
                                 momentum_advection = WENOVectorInvariant(; order=5, time_discretization),
                                 tracer_advection = WENO(; order=7, time_discretization, minimum_buffer_upwind_order=1),
-                                closure = CATKEVerticalDiffusivity())
+                                closure)
 
 child = ocean.model.child   # the regional ocean model; ocean.model also holds the GLORYS parent
 
