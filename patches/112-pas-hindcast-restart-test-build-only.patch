@@ -0,0 +1,98 @@
+# Patch 112. Twin of hindcast_2004_2006_nemo_nz100 without spin-up: starts from GLORYS on 1 Sep 2005 and runs the
+# Tsubouchi year only. Comparing the two over Sep 2005 – Aug 2006 shows what the year of spin-up changes. ~30 h, ~125 GB.
+
+
+architecture = "GPU"   # "GPU" or "CPU"
+experiment   = "hindcast_2005_2006_nemo_nz100_nospinup"  # name of the run: output and figures go to output_dir/<experiment> and figure_dir/<experiment>
+
+[grid]
+spacing_km = 15     # largest horizontal grid spacing [km] (at the pole; ~15% finer near the Atlantic edge)
+Nz         = 100    # vertical levels
+depth      = 5000   # maximum depth (m)
+bathymetry       = "GEBCO2026"   # "GEBCO2026" (15″, with IBCAO), "ETOPO" (ETOPO 2022, 60″) or "GLORYS" (GLORYS's own sea floor)
