From d615f959c96a987eaeee5b9d449811ae7b30ee40 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 21:47:11 -0500
Subject: [PATCH] [grid] bottom = "full" option; 10-day 15 km tests of the
 bottom (whole cells; 50 levels)

The 61-day 2005 run has 3-5.6 m/s jets at 2000-3500 m in bottom partial cells
next to 650-1000 m steps on ridge flanks. runs/tsubouchi-2005-15km-fullcell-10d
(GridFittedBottom) and runs/tsubouchi-2005-15km-nz50-10d (50 levels) each change
one thing over the 10 days in which the jets first appear.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvmJrXadb5LQWtyUVrz
---
 .../tsubouchi-2005-15km-fullcell-10d.toml     | 41 +++++++++++++++++++
 nested/runs/tsubouchi-2005-15km-nz50-10d.toml | 39 ++++++++++++++++++
 nested/setup.jl                               |  9 +++-
 3 files changed, 87 insertions(+), 2 deletions(-)
 create mode 100644 nested/runs/tsubouchi-2005-15km-fullcell-10d.toml
 create mode 100644 nested/runs/tsubouchi-2005-15km-nz50-10d.toml

diff --git a/nested/runs/tsubouchi-2005-15km-fullcell-10d.toml b/nested/runs/tsubouchi-2005-15km-fullcell-10d.toml
new file mode 100644
index 0000000..cd5e21a
--- /dev/null
+++ b/nested/runs/tsubouchi-2005-15km-fullcell-10d.toml
@@ -0,0 +1,41 @@
+# Run settings: as tsubouchi-2005-15km-2mo for 10 days, with whole bottom cells (no partial cells). Do the deep
+# 3–5.6 m/s jets on ridge flanks (bottom partial cells next to 650–1000 m steps, days 5–9) go away? Compare with the
+# first 10 days of output-tsubouchi-2005-15km-2mo.
+#
+# Settings for nested/panarctic_nested.jl: the pan-Arctic ocean (and optionally sea ice and JRA55) nested in GLORYS
+# with NumericalEarth's nested_ocean_model.
+#
+# Run from the nested/ folder:  julia +1.13 --project=. panarctic_nested.jl [config file]
+
+architecture = "GPU"   # "GPU" or "CPU"
+
+[grid]
+spacing_km = 15          # 100 (≈1°) for quick tests; 15 for the production grid
+Nz         = 20
+depth      = 5000        # m
+bathymetry = "ETOPO"
+bottom     = "full"      # "partial" (default) or "full": whole cells, a test of the partial-cell bottom
+# "ETOPO" (NumericalEarth's default) or "GEBCO2026" (as panarctic.jl; regridding needs ~55 GB of memory, cached)
+
+[time]
+start_date = 2005-09-01  # the run starts at 00:00 on this date, from GLORYS
+days       = 10
+dt_minutes = 10          # 20 at 100 km; 10 at 15 km
+
+[boundaries]
+zero_net_inflow = false     # true: the Flather exterior transport has no net inflow through the Atlantic and Pacific edges together
+net_inflow_control = false  # true (needs zero_net_inflow): prototype of a volume control from outside the substeps (net_inflow_control.jl); superseded by net_inflow_Sv
+# net_inflow_Sv = 0.0       # pin the total barotropic inflow through both edges together (Sv, positive into the domain), as NEMO and ROMS do; Flather splits it between the edges
+follow_glorys_volume = true  # true: set that total inflow every step so that the domain-mean η follows GLORYS's (overrides net_inflow_Sv; glorys_volume_target.jl)
+volume_relaxation_days = 1    # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency = false # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+net_inflow_depth_exponent = 0.5 # the pin shifts each edge column's transport ∝ H^0.5
+# edge_inflow_Sv = { atlantic = -0.8, pacific = 0.8 }   # pin the barotropic inflow through each edge (Sv, positive into the domain), as NEMO and ROMS do
+
+[coupling]
+coupled  = true         # true: add sea ice (nested in GLORYS) and the JRA55 atmosphere, radiation and rivers
+pressure = false         # with coupled = true: false sets the JRA55 sea-level pressure to 101325 Pa everywhere (GLORYS's η has no inverse barometer)
+
+[paths]
+data_dir   = ""          # where downloads are stored; "" = each dataset's default cache
+output_dir = "output-tsubouchi-2005-15km-fullcell-10d"
diff --git a/nested/runs/tsubouchi-2005-15km-nz50-10d.toml b/nested/runs/tsubouchi-2005-15km-nz50-10d.toml
new file mode 100644
index 0000000..62f5f95
--- /dev/null
+++ b/nested/runs/tsubouchi-2005-15km-nz50-10d.toml
@@ -0,0 +1,39 @@
+# Run settings: as tsubouchi-2005-15km-2mo for 10 days, with 50 levels (GLORYS has 50). Thinner deep cells make
+# the partial-cell steps on ridge flanks smaller. Compare with the first 10 days of output-tsubouchi-2005-15km-2mo.
+# The ETOPO bathymetry is regridded again for 50 levels the first time (cached after).
+#
+# Settings for nested/panarctic_nested.jl: the pan-Arctic ocean (and optionally sea ice and JRA55) nested in GLORYS
+# with NumericalEarth's nested_ocean_model.
+#
+# Run from the nested/ folder:  julia +1.13 --project=. panarctic_nested.jl [config file]
+
+architecture = "GPU"   # "GPU" or "CPU"
+
+[grid]
+spacing_km = 15          # 100 (≈1°) for quick tests; 15 for the production grid
+Nz         = 50
+depth      = 5000        # m
+bathymetry = "ETOPO"     # "ETOPO" (NumericalEarth's default) or "GEBCO2026" (as panarctic.jl; regridding needs ~55 GB of memory, cached)
+
+[time]
+start_date = 2005-09-01  # the run starts at 00:00 on this date, from GLORYS
+days       = 10
+dt_minutes = 10          # 20 at 100 km; 10 at 15 km
+
+[boundaries]
+zero_net_inflow = false     # true: the Flather exterior transport has no net inflow through the Atlantic and Pacific edges together
+net_inflow_control = false  # true (needs zero_net_inflow): prototype of a volume control from outside the substeps (net_inflow_control.jl); superseded by net_inflow_Sv
+# net_inflow_Sv = 0.0       # pin the total barotropic inflow through both edges together (Sv, positive into the domain), as NEMO and ROMS do; Flather splits it between the edges
+follow_glorys_volume = true  # true: set that total inflow every step so that the domain-mean η follows GLORYS's (overrides net_inflow_Sv; glorys_volume_target.jl)
+volume_relaxation_days = 1    # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency = false # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+net_inflow_depth_exponent = 0.5 # the pin shifts each edge column's transport ∝ H^0.5
+# edge_inflow_Sv = { atlantic = -0.8, pacific = 0.8 }   # pin the barotropic inflow through each edge (Sv, positive into the domain), as NEMO and ROMS do
+
+[coupling]
+coupled  = true         # true: add sea ice (nested in GLORYS) and the JRA55 atmosphere, radiation and rivers
+pressure = false         # with coupled = true: false sets the JRA55 sea-level pressure to 101325 Pa everywhere (GLORYS's η has no inverse barometer)
+
+[paths]
+data_dir   = ""          # where downloads are stored; "" = each dataset's default cache
+output_dir = "output-tsubouchi-2005-15km-nz50-10d"
diff --git a/nested/setup.jl b/nested/setup.jl
index 3cb3089..1f5120f 100644
--- a/nested/setup.jl
+++ b/nested/setup.jl
@@ -50,8 +50,13 @@ else
     regrid_bathymetry(cpu_grid; bathymetry_kw...)
 end
 
-grid = ImmersedBoundaryGrid(underlying_grid, PartialCellBottom(Array(interior(bottom_height, :, :, 1)));
-                            active_cells_map = true)
+# [grid] bottom = "partial" (default: partial cells) or "full" (whole cells; a test of the partial-cell bottom)
+bottom_kind = get(config["grid"], "bottom", "partial")
+bottom_kind in ("partial", "full") || error("[grid] bottom must be \"partial\" or \"full\", not \"$bottom_kind\"")
+Bottom = bottom_kind == "full" ? GridFittedBottom : PartialCellBottom
+grid = ImmersedBoundaryGrid(underlying_grid, Bottom(Array(interior(bottom_height, :, :, 1))); active_cells_map = true)
+@info "Bottom: $Bottom"
+
 
 # GLORYS daily means from start_date to one day past the end of the run
 start_date = DateTime(config["time"]["start_date"])
