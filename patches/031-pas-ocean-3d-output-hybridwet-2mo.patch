From 097312db77b23471b9f5b28594db1706d4622b81 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 19:38:05 -0500
Subject: [PATCH] Daily 3-D T, S, u, v output ([output] ocean_3d_days); 2-month
 partial-cell run with the wet-cell fix

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvncDb1PnxFVHRBrPRS
---
 nested/panarctic_nested.jl                    | 14 +++++-
 ...ouchi-2005-15km-partial-hybridwet-2mo.toml | 45 +++++++++++++++++++
 2 files changed, 58 insertions(+), 1 deletion(-)
 create mode 100644 nested/runs/tsubouchi-2005-15km-partial-hybridwet-2mo.toml

diff --git a/nested/panarctic_nested.jl b/nested/panarctic_nested.jl
index e923ff6..b3c5611 100644
--- a/nested/panarctic_nested.jl
+++ b/nested/panarctic_nested.jl
@@ -12,7 +12,8 @@
 #   julia +1.13 --project=. panarctic_nested.jl [config file]   # default config.toml
 #
 # Hourly diagnostics go to the log and to <output_dir>/nested_monitor.csv; surface fields every 3 hours and η every
-# hour to <output_dir>/nested_surface.jld2 and nested_free_surface.jld2; with sea ice, daily h and ℵ to nested_ice.jld2.
+# hour to <output_dir>/nested_surface.jld2 and nested_free_surface.jld2; with sea ice, daily h and ℵ to nested_ice.jld2;
+# with [output] ocean_3d_days, averages of the 3-D T, S, u, v to nested_ocean_3d.jld2.
 
 include("setup.jl")
 include("jra55_read_fix.jl")   # JRA55 reads for runs that do not start on 1 January
@@ -95,6 +96,17 @@ simulation.output_writers[:free_surface] = JLD2Writer(child, (; η = child.free_
                                                       filename = joinpath(output_dir, "nested_free_surface"),
                                                       overwrite_files = true)
 
+# [output] ocean_3d_days: averages of the 3-D T, S, u, v over that many days in nested_ocean_3d.jld2 (absent or 0: none).
+# About 130 MB per average at 15 km and 20 levels.
+ocean_3d_days = get(get(config, "output", Dict()), "ocean_3d_days", 0)
+if ocean_3d_days > 0
+    ocean_3d = (; T = child.tracers.T, S = child.tracers.S, u = child.velocities.u, v = child.velocities.v)
+    simulation.output_writers[:ocean_3d] = JLD2Writer(child, ocean_3d;
+                                                      schedule = AveragedTimeInterval(ocean_3d_days * Oceananigans.Units.day),
+                                                      filename = joinpath(output_dir, "nested_ocean_3d"),
+                                                      overwrite_files = true)
+end
+
 if coupled
     # Daily sea-ice thickness and concentration (2-D), to see where thick ice builds up (e.g. in the Archipelago channels)
     ice_fields = (; h = sea_ice.model.ice_thickness, ℵ = sea_ice.model.ice_concentration)
diff --git a/nested/runs/tsubouchi-2005-15km-partial-hybridwet-2mo.toml b/nested/runs/tsubouchi-2005-15km-partial-hybridwet-2mo.toml
new file mode 100644
index 0000000..331cf43
--- /dev/null
+++ b/nested/runs/tsubouchi-2005-15km-partial-hybridwet-2mo.toml
@@ -0,0 +1,45 @@
+# Production settings from 15 November 2026: September–October 2005, 15 km, 20 levels, partial bottom cells with the
+# mass-consistent bottom advection fix (Oceananigans PR #6533; here as a run-time override), volume following GLORYS,
+# pressure off, sea ice. Daily averages of the 3-D T, S, u, v (about 8 GB for 61 days) for the gateway sections
+# (heat and freshwater through the BSO and Fram) and the Atlantic Water layer.
+#
+# Load the fix in the REPL first, wet cells only (the version in PR #6533):
+#
+#   include("../../panarctic-tools/sandbox/lake_at_rest/thickness_jump_fixes.jl")   # path from nested/
+#   set_momentum_fix!("hybrid"); set_jump_walls!(false)
+#   empty!(ARGS); push!(ARGS, "runs/tsubouchi-2005-15km-partial-hybridwet-2mo.toml"); include("panarctic_nested.jl")
+#
+# Run from the nested/ folder:  julia +1.13 --project=. panarctic_nested.jl [config file]
+
+architecture = "GPU"   # "GPU" or "CPU"
+
+[grid]
+spacing_km = 15
+Nz         = 20
+depth      = 5000        # m
+bathymetry = "ETOPO"
+bottom     = "partial"
+
+[time]
+start_date = 2005-09-01
+days       = 61
+dt_minutes = 10
+
+[boundaries]
+zero_net_inflow = false
+net_inflow_control = false
+follow_glorys_volume = true
+volume_relaxation_days = 1
+follow_glorys_tendency = false
+net_inflow_depth_exponent = 0.5
+
+[coupling]
+coupled  = true
+pressure = false
+
+[output]
+ocean_3d_days = 1        # daily averages of the 3-D T, S, u, v
+
+[paths]
+data_dir   = ""
+output_dir = "output-tsubouchi-2005-15km-partial-hybridwet-2mo"
-- 
