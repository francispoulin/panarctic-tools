+#####
+##### The domain's volume budget, from monitor.csv
+#####
+
+function volume_budget_summary(output_dir)
+    lines  = readlines(joinpath(output_dir, "monitor.csv"))
+    header = split(lines[1], ',')
+    rows   = filter(r -> all(!isnothing, r) && length(r) == length(header),
+                    [tryparse.(Float64, split(line, ',')) for line in lines[2:end] if !isempty(strip(line))])
+    length(rows) < 2 && return "fewer than two rows in monitor.csv"
+    column(name) = [row[findfirst(==(name), header)] for row in rows]
+    η, ηᴳ = column("eta_mean_cm"), column("parent_eta_mean_cm")
+    drift = (η .- η[1]) .- (ηᴳ .- ηᴳ[1])
+    residual = column("budget_residual_cm")
+    # The first row holds the interpolated initial velocities (as in plotting/volume_budget.jl)
+    mismatch = abs.(column("net_in_Sv")[2:end] .- column("edge_inflow_from_volume_Sv")[2:end])
+    io = IOBuffer()
+    println(io, "| Quantity | Value |")
+    println(io, "|---|---|")
+    println(io, @sprintf("| Domain-mean η change, model / GLORYS, end of run (cm) | %+.1f / %+.1f |", η[end] - η[1], ηᴳ[end] - ηᴳ[1]))
+    println(io, @sprintf("| Largest \\|model − GLORYS\\| in the change of domain-mean η (cm) | %.1f |", maximum(abs, drift)))
+    println(io, @sprintf("| Through the open sides / across the surface, end of run (cm) | %+.1f / %+.1f |",
+                         column("edge_volume_cm")[end], column("surface_volume_cm")[end]))
+    println(io, @sprintf("| Largest \\|budget residual\\| (cm; should be 0) | %.2f |", maximum(abs, residual)))
+    println(io, @sprintf("| Largest \\|net inflow, velocities − from the volume\\| (Sv; should be 0) | %.2f |", maximum(abs, mismatch)))
+    return String(take!(io))
+end
+
