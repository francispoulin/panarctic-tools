+# Why the Greenland Sea ice moves too fast (patch 133). The ice is fast in the marginal ice zone, where its internal
+# stress hardly matters (the EVP test of patch 128 shows the velocity converged), so it moves with what drives it: the
+# wind and the ocean, through the ice–ocean drag. This separates the two by comparing, model against GLORYS:
+#
+#   - the ice speed |uᵢ|;
+#   - the speed of the ocean's top level under the ice |uₒ| (is the East Greenland Current itself too fast?);
+#   - the ice–ocean slip |uᵢ − uₒ| (does the ice move too fast relative to the water, e.g. a too strong air–ice stress?);
+#   - the top-level ocean speed over all ocean cells of the region, ice or not.
+#
+# Each on its own grid: the model's from its daily averages (arctic_ocean.jld2: u, v of the top cell; arctic_sea_ice.jld2:
+# ℵ, uᵢ, vᵢ), GLORYS's from its daily means (uo, vo at the top level, siconc, usi, vsi) over a box around the region,
+# read directly on its 1/12° grid. Speeds and the slip do not depend on the grid's axes, so nothing is rotated or
+# regridded. Means are area-weighted, over ice cells (concentration > 15 %) of the Greenland Sea region (as in
+# sea_ice_comparison.jl: 65–82°N, 40°W–15°E).
+#
+# Caveats: the model's top cell is ~4 m thick at nz100 (~8 m at nz50), GLORYS's top level is at 0.5 m, so the model's
+# top-level velocity is a deeper average (less wind-driven) and its slip is expected to be somewhat larger for the same
+# ice; GLORYS's ice velocity is itself a model (LIM2, forced by ERA-Interim), not an observation.
+#
+#   julia --project=. analysis/greenland_ice_drift.jl config_sep2005_4mo_nemo_glorys12_nz100_ne094.toml [every_days]
+#
+# every_days (default 3): the days compared. Downloads, once, GLORYS's daily uo, vo (3-D, over the box only), siconc,
+# usi, vsi for those days. Writes greenland_ice_drift.md to output_dir and greenland_ice_drift.png to figure_dir. CPU.
+
+include("../config.jl")
+
+using NumericalEarth, Oceananigans, Dates, JLD2, Printf, Statistics, CairoMakie
+using Oceananigans.Operators: Azᶜᶜᶜ
+using Oceananigans.OutputReaders: OnDisk
+using CopernicusMarine   # enables the GLORYS download extension
+using NumericalEarth.DataWrangling: BoundingBox, Metadatum, NCDatasets, Downloads, default_download_directory
+using NumericalEarth.DataWrangling.GLORYS: GLORYSDaily, GLORYS_dataset_variable_names
+using .NCDatasets: Dataset, dimnames
+
+every_days = length(ARGS) ≥ 2 ? parse(Int, ARGS[2]) : 3
+start_date = DateTime(config["time"]["start_date"])
+glorys_dir = isempty(data_dir) ? default_download_directory(GLORYSDaily()) : data_dir
+
+in_region(λ, φ) = 65 ≤ φ ≤ 82 && -40 ≤ λ < 15
+glorys_box = BoundingBox(longitude = (-41, 16), latitude = (64, 83))
+
+#####
+##### Model grid, region and cell areas
+#####
+
+grid = FieldTimeSeries(ocean_output_file, "η"; backend = OnDisk()).grid
+Nx, Ny, Nz = size(grid)
+ug = grid.underlying_grid
+bottom_height = grid.immersed_boundary.bottom_height
+model_ocean = [-Float64(bottom_height[i, j, 1]) > 0 for i in 1:Nx, j in 1:Ny]
+λ = mod.(Array(λnodes(ug, Center(), Center(), Center())) .+ 180, 360) .- 180
+φ = Array(φnodes(ug, Center(), Center(), Center()))
+model_region = [model_ocean[i, j] && in_region(λ[i, j], φ[i, j]) for i in 1:Nx, j in 1:Ny]
+model_area = [Azᶜᶜᶜ(i, j, 1, ug) for i in 1:Nx, j in 1:Ny]
+
+# Interior of a saved 2-D array, with or without halos (centre and face fields; u, v at the west and south faces)
+function interior_part(a)
+    hx, hy = (size(a, 1) - Nx) ÷ 2, (size(a, 2) - Ny) ÷ 2
+    return Float64.(a[hx+1:hx+Nx, hy+1:hy+Ny])
+end
+
+# The top cell of a saved 3-D array
+top_level(a) = interior_part(a[:, :, (size(a, 3) - Nz) ÷ 2 + Nz])
+surface_part(a) = interior_part(ndims(a) == 3 ? a[:, :, 1] : a)
+
+#####
+##### Statistics of one day on either grid
+#####
+
+clean(x) = ifelse(isfinite(x), x, 0.0)
+weighted_mean(x, w) = isempty(x) ? NaN : sum(x .* w) / sum(w)
+upper(x) = isempty(x) ? NaN : quantile(x, 0.95)
+
+# uᵢ, vᵢ: ice velocity; uₒ, vₒ: top-level ocean velocity; ℵ: concentration; region, wet: masks; area: cell areas
+function drift_statistics(uᵢ, vᵢ, uₒ, vₒ, ℵ, region, wet, area)
+    ice = region .& wet .& (clean.(ℵ) .> 0.15)
+    ice_speed   = sqrt.(clean.(uᵢ) .^ 2 .+ clean.(vᵢ) .^ 2)
+    ocean_speed = sqrt.(clean.(uₒ) .^ 2 .+ clean.(vₒ) .^ 2)
+    slip        = sqrt.((clean.(uᵢ) .- clean.(uₒ)) .^ 2 .+ (clean.(vᵢ) .- clean.(vₒ)) .^ 2)
+    open_ocean  = region .& wet
+    return (; ice_cells = count(ice),
+              ice = weighted_mean(ice_speed[ice], area[ice]),
+              ice_p95 = upper(ice_speed[ice]),
+              ocean_under_ice = weighted_mean(ocean_speed[ice], area[ice]),
+              slip = weighted_mean(slip[ice], area[ice]),
+              slip_p95 = upper(slip[ice]),
+              ocean_all = weighted_mean(ocean_speed[open_ocean], area[open_ocean]),
+              slips = slip[ice])
+end
+
+#####
+##### The model's daily averages
+#####
+
+sea_ice_file = joinpath(output_dir, "arctic_sea_ice.jld2")
+iterations = jldopen(sea_ice_file) do f
+    sort(filter(!=("serialized"), keys(f["timeseries/t"])), by = s -> parse(Int, s))
+end
+iterations = filter(n -> parse(Int, n) > 0, iterations)   # the averages, not the initial state
+selected = iterations[1:every_days:end]
+
+model_results = []
+sample_dates = Date[]
+jldopen(sea_ice_file) do ice_file
+    jldopen(ocean_output_file) do ocean_file
+        for n in selected
+            haskey(ocean_file["timeseries/u"], n) || continue
+            end_day = ice_file["timeseries/t/$n"] / 86400
+            date = Date(start_date + Millisecond(round(Int, (end_day - 1) * 86400e3)))   # the averaged day
+            uᵢ = surface_part(ice_file["timeseries/uᵢ/$n"])
+            vᵢ = surface_part(ice_file["timeseries/vᵢ/$n"])
+            ℵ  = surface_part(ice_file["timeseries/ℵ/$n"])
+            uₒ = top_level(ocean_file["timeseries/u/$n"])
+            vₒ = top_level(ocean_file["timeseries/v/$n"])
+            push!(model_results, drift_statistics(uᵢ, vᵢ, uₒ, vₒ, ℵ, model_region, model_ocean, model_area))
+            push!(sample_dates, date)
+            @info "Model: $date"
+        end
+    end
+end
+
+#####
+##### GLORYS's daily means over the box, on its own grid
+#####
+
+# One GLORYS variable of one day over the box: (; lon, lat, data), the top level for a 3-D variable, NaN on land
+function read_glorys_surface(name, date)
+    metadata = Metadatum(name; dataset = GLORYSDaily(), date = DateTime(date), region = glorys_box, dir = glorys_dir)
+    path = Downloads.download(metadata)
+    ds = Dataset(path)
+    var = ds[GLORYS_dataset_variable_names[name]]
+    lon, lat = Float64.(ds["longitude"][:]), Float64.(ds["latitude"][:])
+    data = "depth" in dimnames(var) ? Float64.(coalesce.(var[:, :, 1, 1], NaN)) :
+           Float64.(coalesce.(ndims(var) == 3 ? var[:, :, 1] : var[:, :], NaN))
+    close(ds)
+    return (; lon, lat, data)
+end
+
+glorys_results = []
+for date in sample_dates
+    uo  = read_glorys_surface(:u_velocity, date)
+    vo  = read_glorys_surface(:v_velocity, date).data
+    usi = read_glorys_surface(:sea_ice_u_velocity, date).data
+    vsi = read_glorys_surface(:sea_ice_v_velocity, date).data
+    ci  = read_glorys_surface(:sea_ice_concentration, date).data
+    lon, lat = uo.lon, uo.lat
+    region = [in_region(lon[i], lat[j]) for i in eachindex(lon), j in eachindex(lat)]
+    wet    = isfinite.(uo.data)
+    area   = [cosd(lat[j]) for i in eachindex(lon), j in eachindex(lat)]   # relative cell areas of a regular grid
+    push!(glorys_results, drift_statistics(usi, vsi, uo.data, vo, ci, region, wet, area))
+    @info "GLORYS: $date"
+end
+
+#####
+##### Table
+#####
+
+format_speed(x) = isfinite(x) ? @sprintf("%.3f", x) : "—"
+
+io = IOBuffer()
+println(io, "# $experiment: Greenland Sea ice drift, model / GLORYS\n")
+println(io, "Region 65–82°N, 40°W–15°E; ice cells: concentration > 15 %. Speeds in m/s, area-weighted means (p95 unweighted). ",
+            "Ocean: the top level (model ~4 m cell at nz100, GLORYS 0.5 m). Slip: |uᵢ − uₒ| against that level.\n")
+
+halves = (("first half", 1:length(sample_dates) ÷ 2), ("second half", length(sample_dates) ÷ 2 + 1:length(sample_dates)))
+period_mean(results, key, range) = (finite = filter(isfinite, [getproperty(r, key) for r in results[range]]);
+                                    isempty(finite) ? NaN : mean(finite))
+
+println(io, "## Means over the run's halves\n")
+println(io, "| Period | ice speed | ice p95 | ocean under ice | slip | slip p95 | ocean, all cells |")
+println(io, "|---|---|---|---|---|---|---|")
+for (period_name, range) in halves
+    isempty(range) && continue
+    cells = [join((format_speed(period_mean(model_results, key, range)), format_speed(period_mean(glorys_results, key, range))), " / ")
+             for key in (:ice, :ice_p95, :ocean_under_ice, :slip, :slip_p95, :ocean_all)]
+    println(io, "| $period_name ($(sample_dates[first(range)]) – $(sample_dates[last(range)])) | ", join(cells, " | "), " |")
+end
+
+println(io, "\n## Each day compared\n")
+println(io, "| Day | ice cells | ice speed | ocean under ice | slip | ocean, all cells |")
+println(io, "|---|---|---|---|---|---|")
+for (k, date) in enumerate(sample_dates)
+    model_row, glorys_row = model_results[k], glorys_results[k]
+    cells = [join((format_speed(getproperty(model_row, key)), format_speed(getproperty(glorys_row, key))), " / ")
+             for key in (:ice, :ocean_under_ice, :slip, :ocean_all)]
+    println(io, "| $date | $(model_row.ice_cells) / $(glorys_row.ice_cells) | ", join(cells, " | "), " |")
+end
+
+table_text = String(take!(io))
+print(table_text)
+table_file = joinpath(output_dir, "greenland_ice_drift.md")
+write(table_file, table_text)
+@info "Wrote $table_file"
+
+#####
+##### Figure: the three speeds through the run, and the distribution of the slip
+#####
+
+sample_days = [Dates.value(date - Date(start_date)) for date in sample_dates]
+fig = Figure(size = (1200, 800))
+for (k, (key, title)) in enumerate(((:ice, "ice speed"), (:ocean_under_ice, "top-level ocean speed under the ice"),
+                                    (:slip, "ice–ocean slip |uᵢ − uₒ|")))
+    ax = Axis(fig[(k - 1) ÷ 2 + 1, (k - 1) % 2 + 1]; title, xlabel = "day of the run", ylabel = "m/s")
+    lines!(ax, sample_days, [getproperty(r, key) for r in model_results]; label = "model", color = :royalblue)
+    lines!(ax, sample_days, [getproperty(r, key) for r in glorys_results]; label = "GLORYS", color = :black)
+    k == 1 && axislegend(ax; position = :lt)
+end
+ax = Axis(fig[2, 2]; title = "slip over ice cells, all days compared", xlabel = "m/s", ylabel = "share of cells")
+model_slips  = reduce(vcat, [r.slips for r in model_results])
+glorys_slips = reduce(vcat, [r.slips for r in glorys_results])
+bins = range(0, 0.6; length = 31)
+isempty(model_slips)  || hist!(ax, clamp.(model_slips, 0, 0.6); bins, normalization = :probability, color = (:royalblue, 0.5), label = "model")
+isempty(glorys_slips) || hist!(ax, clamp.(glorys_slips, 0, 0.6); bins, normalization = :probability, color = (:black, 0.4), label = "GLORYS")
+axislegend(ax; position = :rt)
+Label(fig[0, :], "$experiment: Greenland Sea ice drift"; fontsize = 18)
+
+figure_file = joinpath(figure_dir, "greenland_ice_drift.png")
+save(figure_file, fig)
+@info "Wrote $figure_file"
-- 
