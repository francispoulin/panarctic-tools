 # Reads the model's online transports (arctic_transports.jld2) and, if present, GLORYS's (glorys_transports.jld2) from
 # `output_dir`. Writes two tables, printed and saved as tsubouchi_comparison.md in `output_dir` (markdown, ready to
@@ -75,15 +80,34 @@ blocks = [(label = block_labels[b], a = block_first[b], b = block_first[b] + blo
 # The model's averages, at the middle of their windows, in days since the start (the first output, the initial state,
 # is left out); and the reference values and ρ cₚ the transports were computed with
 window = config["output"]["average_hours"] / 24
-(model_t, model), reference = jldopen(transport_output_file) do f
-    iterations = sort(filter(!=("serialized"), keys(f["timeseries/t"])), by = s -> parse(Int, s))[2:end]
-    t = [f["timeseries/t/$i"] for i in iterations] ./ 86400 .- window / 2
-    values = Dict(key => [only(f["timeseries/$key/$i"]) for i in iterations] for key in keys(f["timeseries"]) if key != "t")
-    reference = (T₀ = f["metadata/reference_temperature"], S₀ = f["metadata/reference_salinity"],
-                 ρcₚ = f["metadata/reference_density"] * f["metadata/heat_capacity"])
-    return (t, values), reference
+use_offline = length(ARGS) ≥ 2 && ARGS[2] == "offline"
+suffix = use_offline ? "_offline" : ""
+
+function read_online(file)
+    jldopen(file) do f
+        iterations = sort(filter(!=("serialized"), keys(f["timeseries/t"])), by = s -> parse(Int, s))[2:end]
+        t = [f["timeseries/t/$i"] for i in iterations] ./ 86400 .- window / 2
+        values = Dict(key => [only(f["timeseries/$key/$i"]) for i in iterations] for key in keys(f["timeseries"]) if key != "t")
+        reference = (T₀ = f["metadata/reference_temperature"], S₀ = f["metadata/reference_salinity"],
+                     ρcₚ = f["metadata/reference_density"] * f["metadata/heat_capacity"])
+        return (t, values), reference
+    end
+end
+
+# analysis/transports.jl: "times" (first = the initial state) and "transports/<name>", same metadata
+function read_offline(file)
+    jldopen(file) do f
+        n = length(f["times"])
+        t = f["times"][2:n] ./ 86400 .- window / 2
+        values = Dict(key => f["transports/$key"][2:n] for key in keys(f["transports"]))
+        reference = (T₀ = f["metadata/reference_temperature"], S₀ = f["metadata/reference_salinity"],
+                     ρcₚ = f["metadata/reference_density"] * f["metadata/heat_capacity"])
+        return (t, values), reference
+    end
 end
 
+(model_t, model), reference = use_offline ? read_offline(offline_transport_output_file) : read_online(transport_output_file)
+
 # GLORYS's daily means at noon of their day. glorys_transports.jl uses the config's reference values and the same ρ cₚ.
 glorys_file = joinpath(output_dir, "glorys_transports.jld2")
 if isfile(glorys_file)
@@ -191,7 +215,7 @@ end
 
