diff --git a/vertical_divergence_fix.jl b/vertical_divergence_fix.jl
new file mode 100644
index 0000000..43825fb
--- /dev/null
+++ b/vertical_divergence_fix.jl
@@ -0,0 +1,69 @@
+# The divergence term of WENOVectorInvariant's vertical advection with the area difference interpolated symmetrically:
+# Oceananigans.jl PR #6538 (Simone Silvestri), as a run-time override on the Oceananigans that NumericalEarth uses
+# (0.117; the PR is on 0.118). It replaces #6533's flux form at bottom-cell thickness jumps (partial_cell_fix.jl).
+#
+# WENOVectorInvariant writes the vertical advection of momentum as V⁻¹[δz(W u) + u D], with D the transport divergence
+# δx(Ax u) + δy(Ay v), upwind-biased across the velocity face. Where the face areas jump (a thin partial bottom cell
+# next to a thick one) D is mostly the area difference, and taking it from the upwind cell lets a bottom jet grow
+# (#6532). The PR splits each difference exactly, δx(Ax u) = ℑx(Ax) δx(u) + ℑx(u) δx(Ax): the velocity difference
+# stays upwinded, the area difference (and the z⋆ term) is interpolated symmetrically, as δz(W u) interpolates the
+# transport. Where the areas do not change, nothing changes. Code copied from the PR (commit 807ef5c), for both the
+# self- and the cross-upwinding forms.
+#
+# [grid] partial_cell_fix = "6538" includes this file in panarctic.jl, before the model is built. Remove it once the
+# Oceananigans that NumericalEarth uses contains PR #6538.
+
+@eval Oceananigans.Advection begin
+    # Velocity difference (upwinded) and area difference (symmetric) of each transport difference
+    @inline δᴿᵁ(i, j, k, grid, u, v) = ℑxᶜᵃᵃ(i, j, k, grid, Axᶠᶜᶜ) * δxᶜᵃᵃ(i, j, k, grid, u)
+    @inline δᴿⱽ(i, j, k, grid, u, v) = ℑyᵃᶜᵃ(i, j, k, grid, Ayᶜᶠᶜ) * δyᵃᶜᵃ(i, j, k, grid, v)
+
+    @inline δˢᵁ(i, j, k, grid, u, v) = δyᶜᶜᶜ(i, j, k, grid, Ay_qᶜᶠᶜ, v) +
+                                       ℑxᶜᵃᵃ(i, j, k, grid, u) * δxᶜᵃᵃ(i, j, k, grid, Axᶠᶜᶜ) + Az_Δr_∂t_σ(i, j, k, grid)
+    @inline δˢⱽ(i, j, k, grid, u, v) = δxᶜᶜᶜ(i, j, k, grid, Ax_qᶠᶜᶜ, u) +
+                                       ℑyᵃᶜᵃ(i, j, k, grid, v) * δyᵃᶜᵃ(i, j, k, grid, Ayᶜᶠᶜ) + Az_Δr_∂t_σ(i, j, k, grid)
+
+    @inline δᴿᵁⱽ(i, j, k, grid, u, v) = δᴿᵁ(i, j, k, grid, u, v) + δᴿⱽ(i, j, k, grid, u, v)
+    @inline δˢᵁⱽ(i, j, k, grid, u, v) = ℑxᶜᵃᵃ(i, j, k, grid, u) * δxᶜᵃᵃ(i, j, k, grid, Axᶠᶜᶜ) +
+                                        ℑyᵃᶜᵃ(i, j, k, grid, v) * δyᵃᶜᵃ(i, j, k, grid, Ayᶜᶠᶜ) + Az_Δr_∂t_σ(i, j, k, grid)
+
+    # Self upwinding (vector_invariant_self_upwinding.jl)
+    @inline function upwinded_divergence_flux_Uᶠᶜᶜ(i, j, k, grid, scheme::VectorInvariantSelfVerticalUpwinding, u, v)
+        δU_stencil   = scheme.upwinding.δU_stencil
+        cross_scheme = scheme.upwinding.cross_scheme
+        @inbounds û = u[i, j, k]
+        δˢ = _symmetric_interpolate_xᶠᵃᵃ(i, j, k, grid, scheme, cross_scheme, δˢᵁ, u, v)
+        δᴿ =    _biased_interpolate_xᶠᵃᵃ(i, j, k, grid, scheme, scheme.divergence_scheme, bias(û), δᴿᵁ, δU_stencil, u, v)
+        return û * (δˢ + δᴿ)
+    end
+
+    @inline function upwinded_divergence_flux_Vᶜᶠᶜ(i, j, k, grid, scheme::VectorInvariantSelfVerticalUpwinding, u, v)
+        δV_stencil   = scheme.upwinding.δV_stencil
+        cross_scheme = scheme.upwinding.cross_scheme
+        @inbounds v̂ = v[i, j, k]
+        δˢ = _symmetric_interpolate_yᵃᶠᵃ(i, j, k, grid, scheme, cross_scheme, δˢⱽ, u, v)
+        δᴿ =    _biased_interpolate_yᵃᶠᵃ(i, j, k, grid, scheme, scheme.divergence_scheme, bias(v̂), δᴿⱽ, δV_stencil, u, v)
+        return v̂ * (δˢ + δᴿ)
+    end
+
+    # Cross upwinding (vector_invariant_cross_upwinding.jl)
+    @inline function upwinded_divergence_flux_Uᶠᶜᶜ(i, j, k, grid, scheme::VectorInvariantCrossVerticalUpwinding, u, v)
+        @inbounds û = u[i, j, k]
+        δ_stencil = scheme.upwinding.divergence_stencil
+        cross_scheme = scheme.upwinding.cross_scheme
+        δᴿ =    _biased_interpolate_xᶠᵃᵃ(i, j, k, grid, scheme, scheme.divergence_scheme, bias(û), δᴿᵁⱽ, δ_stencil, u, v)
+        δˢ = _symmetric_interpolate_xᶠᵃᵃ(i, j, k, grid, scheme, cross_scheme, δˢᵁⱽ, u, v)
+        return û * (δᴿ + δˢ)
+    end
+
+    @inline function upwinded_divergence_flux_Vᶜᶠᶜ(i, j, k, grid, scheme::VectorInvariantCrossVerticalUpwinding, u, v)
+        @inbounds v̂ = v[i, j, k]
+        δ_stencil = scheme.upwinding.divergence_stencil
+        cross_scheme = scheme.upwinding.cross_scheme
+        δᴿ =    _biased_interpolate_yᵃᶠᵃ(i, j, k, grid, scheme, scheme.divergence_scheme, bias(v̂), δᴿᵁⱽ, δ_stencil, u, v)
+        δˢ = _symmetric_interpolate_yᵃᶠᵃ(i, j, k, grid, scheme, cross_scheme, δˢᵁⱽ, u, v)
+        return v̂ * (δᴿ + δˢ)
+    end
+end
+
+@info "Partial-cell fix: vertical-advection divergence with the area difference interpolated symmetrically (Oceananigans.jl#6538)"
-- 
