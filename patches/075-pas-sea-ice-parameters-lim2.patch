From 88a04b89a458c00df4135d27533b21e5a281995d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 18:52:34 -0500
Subject: [PATCH] Sea-ice parameters as options, with a LIM2-like (GLORYS12)
 configuration
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

[sea_ice] ice_salinity, ice_ocean_drag_coefficient and ice_compressive_strength (P*) are passed to
nested_sea_ice_simulation; their defaults are today's (4, 5.5e-3, 27 500 N/m²). [sea_ice] albedo = "ccsm3" uses
NumericalEarth's state-dependent SeaIceAlbedo instead of the constant 0.7.

config_sep2005_30d_catke_ice_tanh_lim2.toml: the tanh under-ice run with ORCA-LIM's LIM2 values (6, 5e-3, 20 000) and
the state-dependent albedo, with the mixing output. GLORYS12's own values are not published.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AbhhvmYEBvTrBMFfuX35Ju
---
 config_sep2005_30d_catke_ice_tanh_lim2.toml | 92 +++++++++++++++++++++
 panarctic.jl                                | 29 ++++++-
 2 files changed, 118 insertions(+), 3 deletions(-)
 create mode 100644 config_sep2005_30d_catke_ice_tanh_lim2.toml

diff --git a/config_sep2005_30d_catke_ice_tanh_lim2.toml b/config_sep2005_30d_catke_ice_tanh_lim2.toml
new file mode 100644
index 0000000..8c1458b
--- /dev/null
+++ b/config_sep2005_30d_catke_ice_tanh_lim2.toml
@@ -0,0 +1,92 @@
+# September 2005 only (30 days) at 15 km, otherwise as config_sep2005_15km_nz50.toml: a test of what makes the
+# Arctic surface layer too salty (patch 065). Compare its September mean with the 61-day run's, and with GLORYS, using
+#   julia +1.13 --project=. analysis/salinity_drift.jl <this config>
+# config_sep2005_30d_catke_ice_tanh.toml with the sea-ice parameters of GLORYS12's LIM2 (ORCA-LIM values): ice salinity 6,
+# ice–ocean drag 5e-3, P* 20 000 N/m², and a state-dependent albedo ([sea_ice] below).
+
+architecture = "GPU"   # "GPU" or "CPU"
+experiment   = "sep2005_30d_catke_ice_tanh_lim2"  # name of the run: output and figures go to output_dir/<experiment> and figure_dir/<experiment>
+
+[grid]
+spacing_km = 15     # largest horizontal grid spacing [km] (at the pole; ~15% finer near the Atlantic edge)
+Nz         = 50     # vertical levels
+depth      = 5000   # maximum depth (m)
+bathymetry       = "GEBCO2026"   # "GEBCO2026" (15″, with IBCAO), "ETOPO" (ETOPO 2022, 60″) or "GLORYS" (GLORYS's own sea floor)
+bottom           = "partial"     # "partial": bottom cells cut at the sea floor; "full": whole cells
+partial_cell_fix = true          # with partial cells: flux-form momentum advection at bottom-cell thickness jumps
+                                 # (Oceananigans.jl#6533), which removes the bottom jets of issue #6532
+
+[time]
+start_date = 2005-09-01   # initial condition (GLORYS); the run starts at 00:00 on this date
+end_date   = 2005-10-01   # the run ends at 00:00 on this date; for short tests a date and time, e.g. 1993-01-01T03:00
+dt_minutes = 10           # time step
+
+[atmosphere]
+jra55 = "multi_year"   # "multi_year": JRA55 for the run's own dates; "repeat_year": the 1990–91 repeat year
+pressure = false           # true: JRA55's sea-level pressure acts on the ocean (nested_pressure_fix.jl). Off for now: with it,
+                           # Fram Strait drifts far from GLORYS (1–5 Jan 1993, 15 km: day 4 −12.4 Sv, GLORYS −2.1, −5.6
+                           # without pressure; the same at 100 km), which looks like an error in the pressure path, not
+                           # physics. Main has had no pressure on the ocean since #43.
+inverse_barometer = false  # with pressure = true: GLORYS's η carries no response to the pressure (issue #37), so add the
+                           # inverse-barometer sea level −(pᵃ − ⟨pᵃ⟩)/(ρ₀g) to GLORYS's η at the open sides (Flather) and
+                           # to the initial free surface; its domain mean is removed, so the volume is unchanged.
+                           # Keep false with pressure = false: then neither the model nor GLORYS feels the pressure
+
+[output]
+average_hours   = 24      # time-averaged output (3D ocean, free surface, sea ice), written to output_dir
+checkpoint_days = 30      # how often the full model state is saved for restarts
+restart         = false   # true: continue from the latest checkpoint in output_dir
+monitor_hours   = 1       # monitor.csv: transports through the open sides, mean η against GLORYS's, volume budget,
+                          # fastest point (plotting/volume_budget.jl, plotting/max_speed.jl); 0 = off
+mixing_depth    = 60      # daily CATKE κᶜ and e over the top this many metres in arctic_mixing.jld2; 0 = off
+
+[transports]
+# Volume, heat, salt and freshwater transports through the sections below and the open boundaries (see transports.jl).
+online                = true   # true: computed every time step and averaged over average_hours, written to arctic_transports.jld2
+reference_temperature = 0      # heat transport relative to this temperature (°C)
+reference_salinity    = 34.8   # freshwater transport relative to this salinity (g/kg)
+
+# Each section is a great-circle path through (longitude, latitude) waypoints. Positive transport flows to the right,
+# walking from the first waypoint to the last; these are ordered so that positive is into the Arctic. Both ends should
+# be on land, so the section spans the whole strait on any grid. Check with plotting/transport_sections.jl.
+[transports.sections]
+# Fram Strait follows the mooring array at 78°50′N; intermediate waypoints keep the great circles on that latitude.
+fram_strait         = { lon = [15.0, 10.0, 5.0, 0.0, -5.0, -10.0, -15.0, -20.0],
+                        lat = [78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333] }
+# Barents Sea Opening follows the mooring line from Norway (Fugløya) via Bjørnøya to Sørkapp, Svalbard.
+barents_sea_opening = { lon = [20.0, 19.0, 16.5],  lat = [70.0, 74.45, 77.0] }
+bering_strait       = { lon = [-166.0, -171.0], lat = [66.0, 66.0] }
+davis_strait        = { lon = [-53.0, -63.0],   lat = [67.0, 66.5] }
+
+[paths]
+data_dir   = ""   # where downloads are stored; "" = each dataset's default cache
+output_dir = "output"    # model output: time averages (.jld2), checkpoints and the config; one folder per experiment
+figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
+
+[boundaries]
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
+tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
+relaxation_hours     = 6   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
+                           # over this timescale; 0 = off (nested_ocean_model's default is 6)
+
+# Volume control (volume_control.jl): the net inflow through the two open sides together is pinned at every barotropic
+# substep, as NEMO and ROMS do; Flather splits it between the sides. Without it the domain's volume drifts from GLORYS's.
+follow_glorys_volume      = true   # true: the net inflow follows GLORYS's domain-mean η, with the surface freshwater handed back
+volume_relaxation_days    = 1      # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency    = false  # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+# net_inflow_Sv           = 0.0    # with follow_glorys_volume = false: a constant net inflow instead (Sv, positive into the domain);
+                                   # with neither, Flather alone (no volume control)
+net_inflow_depth_exponent = 0.5    # the pin's correction to each boundary column ∝ Hᵖ: 0 uniform per length, 1 uniform velocity
+                                   # (NEMO, ROMS), 0.5 a uniform shift of GLORYS's η in Flather
+
+[ocean]
+closure = "CATKE"   # "CATKE" (default), "RiBased", "TKEDissipation" or "none"
+catke_under_ice = "tanh"   # CATKE's surface shear-driven TKE flux under ice: "none" (stock), "open_water" (× (1 − ℵ)), "tanh" (× (1 − tanh(10ℵ)))
+
+[sea_ice]
+ice_salinity               = 6        # g/kg (default 4)
+ice_ocean_drag_coefficient = 5e-3     # (default 5.5e-3)
+ice_compressive_strength   = 20000    # P*, N/m² (default 27 500)
+albedo                     = "ccsm3"  # "constant" (0.7, default) or "ccsm3" (state-dependent, SeaIceAlbedo)
diff --git a/panarctic.jl b/panarctic.jl
index a51af8f..0f3f0de 100644
--- a/panarctic.jl
+++ b/panarctic.jl
@@ -31,6 +31,9 @@ using Oceananigans.BoundaryConditions: ObliqueRadiation, TracerReservoir
 using Oceananigans.ImmersedBoundaries: immersed_inactive_node
 using Printf
 using ClimaSeaIce: IncrementalRemapping
+using ClimaSeaIce.Rheologies: ElastoViscoPlasticRheology
+using NumericalEarth.SeaIces: sea_ice_dynamics
+using NumericalEarth.Radiations: SeaIceAlbedo, SurfaceRadiationProperties
 using NumericalEarth.EarthSystemModels: reference_density, heat_capacity
 
 # ## Ocean, nested in GLORYS
@@ -111,8 +114,21 @@ child = ocean.model.child   # the regional ocean model; ocean.model also holds t
 # the thickness h = volume / area stays bounded where the concentration is small; it needs forward-Euler steps
 # (the NumericalEarth default) and an ice Courant number below one. WENO advected h and ℵ separately and inflated
 # h to hundreds of metres in nearly ice-free cells (#29).
+#
+# [sea_ice] ice_salinity, ice_ocean_drag_coefficient and ice_compressive_strength (P*): the defaults are NumericalEarth's
+# and ClimaSeaIce's (4, 5.5e-3, 27 500 N/m²); GLORYS12's LIM2 (ORCA-LIM) uses 6, 5e-3 and 20 000 (its own values are not
+# published). See panarctic-tools/docs/sea-ice-coupling-review.md.
+sea_ice_settings = get(config, "sea_ice", Dict{String, Any}())
+ice_salinity               = get(sea_ice_settings, "ice_salinity", 4)
+ice_ocean_drag_coefficient = get(sea_ice_settings, "ice_ocean_drag_coefficient", 5.5e-3)
+ice_compressive_strength   = get(sea_ice_settings, "ice_compressive_strength", 27500)
+dynamics = sea_ice_dynamics(child.grid, ocean; sea_ice_ocean_drag_coefficient = ice_ocean_drag_coefficient,
+                            rheology = ElastoViscoPlasticRheology(; ice_compressive_strength))
+@info "Sea ice: salinity $ice_salinity, ice–ocean drag $ice_ocean_drag_coefficient, P* $ice_compressive_strength N/m²"
+
 sea_ice = nested_sea_ice_simulation(ocean, dataset; dates = (start_date, end_date), dir_kw...,
-                                    advection = IncrementalRemapping(), timestepper = :ForwardEuler)
+                                    advection = IncrementalRemapping(), timestepper = :ForwardEuler,
+                                    ice_salinity, dynamics)
 
 # nested_sea_ice_simulation sets the GLORYS NaN (land, open water) to zero. Also make the concentration lie in
 # [0, 1], and thickness and concentration either both zero or both positive.
@@ -130,7 +146,6 @@ set!(sea_ice.model, h = h, ℵ = ℵ)
 # [sea_ice] ice_ocean_friction_velocity, the u★ of the ice–ocean heat exchange.
 catke_under_ice == "none" || copy_ice_concentration!(child, sea_ice)
 
-sea_ice_settings = get(config, "sea_ice", Dict{String, Any}())
 ice_ocean_friction_velocity = get(sea_ice_settings, "ice_ocean_friction_velocity", "constant")
 ice_ocean_friction_velocity in ("constant", "drag") ||
     error("[sea_ice] ice_ocean_friction_velocity must be \"constant\" or \"drag\", not \"$ice_ocean_friction_velocity\"")
@@ -168,7 +183,15 @@ else
 end
 
 atmosphere    = JRA55PrescribedAtmosphere(arch; jra55..., dir_kw...)
-radiation     = JRA55PrescribedRadiation(arch; jra55..., dir_kw...)
+# [sea_ice] albedo: "constant" (default, 0.7) or "ccsm3", NumericalEarth's SeaIceAlbedo (Briegleb et al. 2004): bare ice and
+# snow albedos lowered near melting, thin ice toward the ocean's, closer to LIM2's state-dependent albedo.
+albedo = get(sea_ice_settings, "albedo", "constant")
+albedo in ("constant", "ccsm3") || error("[sea_ice] albedo must be \"constant\" or \"ccsm3\", not \"$albedo\"")
+radiation_kw = albedo == "constant" ? (;) :
+    (; sea_ice_surface = SurfaceRadiationProperties(SeaIceAlbedo(sea_ice.model.ice_thickness, sea_ice.model.snow_thickness,
+                                                                 sea_ice.model.ice_thermodynamics.top_surface_temperature), 1.0))
+albedo == "constant" || @info "Sea-ice albedo: CCSM3 (SeaIceAlbedo)"
+radiation     = JRA55PrescribedRadiation(arch; jra55..., dir_kw..., radiation_kw...)
 land          = JRA55PrescribedLand(child.grid; jra55..., dir_kw...)
 
 interface_kw = ice_ocean_friction_velocity == "drag" ? (; sea_ice_ocean_heat_flux = drag_based_heat_flux(sea_ice, child)) : (;)
