+# The scorecard of a run (analysis/scorecard_functions.jl): every analysis that applies to it (salinity drift, sea ice,
+# mixing, fastest point, Tsubouchi), each in its own module and inside `try`, and their key rows in
+# output/<experiment>/scorecard.md. Works on old runs too. In a REPL, from the clone's top folder:
+#
+#     empty!(ARGS); push!(ARGS, "config_sep2005_30d_catke_ice_tanh_mixing.toml")
+#     include("analysis/scorecard.jl")
+#
+# The salinity drift regrids GLORYS on the GPU: use a REPL that holds no model (or clear it first, workflow.md).
+# A run with [output] post_run_analysis = true writes its scorecard by itself at the end.
+
+include("scorecard_functions.jl")
+
+scorecard(isempty(ARGS) ? joinpath(dirname(@__DIR__), "config.toml") : ARGS[1])
diff --git a/analysis/scorecard_functions.jl b/analysis/scorecard_functions.jl
new file mode 100644
index 0000000..f1092a0
--- /dev/null
+++ b/analysis/scorecard_functions.jl
@@ -0,0 +1,298 @@
+# The scorecard of a run: every analysis that applies to it, and the key rows of each in one file,
+# output/<experiment>/scorecard.md, so runs compare at a glance (plan of 20 Nov 2026, issue #48).
+#
+# Functions only; analysis/scorecard.jl runs it for a config (ARGS + include in a REPL), panarctic.jl at the end of a
+# run with [output] post_run_analysis = true, and a batch runner can call it directly:
+#
+#     include("analysis/scorecard_functions.jl")
+#     scorecard("config_sep2005_30d_catke_ice_tanh_mixing.toml")
+#
+# Each analysis script runs in a fresh anonymous module, with ARGS set to the config for its duration and restored
+# afterwards: its globals (grids, fields, names like `hours`) stay in that module and never reach Main or the next run.
+# Each runs inside `try`; a failure is recorded in the scorecard and the next analysis goes on. Packages and compiled
+# code are shared, so a second scorecard in the same REPL is quick.
+#
+# What runs (in this order), and when:
+#   salinity drift   analysis/salinity_drift.jl        arctic_ocean.jld2 present            (GLORYS monthly, GPU regridding)
+#   sea ice          analysis/sea_ice_comparison.jl    arctic_sea_ice.jld2 present          (GLORYS daily, every 3 days)
+#   mixing           analysis/mixing_timeseries.jl     arctic_mixing.jld2 present ([output] mixing_depth)
+#   fastest point    plotting/max_speed.jl             monitor.csv present ([output] monitor_hours)
+#   GLORYS transports analysis/glorys_transports.jl    for the Tsubouchi comparison, if glorys_transports.jld2 is missing
+#   Tsubouchi        analysis/tsubouchi_comparison.jl  arctic_transports.jld2 present and the run overlaps Tsubouchi
+#                                                      et al.'s year (5 Sep 2005 - 4 Sep 2006)
+# Their own tables (*.md) and figures are written as when they are run by hand. scorecard.md has: the run's settings,
+# a headline table by region at the end of the run (surface and top-200 m ΔS, ΔT, ΔFWC against GLORYS; ice area,
+# volume, 95th-percentile speed against GLORYS; κᶜ near 10 and 20 m), the end-of-run rows of each table, the fastest
+# point, the Tsubouchi blocks, and what ran, how long it took, and what failed.
+
+using CUDA, Dates, Printf, TOML
+
+#####
+##### Running one analysis script in a fresh module
+#####
+
+function run_in_fresh_module(script, args)
+    saved = copy(ARGS)
+    empty!(ARGS)
+    append!(ARGS, args)
+    try
+        sandbox = Module(Symbol("scorecard_", splitext(basename(script))[1]))
+        Base.include(sandbox, script)
+    finally
+        empty!(ARGS)
+        append!(ARGS, saved)
+    end
+    return nothing
+end
+
+#####
+##### Reading the analyses' markdown tables
+#####
+
+table_cells(line) = String.(strip.(split(strip(line), '|')[2:end-1]))
+
+# Every markdown table in a file, as (header, rows)
+function markdown_tables(file)
+    tables = Tuple{Vector{String}, Vector{Vector{String}}}[]
+    lines = readlines(file)
+    n = 1
+    while n < length(lines)
+        if startswith(lines[n], "|") && startswith(lines[n+1], "|---")
+            header = table_cells(lines[n])
+            rows = Vector{String}[]
+            n += 2
+            while n ≤ length(lines) && startswith(lines[n], "|")
+                push!(rows, table_cells(lines[n]))
+                n += 1
+            end
+            push!(tables, (header, rows))
+        else
+            n += 1
+        end
+    end
+    return tables
+end
+
+# The last row of each region (the tables list each region's rows in time order)
+function last_row_per_region(header, rows)
+    k = findfirst(==("Region"), header)
+    k === nothing && return rows
+    order = String[]
+    latest = Dict{String, Vector{String}}()
+    for row in rows
+        length(row) < k && continue
+        haskey(latest, row[k]) || push!(order, row[k])
+        latest[row[k]] = row
+    end
+    return [latest[name] for name in order]
+end
+
+function markdown_table(header, rows)
+    io = IOBuffer()
+    println(io, "| ", join(header, " | "), " |")
+    println(io, "|", repeat("---|", length(header)))
+    for row in rows
+        println(io, "| ", join(row, " | "), " |")
+    end
+    return String(take!(io))
+end
+
+drop_column(header, rows, name) = (k = findfirst(==(name), header);
+                                   k === nothing ? (header, rows) : (deleteat!(copy(header), k), [deleteat!(copy(r), k) for r in rows]))
+
+# Column whose header starts with `prefix`, or nothing
+column_index(header, prefix) = findfirst(h -> startswith(h, prefix), header)
+
+#####
+##### The fastest point, from monitor.csv
+#####
+
+function fastest_point_summary(output_dir)
+    lines  = readlines(joinpath(output_dir, "monitor.csv"))
+    header = split(lines[1], ',')
+    rows   = filter(r -> all(!isnothing, r) && length(r) == length(header),
+                    [tryparse.(Float64, split(line, ',')) for line in lines[2:end] if !isempty(strip(line))])
+    isempty(rows) && return "no rows in monitor.csv"
+    column(name) = [row[findfirst(==(name), header)] for row in rows]
+    speed = max.(column("max_u"), column("max_v"))
+    n = argmax(speed)
+    sorted = sort(speed)
+    return @sprintf("largest |u|, |v| %.2f m/s at day %.2f, (i, j, k) = (%d, %d, %d), %.1f°E %.1f°N, z = %.0f m; " *
+                    "median of the hourly maxima %.2f m/s, 95th percentile %.2f m/s",
+                    speed[n], column("hour")[n] / 24, round(Int, column("fastest_i")[n]), round(Int, column("fastest_j")[n]),
+                    round(Int, column("fastest_k")[n]), column("fastest_longitude")[n], column("fastest_latitude")[n],
+                    column("fastest_z")[n], sorted[cld(length(sorted), 2)], sorted[clamp(ceil(Int, 0.95 * length(sorted)), 1, length(sorted))])
+end
+
+#####
+##### The scorecard
+#####
+
+"""
+    scorecard(config_file; on_step = step -> nothing)
+
+Run every analysis that applies to the run of `config_file` and write `scorecard.md` in its output folder. `on_step`
+is called with the name of each analysis before it starts (panarctic.jl puts it in status.txt). Returns the path of
+scorecard.md.
+"""
+function scorecard(config_file::AbstractString; on_step = step -> nothing)
+    root        = dirname(@__DIR__)
+    config_file = abspath(config_file)
+    config      = TOML.parsefile(config_file)
+    experiment  = get(config, "experiment", "")
+    output_dir  = joinpath(config["paths"]["output_dir"], experiment)
+    isdir(output_dir) || error("No output folder $output_dir for $config_file")
+    start_date  = DateTime(config["time"]["start_date"])
+    end_date    = DateTime(config["time"]["end_date"])
+    has(file)   = isfile(joinpath(output_dir, file))
+
+    # Tsubouchi et al.'s twelve blocks: 5 Sep 2005 to 5 Sep 2006 (9 × 30 days, 35, 30, 30)
+    in_tsubouchi_year = start_date < DateTime(2006, 9, 5) && end_date > DateTime(2005, 9, 5)
+    tsubouchi_reason  = !has("arctic_transports.jld2") ? "no arctic_transports.jld2 ([transports] online = false)" :
+                        !in_tsubouchi_year ? "the run does not overlap 5 Sep 2005 - 4 Sep 2006" : nothing
+
+    # (name, script, why it is skipped or nothing, its table)
+    steps = [("salinity drift", "analysis/salinity_drift.jl",
+              has("arctic_ocean.jld2") ? nothing : "no arctic_ocean.jld2", "salinity_drift.md"),
+             ("sea ice", "analysis/sea_ice_comparison.jl",
+              has("arctic_sea_ice.jld2") && has("arctic_ocean.jld2") ? nothing : "no arctic_sea_ice.jld2 or arctic_ocean.jld2",
+              "sea_ice_comparison.md"),
+             ("mixing", "analysis/mixing_timeseries.jl",
+              has("arctic_mixing.jld2") ? nothing : "no arctic_mixing.jld2 ([output] mixing_depth = 0)", "mixing_timeseries.md"),
+             ("fastest point", "plotting/max_speed.jl",
+              has("monitor.csv") ? nothing : "no monitor.csv ([output] monitor_hours = 0)", nothing),
+             ("GLORYS transports", "analysis/glorys_transports.jl",
+              tsubouchi_reason !== nothing ? tsubouchi_reason : has("glorys_transports.jld2") ? "glorys_transports.jld2 already there" : nothing,
+              nothing),
+             ("Tsubouchi", "analysis/tsubouchi_comparison.jl", tsubouchi_reason, "tsubouchi_comparison.md")]
+
+    results = Dict{String, String}()   # name => "ok (… min)", "skipped: …" or "FAILED: …"
+    for (name, script, skip, table) in steps
+        if skip !== nothing
+            results[name] = "skipped: $skip"
+            continue
+        end
+        on_step(name)
+        @info "Scorecard of $experiment: $name ($script)"
+        table === nothing || rm(joinpath(output_dir, table); force = true)   # no stale table from an earlier scorecard
+        started = time()
+        try
+            run_in_fresh_module(joinpath(root, script), [config_file])
+            results[name] = @sprintf("ok (%.1f min)", (time() - started) / 60)
+        catch err
+            @error "Scorecard of $experiment: $name failed" exception = (err, catch_backtrace())
+            message = first(split(sprint(showerror, err), '\n'))
+            results[name] = "FAILED: " * first(message, 300)
+        end
+        GC.gc(true)
+        CUDA.functional() && CUDA.reclaim()
+    end
+
+    #####
+    ##### scorecard.md
+    #####
+
+    tables(file) = has(file) ? markdown_tables(joinpath(output_dir, file)) : Tuple{Vector{String}, Vector{Vector{String}}}[]
+    salinity = tables("salinity_drift.md")
+    ice      = tables("sea_ice_comparison.md")
+    mixing   = tables("mixing_timeseries.md")
+
+    io = IOBuffer()
+    println(io, "# Scorecard: $experiment\n")
+    println(io, "Config `$(basename(config_file))`, $(Date(start_date)) to $(Date(end_date)), written $(Dates.format(now(), "yyyy-mm-dd HH:MM")). ",
+                "Settings: " * join(["[$section] " * join(["$key = $(repr(value))" for (key, value) in sort(collect(config[section]); by = first)], ", ")
+                                     for section in ("ocean", "sea_ice") if haskey(config, section)], "; ") *
+                (haskey(config, "ocean") || haskey(config, "sea_ice") ? "; " : "") *
+                "[grid] " * join(["$key = $(repr(get(config["grid"], key, "-")))" for key in ("spacing_km", "Nz", "bottom", "partial_cell_fix")], ", ") *
+                ".\n")
+
+    # Headline: one row per region, end of the run
+    headline_header = ["Region"]
+    headline = Dict{String, Dict{String, String}}()
+    region_order = String[]
+    when = String[]
+    function gather!(found, columns, label, when_column)
+        isempty(found) && return
+        header, rows = found[1]
+        latest = last_row_per_region(header, rows)
+        r = findfirst(==("Region"), header)
+        r === nothing && return
+        w = findfirst(==(when_column), header)
+        w === nothing || isempty(latest) || push!(when, "$label: $(latest[1][w])")
+        for (prefix, title) in columns
+            k = column_index(header, prefix)
+            k === nothing && continue
+            title = title === nothing ? header[k] : title
+            title in headline_header || push!(headline_header, title)
+            for row in latest
+                row[r] in region_order || push!(region_order, row[r])
+                get!(headline, row[r], Dict{String, String}())[title] = row[k]
+            end
+        end
+    end
+    gather!(salinity, [("ΔS surface", "ΔS surface"), ("ΔS top 200", "ΔS top 200 m"), ("ΔT top 200", "ΔT top 200 m (°C)"),
+                       ("ΔFWC", "ΔFWC (km³)")], "salinity", "When")
+    gather!(ice, [("Area", "Ice area (10⁶ km²)"), ("Volume", "Ice volume (10³ km³)"),
+                  ("95 % speed", "Ice speed p95 (m/s)")], "sea ice", "When")
+    if !isempty(mixing)   # κᶜ at the level interfaces of the table nearest 10 and 20 m
+        κ_columns = filter(h -> match(r"^κᶜ at [0-9.]+ m$", h) !== nothing, unique(mixing[1][1]))
+        κ_depths  = [parse(Float64, match(r"at ([0-9.]+) m", h).captures[1]) for h in κ_columns]
+        chosen = isempty(κ_columns) ? String[] : unique([κ_columns[argmin(abs.(κ_depths .- d))] for d in (10, 20)])
+        gather!(mixing, [(h, h) for h in chosen], "mixing", "Days")
+    end
+    if length(headline_header) > 1
+        println(io, "## End of the run, by region\n")
+        println(io, "Model − GLORYS for salinity, temperature and freshwater content; model / GLORYS for the sea ice; κᶜ in m²/s. ",
+                    "Periods: ", join(when, "; "), ". Regions as in each analysis.\n")
+        rows = [[name; [get(get(headline, name, Dict{String, String}()), title, "-") for title in headline_header[2:end]]]
+                for name in region_order]
+        print(io, markdown_table(headline_header, rows))
+        println(io)
+    end
+
+    # The end-of-run rows of each analysis
+    for (title, found, file, drop) in (("Salinity and temperature drift", salinity, "salinity_drift.md", "Definition"),
+                                       ("Sea ice", ice, "sea_ice_comparison.md", nothing),
+                                       ("CATKE mixing", mixing, "mixing_timeseries.md", nothing))
+        isempty(found) && continue
+        header, rows = found[1]
+        rows = last_row_per_region(header, rows)
+        if drop !== nothing
+            header, rows = drop_column(header, rows, drop)
+        end
+        println(io, "## $title (end of the run; all rows in $file)\n")
+        print(io, markdown_table(header, rows))
+        println(io)
+    end
+
+    if has("monitor.csv")
+        summary = try
+            fastest_point_summary(output_dir)
+        catch err
+            "could not read monitor.csv: " * first(split(sprint(showerror, err), '\n'))
+        end
+        println(io, "## Fastest point (monitor.csv)\n\n$summary.\n")
+    end
+
+    if has("tsubouchi_comparison.md")   # their blocks, as written by tsubouchi_comparison.jl
+        text = read(joinpath(output_dir, "tsubouchi_comparison.md"), String)
+        start = findfirst("## Against Tsubouchi", text)
+        if start !== nothing
+            section = text[first(start):end]
+            body = section[something(findfirst('\n', section), lastindex(section)):end]   # without its heading
+            println(io, "## Gateways against Tsubouchi et al. (2018), their 30-day blocks (calendar months against GLORYS in tsubouchi_comparison.md)")
+            println(io, rstrip(body), "\n")
+        end
+    end
+
+    println(io, "## What ran\n")
+    print(io, markdown_table(["Analysis", "Result"], [[name, results[name]] for (name, _, _, _) in steps]))
+    println(io, "\nFigures in $(joinpath(config["paths"]["figure_dir"], experiment)).")
+
+    text = String(take!(io))
+    file = joinpath(output_dir, "scorecard.md")
+    write(file, text)
+    print(text)
+    @info "Wrote $file"
+    return file
+end
diff --git a/analysis/tsubouchi_comparison.jl b/analysis/tsubouchi_comparison.jl
index f118286..2b60def 100644
--- a/analysis/tsubouchi_comparison.jl
+++ b/analysis/tsubouchi_comparison.jl
@@ -15,9 +15,9 @@
 #
 # Heat and freshwater per gateway depend on the reference values (the net over a closed boundary does not), so they are
 # converted. With the volume Q, our heat H (relative to T₀) and our freshwater F (relative to S₀):
-#     heat relative to 1.01 °C       = H - ρ cₚ (1.01 - T₀) Q
-#     freshwater relative to 34.67   = Q - (S₀ / 34.67) (Q - F)          (since F = Q - Σ vS / S₀)
-# Tsubouchi et al.'s heat reference is the monthly boundary-mean temperature, 1.01 ± 0.16 °C; the constant 1.01 is used.
+#     heat relative to T′       = H - ρ cₚ (T′ - T₀) Q
