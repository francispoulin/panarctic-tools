diff --git a/run_management.jl b/run_management.jl
new file mode 100644
index 0000000..c746088
--- /dev/null
+++ b/run_management.jl
@@ -0,0 +1,268 @@
+# Run bookkeeping for panarctic.jl: one run per output folder, a status file per run, and clearing a reused REPL.
+#
+# - RUNNING, in the experiment's output folder, names the host, Julia process and config of the run writing there. A
+#   second run of the same experiment stops at once instead of overwriting the first one's files (19 Nov: two copies of
+#   one run corrupted its JLD2 output). The lock is taken (hard link, atomic) before anything is written to the folder,
+#   and removed when the run (and its scorecard) ends, fails or is interrupted. An existing lock is taken over only when
+#   its run is evidently gone:
+#     - it was taken by this same Julia process (an earlier include in this REPL, which has stopped);
+#     - its process no longer exists (same host only: the other server's processes cannot be checked from here);
+#     - its status.txt says finished, done, failed or interrupted;
+#     - its status.txt has not been updated for `stale_minutes` (60): a run on the other server that died with the
+#       server, or a REPL whose run stopped with an error while the model was being built.
+#   Otherwise the error says who holds it; delete RUNNING by hand only when sure that run is gone.
+# - status.txt: experiment, config, host, GPU, Julia process, start; then the state, the progress (model day, date,
+#   iteration, wall minutes per model day, expected end) and the time of the last update, rewritten every model hour.
+#   The last three lines are state, progress and update, so from either server
+#       tail -n 3 /mnt/autofs/bow.math/scratch/fpoulin/software/*/output/*/status.txt
+#   shows every run and how far it is.
+# - clear_globals! and free_gpu_memory!: the REPL-clearing recipe of workflow.md, run at the top of panarctic.jl (the
+#   previous run's model leaves the GPU) and after a run with [output] post_run_analysis (before the scorecard).
+#
+# No global variables here, and no names of units (workflow.md): only functions.
+
+using CUDA, Dates, Printf
+
+run_lock_file(output_dir)   = joinpath(output_dir, "RUNNING")
+run_status_file(output_dir) = joinpath(output_dir, "status.txt")
+this_host() = Libc.gethostname()
+timestamp(t) = Dates.format(t, "yyyy-mm-dd HH:MM:SS")
+
+#####
+##### Clearing a reused REPL
+#####
+
+"""
+    clear_globals!(mod = Main; keep = ())
+
+Set every non-constant global of `mod` to `nothing`, except the names in `keep`, so that the objects they held (a
+previous model and its GPU arrays) can be garbage collected. Functions, types, constants and loaded packages are kept,
+so compiled code stays and the next `include` is fast.
+"""
+function clear_globals!(mod::Module = Main; keep = ())
+    for name in names(mod; all = true)
+        (name in keep || startswith(string(name), "#")) && continue
+        (isdefined(mod, name) && !isconst(mod, name)) || continue
+        try
+            Core.eval(mod, :($name = nothing))
+        catch   # typed globals and the like: left as they are
+        end
+    end
+    return nothing
+end
+
+"""
+    free_gpu_memory!()
+
+Two full garbage collections (one was not enough on 19 Nov) and CUDA's memory pool given back to the driver.
+Check with `nvidia-smi` in a shell: a few hundred MB should remain.
+"""
+function free_gpu_memory!()
+    GC.gc(true)
+    GC.gc(true)
+    CUDA.functional() && CUDA.reclaim()
+    return nothing
+end
+
+#####
+##### The lock
+#####
+
+function device_description(config)
+    config["architecture"] == "GPU" || return "CPU"
+    try
+        device  = CUDA.device()
+        visible = get(ENV, "CUDA_VISIBLE_DEVICES", "")
+        return "GPU $(CUDA.deviceid(device)) ($(CUDA.name(device)))" *
+               (isempty(visible) ? "" : ", CUDA_VISIBLE_DEVICES=$visible")
+    catch
+        return "GPU (unknown)"
+    end
+end
+
+# The lock's lines "key = value" as a Dict, or nothing if there is no lock
+function lock_holder(output_dir)
+    file = run_lock_file(output_dir)
+    isfile(file) || return nothing
+    holder = Dict{String, String}()
+    for line in readlines(file)
+        parts = split(line, '='; limit = 2)
+        length(parts) == 2 && (holder[String(strip(parts[1]))] = String(strip(parts[2])))
+    end
+    return holder
+end
+
+# The first word of the "state:" line of status.txt ("" if none)
+function status_state(output_dir)
+    file = run_status_file(output_dir)
+    isfile(file) || return ""
+    for line in readlines(file)
+        if startswith(line, "state:")
+            words = split(line[length("state:")+1:end])
+            return isempty(words) ? "" : String(words[1])
+        end
+    end
+    return ""
+end
+
+minutes_since_modified(file) = isfile(file) ? (time() - mtime(file)) / 60 : Inf
+
+# Why the existing lock belongs to a run that is gone, or nothing if its run may still be going
+function stale_lock_reason(output_dir, holder; stale_minutes)
+    state = status_state(output_dir)
+    state in ("finished", "done", "failed", "interrupted") && return "its status.txt says $state"
+    host = get(holder, "host", "")
+    pid  = tryparse(Int, get(holder, "pid", ""))
+    if host == this_host() && pid !== nothing
+        pid == getpid() && return "it was taken by this Julia process (an earlier include in this REPL)"
+        isdir("/proc/$pid") || return "its process $pid no longer exists on $host"
+    end
+    status = run_status_file(output_dir)
+    age = minutes_since_modified(isfile(status) ? status : run_lock_file(output_dir))
+    age > stale_minutes && return @sprintf("its status was last updated %.0f min ago (more than %d)", age, stale_minutes)
+    return nothing
+end
+
+"""
+    acquire_run_lock(output_dir, config_file; stale_minutes = 60)
+
+Take the RUNNING lock of `output_dir` for this Julia process, or stop with an error naming the run that holds it.
+"""
+function acquire_run_lock(output_dir, config_file; stale_minutes = 60)
+    lock = run_lock_file(output_dir)
+    mine = joinpath(output_dir, ".RUNNING.$(this_host()).$(getpid())")
+    write(mine, "host = $(this_host())\npid = $(getpid())\nstarted = $(timestamp(now()))\nconfig = $(abspath(config_file))\n")
+    try
+        for attempt in 1:2
+            try
+                hardlink(mine, lock)   # fails if the lock exists: two runs cannot both take it
+                return lock
+            catch err
+                err isa Base.IOError || rethrow()
+                if !ispath(lock)   # a file system without hard links: copy instead (not atomic, but a race is unlikely)
+                    cp(mine, lock)
+                    return lock
+                end
+            end
+            holder = lock_holder(output_dir)
+            holder === nothing && continue   # removed in the meantime: try again
+            reason = stale_lock_reason(output_dir, holder; stale_minutes)
+            if reason === nothing
+                status = run_status_file(output_dir)
+                last_lines = isfile(status) ? join(last(readlines(status), 3), "\n    ") : "(no status.txt)"
+                error("Another run is writing to $output_dir:\n" *
+                      "    host $(get(holder, "host", "?")), Julia process $(get(holder, "pid", "?")), " *
+                      "started $(get(holder, "started", "?"))\n    config $(get(holder, "config", "?"))\n    $last_lines\n" *
+                      "This run stops here so as not to overwrite its files. Use a config with another experiment name, " *
+                      "or, if that run is certainly gone (e.g. its server rebooted), delete $lock and include again.")
+            end
+            @warn "Taking over the lock of $output_dir: $reason" holder
+            rm(lock; force = true)
+        end
+        error("Could not take the lock $lock")
+    finally
+        rm(mine; force = true)
+    end
+end
+
+"""
+    release_run_lock(output_dir)
+
+Remove the RUNNING lock if this Julia process holds it.
+"""
+function release_run_lock(output_dir)
+    holder = lock_holder(output_dir)
+    holder === nothing && return nothing
+    if get(holder, "host", "") == this_host() && get(holder, "pid", "") == string(getpid())
+        rm(run_lock_file(output_dir); force = true)
+    else
+        @warn "Not removing $(run_lock_file(output_dir)): another run holds it" holder
+    end
+    return nothing
+end
+
+#####
+##### status.txt
+#####
+
+function new_run_status(output_dir, experiment, config_file, config, start_date, end_date)
+    return (; file = run_status_file(output_dir), experiment, config_file = abspath(config_file), host = this_host(),
+            pid = getpid(), device = device_description(config), started = now(), start_date = DateTime(start_date),
+            run_days = Dates.value(DateTime(end_date) - DateTime(start_date)) / 86400e3,
+            rate_origin = Ref{Any}(nothing),   # (wall time, model day) of the first update with a model time
+            last_progress = Ref(""))
+end
+
+"""
+    write_run_status(status, state; model_time = nothing, iteration = nothing, detail = "", exception = nothing)
+
+Rewrite status.txt: `state` is "building", "running", "finished", "scorecard", "done", "failed" or "interrupted";
+`model_time` in seconds since the start date updates the progress line; `detail` goes after the state.
+"""
+function write_run_status(status, state; model_time = nothing, iteration = nothing, detail = "", exception = nothing)
+    if model_time !== nothing
+        model_day = model_time / 86400
+        if status.rate_origin[] === nothing
+            status.rate_origin[] = (wall = time(), model_day = model_day)
+        end
+        origin = status.rate_origin[]
+        date = status.start_date + Millisecond(round(Int, 1000 * model_time))
+        progress = @sprintf("day %.2f of %g (%s)", model_day, status.run_days, Dates.format(date, "yyyy-mm-dd HH:MM"))
+        iteration === nothing || (progress *= ", iteration $iteration")
+        if model_day > origin.model_day + 1e-3
+            rate = (time() - origin.wall) / 60 / (model_day - origin.model_day)   # wall minutes per model day
+            progress *= @sprintf(", %.1f min per model day", rate)
+            remaining = (status.run_days - model_day) * rate
+            remaining > 0 && (progress *= ", ends ~" * Dates.format(now() + Second(round(Int, 60 * remaining)), "yyyy-mm-dd HH:MM"))
+        end
+        status.last_progress[] = progress
+    end
+    state_line = "state: $state" * (isempty(detail) ? "" : " ($detail)")
+    if exception !== nothing
+        message = first(split(sprint(showerror, exception), '\n'))
+        state_line *= " - " * first(message, 300)   # the state stays the first word (status_state)
+    end
+    text = """
+    experiment: $(status.experiment)
+    config: $(status.config_file)
+    host: $(status.host), $(status.device), Julia process $(status.pid)
+    started: $(timestamp(status.started))
+    $state_line
+    progress: $(isempty(status.last_progress[]) ? "-" : status.last_progress[])
+    updated: $(timestamp(now()))
+    """
+    try   # written to a temporary file and renamed, so `tail` never sees half a file
+        temporary = status.file * ".tmp"
+        write(temporary, text)
+        mv(temporary, status.file; force = true)
+    catch err
+        @warn "Could not write $(status.file)" exception = err
+    end
+    return nothing
+end
+
+#####
+##### End of a run
+#####
+
+"""
+    finish_run(mod, status, config_file, output_dir; post_run_analysis = false)
+
+After `run!`: with `post_run_analysis`, clear the globals of `mod` (the model) and free the GPU memory, then write the
+scorecard (analysis/scorecard_functions.jl); then mark the run done and release the lock.
+"""
+function finish_run(mod, status, config_file, output_dir; post_run_analysis = false)
+    if post_run_analysis
+        clear_globals!(mod; keep = (:config, :config_file, :experiment, :output_dir, :figure_dir, :run_status))
+        free_gpu_memory!()
+        write_run_status(status, "scorecard"; detail = "model cleared from memory")
+        try
+            scorecard(config_file; on_step = step -> write_run_status(status, "scorecard"; detail = step))
+        catch err
+            @error "The scorecard stopped" exception = (err, catch_backtrace())
+        end
+    end
+    write_run_status(status, "done"; detail = post_run_analysis ? "scorecard.md in the output folder" : "")
+    release_run_lock(output_dir)
+    return nothing
+end
