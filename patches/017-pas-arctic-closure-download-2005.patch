     rows = (Float64[24 * (n - 1) + 12], Float64[24 * (n - 1) + 12])   # GLORYS daily means are centred at noon
     for b in boxes
@@ -268,11 +361,41 @@ for (n, date) in enumerate(run_dates)
         end
