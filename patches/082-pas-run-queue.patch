+++ b/tools/start_runners.sh
@@ -0,0 +1,22 @@
+#!/bin/bash
+# Start one queue runner per GPU on this server, each in its own tmux session runner-<host>-g<gpu>, logged to
+# ~/logs/runner-<host>-g<gpu>.log. Default: all four GPUs. Runners stop by themselves after the queue has been empty for
+# 15 min ($PANARCTIC_IDLE_MINUTES), and wait while someone else uses their GPU.
+#     bash tools/start_runners.sh            # GPUs 0 1 2 3
+#     bash tools/start_runners.sh 2 3        # only GPUs 2 and 3
+cd "$(dirname "$0")/.." || exit 1
+root=$(pwd)
+host=$(hostname -s)
+gpus=${*:-0 1 2 3}
+mkdir -p ~/logs
+for g in $gpus; do
+    s="runner-$host-g$g"
+    if tmux has-session -t "$s" 2>/dev/null; then
+        echo "$s is already running"
+        continue
+    fi
+    tmux new-session -d -s "$s"
+    tmux pipe-pane -o -t "$s" "cat >> ~/logs/$s.log"
+    tmux send-keys -t "$s" "ocean_setup && cd $root && bash tools/runner_loop.sh $g; exit" Enter
+    echo "started $s (log: ~/logs/$s.log)"
+done
diff --git a/tools/submit.sh b/tools/submit.sh
new file mode 100755
index 0000000..26f7172
--- /dev/null
+++ b/tools/submit.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+# Put configs in this clone's run queue (queue/queue/, or $PANARCTIC_QUEUE), oldest first; tools/start_runners.sh
+# starts runners that take them. A config is skipped if its experiment is already queued or running, or if its
+# output folder already has a run (arctic_ocean.jld2): --force reruns it and overwrites that output.
+#     bash tools/submit.sh config_X.toml [config_Y.toml ...]
+#     bash tools/submit.sh --force config_X.toml
+cd "$(dirname "$0")/.." || exit 1
+queue=${PANARCTIC_QUEUE:-$(pwd)/queue}
+mkdir -p "$queue"/queue "$queue"/running "$queue"/done "$queue"/failed
+force=0
+if [ "$1" = "--force" ]; then force=1; shift; fi
+setting() { sed -n "s/^$1 *= *\"\([^\"]*\)\".*/\1/p" "$2" | head -1; }
+n=0
+for c in "$@"; do
+    if [ ! -f "$c" ]; then echo "$c: no such file"; continue; fi
+    exp=$(setting experiment "$c")
+    if [ -z "$exp" ]; then echo "$c: no experiment name"; continue; fi
+    if grep -lqs "^experiment *= *\"$exp\"" "$queue"/queue/*.toml "$queue"/running/*.toml; then
+        echo "$c: experiment $exp is already queued or running; skipped"
+        continue
+    fi
+    out=$(setting output_dir "$c")
+    if [ $force -eq 0 ] && [ -e "${out:-output}/$exp/arctic_ocean.jld2" ]; then
+        echo "$c: ${out:-output}/$exp already has a run; skipped (--force to rerun it and overwrite)"
+        continue
+    fi
+    n=$((n + 1))
+    cp "$c" "$queue/queue/$(date +%Y%m%d-%H%M%S)-$(printf %02d $n)_$(basename "$c")" && echo "queued $(basename "$c") ($exp)"
+done
+echo "Waiting:"
+ls "$queue"/queue
