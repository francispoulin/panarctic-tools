+# substep, as NEMO and ROMS do; Flather splits it between the sides. Without it the domain's volume drifts from GLORYS's.
+follow_glorys_volume      = true   # true: the net inflow follows GLORYS's domain-mean η, with the surface freshwater handed back
+volume_relaxation_days    = 1      # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency    = false  # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+# net_inflow_Sv           = 0.0    # with follow_glorys_volume = false: a constant net inflow instead (Sv, positive into the domain);
+                                   # with neither, Flather alone (no volume control)
+net_inflow_depth_exponent = 0.5    # the pin's correction to each boundary column ∝ Hᵖ: 0 uniform per length, 1 uniform velocity
+                                   # (NEMO, ROMS), 0.5 a uniform shift of GLORYS's η in Flather
+
+[ocean]
+closure = "CATKE"   # "CATKE" (default), "RiBased", "TKEDissipation" or "none"
+catke_under_ice = "tanh"   # CATKE's surface shear-driven TKE flux under ice: "none" (stock), "open_water" (× (1 − ℵ)), "tanh" (× (1 − tanh(10ℵ)))
+
+[sea_ice]
+ice_salinity               = 6        # g/kg (default 4)
+ice_ocean_drag_coefficient = 5e-3     # (default 5.5e-3)
+ice_compressive_strength   = 20000    # P*, N/m² (default 27 500)
+albedo                     = "ccsm3"  # "constant" (0.7, default) or "ccsm3" (state-dependent, SeaIceAlbedo)
diff --git a/tools/qstat.sh b/tools/qstat.sh
new file mode 100755
index 0000000..a325036
--- /dev/null
+++ b/tools/qstat.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# The run queue of this clone: waiting jobs, running jobs with the last lines of their status.txt, the last finished
+# jobs (queue/summary.md), and the runner sessions on this server.
+#     bash tools/qstat.sh
+cd "$(dirname "$0")/.." || exit 1
+queue=${PANARCTIC_QUEUE:-$(pwd)/queue}
+experiment() { sed -n 's/^experiment *= *"\([^"]*\)".*/\1/p' "$1" | head -1; }
+echo "== Waiting"
+for f in "$queue"/queue/*.toml; do [ -e "$f" ] && echo "  $(basename "$f")  ($(experiment "$f"))"; done
+echo "== Running"
+for f in "$queue"/running/*.toml; do
+    [ -e "$f" ] || continue
+    e=$(experiment "$f")
+    echo "  $(basename "$f")  ($e)  $(grep -E '^(host|gpu)' "$f.claim" 2>/dev/null | tr '\n' ' ')"
+    tail -n 3 "output/$e/status.txt" 2>/dev/null | sed 's/^/      /'
+done
+echo "== Finished (last 10; all in $queue/summary.md)"
+grep '^| [0-9]' "$queue/summary.md" 2>/dev/null | tail -n 10
+echo "== Runners on $(hostname -s)"
+tmux ls 2>/dev/null | grep '^runner-' || echo "  none"
diff --git a/tools/runner.jl b/tools/runner.jl
new file mode 100644
index 0000000..79b38b6
--- /dev/null
+++ b/tools/runner.jl
@@ -0,0 +1,256 @@
+# A queue runner: one Julia process bound to one GPU that runs the queued configs one after another and writes each
+# run's scorecard, so runs can be submitted and found finished later (plan of 20 Nov 2026). Started, and restarted
+# when it exits, by tools/runner_loop.sh; tools/start_runners.sh starts one per GPU in tmux. Submit with
+# tools/submit.sh, watch with tools/qstat.sh.
+#
+#   julia --project=. tools/runner.jl <gpu>        (from the clone's top folder; <gpu> numbered as in nvidia-smi)
+#
+# The queue lives in the clone (queue/, or $PANARCTIC_QUEUE), on the RAID shared by pelee and rondeau, so one queue
+# feeds the runners of both servers, and every job runs the code of this clone:
+#   queue/queue/    configs waiting (oldest name first: tools/submit.sh prefixes the time of submission)
+#   queue/running/  configs being run, each with a .claim (host, GPU, Julia process, long, start)
+#   queue/done/     finished; queue/failed/ failed, with a .error; queue/summary.md one line per finished job
+#
+# Each job:
+#   - is claimed by renaming it from queue/ to running/ (atomic: two runners, on either server, never take the same
+#     job), but only when no other process is on this GPU (nvidia-smi) and, for a config with [queue] long = true, when
+#     fewer than $PANARCTIC_MAX_LONG (2) long jobs already run on this server;
+#   - runs panarctic.jl in a fresh anonymous module (no globals from the previous job; packages and compiled GPU
+#     kernels stay loaded, so the next job starts quickly). panarctic.jl's own lock and status.txt work as in a REPL;
+#   - is followed by its scorecard (unless the config's [output] post_run_analysis already wrote it), then the module's
+#     globals are cleared and the GPU memory freed.
+# A job whose method overrides differ from those loaded by an earlier job ([grid] partial_cell_fix, [ocean]
+# catke_under_ice on or off, [atmosphere] pressure: these redefine library methods for the whole process) makes the
+# runner exit with code 75 before claiming it; runner_loop.sh starts a fresh Julia, which takes it.
+# The runner exits (code 0) after the queue has had nothing for it for $PANARCTIC_IDLE_MINUTES (15) minutes, giving the
+# GPU back. A job left in running/ by a runner of this server that died (crash, reboot) is moved to failed/ when the
+# next runner of this server starts. Ctrl-C stops the job (status "interrupted", moved to failed/) and the runner.
+
+gpu = parse(Int, ARGS[1])
+Base.exit_on_sigint(false)   # Ctrl-C raises InterruptException, so the job is marked interrupted and the lock released
+
+using CUDA
+haskey(ENV, "CUDA_VISIBLE_DEVICES") && error("Start runners without CUDA_VISIBLE_DEVICES (tools/runner_loop.sh unsets it)")
+CUDA.device!(gpu)   # before anything else touches the GPU, so this process holds no context on the other GPUs
+
+using Dates, Printf, TOML
+
+const root = dirname(@__DIR__)
+cd(root)
+include(joinpath(root, "run_management.jl"))
+include(joinpath(root, "analysis", "scorecard_functions.jl"))
+
+const queue_root   = get(ENV, "PANARCTIC_QUEUE", joinpath(root, "queue"))
+const folders      = (; queue   = mkpath(joinpath(queue_root, "queue")),   running = mkpath(joinpath(queue_root, "running")),
+                        done    = mkpath(joinpath(queue_root, "done")),    failed  = mkpath(joinpath(queue_root, "failed")))
+const summary_file = joinpath(queue_root, "summary.md")
+const idle_minutes = parse(Float64, get(ENV, "PANARCTIC_IDLE_MINUTES", "15"))
+const max_long     = parse(Int, get(ENV, "PANARCTIC_MAX_LONG", "2"))
+const host         = Libc.gethostname()
+const exit_restart = 75
+
+say(message) = (@info "Runner $host GPU $gpu: $message"; flush(stderr))
+
+#####
+##### Files
+#####
+
+claim_file(job) = job * ".claim"
+
+function read_key_values(file)
+    values = Dict{String, String}()
+    isfile(file) || return values
+    for line in readlines(file)
+        parts = split(line, '='; limit = 2)
+        length(parts) == 2 && (values[String(strip(parts[1]))] = String(strip(parts[2])))
+    end
+    return values
+end
+
+experiment_of(config) = config === nothing ? "?" : get(config, "experiment", "?")
+read_config(path) = try TOML.parsefile(path) catch; nothing end
+
+function append_summary(line)
+    isfile(summary_file) ||
+        write(summary_file, "| Finished | Job | Experiment | Where | Result | Wall (h) |\n|---|---|---|---|---|---|\n")
+    open(io -> println(io, line), summary_file, "a")
+    return nothing
+end
+
+# Move a job out of running/ (or queue/, for an unreadable config) to done/ or failed/, and log it
+function finish_job(path, ok, message, seconds; claim_info = read_key_values(claim_file(path)))
+    config = read_config(path)
+    name = basename(path)
+    destination = ok ? folders.done : folders.failed
+    mv(path, joinpath(destination, name); force = true)
+    rm(claim_file(path); force = true)
+    ok || write(joinpath(destination, name * ".error"), message * "\n")
+    result = ok ? "done: output/$(experiment_of(config))/scorecard.md" : "FAILED: " * replace(first(message, 200), "|" => "/")
+    append_summary(@sprintf("| %s | %s | %s | %s GPU %s | %s | %.2f |", timestamp(now()), name, experiment_of(config),
+                            get(claim_info, "host", host), get(claim_info, "gpu", string(gpu)), result, seconds / 3600))
+    return nothing
+end
+
+# Jobs left in running/ by a runner of this server that no longer exists
+function recover_stale_claims()
+    for name in readdir(folders.running)
+        endswith(name, ".toml") || continue
+        path  = joinpath(folders.running, name)
+        claim_info = read_key_values(claim_file(path))
+        get(claim_info, "host", "") == host || continue
+        pid = tryparse(Int, get(claim_info, "pid", ""))
+        pid !== nothing && isdir("/proc/$pid") && continue
+        say("$name was left running by process $(something(pid, "?")), which is gone: moved to failed/")
+        finish_job(path, false, "its runner (process $(something(pid, "?")) on $host) died, from a crash or a reboot; " *
+                                "submit it again to rerun it", 0.0; claim_info)
+    end
+end
+
+long_jobs_here() = count(name -> endswith(name, ".claim") &&
+                                 (info = read_key_values(joinpath(folders.running, name));
+                                  get(info, "host", "") == host && get(info, "long", "false") == "true"),
+                         readdir(folders.running))
+
+#####
+##### The GPU and the method overrides
+#####
+
+# Processes other than this one on our GPU (empty if nvidia-smi cannot be asked)
+function other_processes_on_gpu()
+    try
+        uuid = ""
+        for line in readlines(`nvidia-smi --query-gpu=index,uuid --format=csv,noheader`)
+            index, id = strip.(split(line, ','))
+            parse(Int, index) == gpu && (uuid = id)
+        end
+        others = Int[]
+        for line in readlines(`nvidia-smi --query-compute-apps=pid,gpu_uuid --format=csv,noheader`)
+            fields = strip.(split(line, ','))
+            length(fields) == 2 || continue
+            pid = tryparse(Int, fields[1])
+            pid !== nothing && fields[2] == uuid && pid != getpid() && push!(others, pid)
+        end
+        return others
+    catch err
+        @warn "Could not ask nvidia-smi which processes use GPU $gpu" exception = err
+        return Int[]
+    end
+end
+
+# The settings that redefine library methods for the whole process
+function overrides(config)
+    fix = get(get(config, "grid", Dict{String, Any}()), "partial_cell_fix", false)
+    return (partial_cell_fix = fix === true ? "6533" : string(fix),   # true and "6533" load the same file
+            catke_under_ice  = get(get(config, "ocean", Dict{String, Any}()), "catke_under_ice", "none") != "none",
+            pressure         = get(get(config, "atmosphere", Dict{String, Any}()), "pressure", false) == true)
+end
+
+#####
+##### Taking and running a job
+#####
+
+# The first waiting job this runner may take, or nothing
+function next_job()
+    for name in sort(filter(name -> endswith(name, ".toml"), readdir(folders.queue)))
+        path = joinpath(folders.queue, name)
+        config = read_config(path)
+        if config === nothing
+            say("$name is not a readable TOML file: moved to failed/")
+            try finish_job(path, false, "not a readable TOML file", 0.0) catch end
+            continue
+        end
+        long = get(get(config, "queue", Dict{String, Any}()), "long", false) == true
+        long && long_jobs_here() ≥ max_long && continue
+        return (; name, path, config, long)
+    end
+    return nothing
+end
+
+# Rename the job into running/ (atomic: if another runner took it first, the rename fails and we return nothing)
+function claim(job)
+    target = joinpath(folders.running, job.name)
+    try
+        mv(job.path, target)
+    catch
+        return nothing
+    end
+    write(claim_file(target), "host = $host\ngpu = $gpu\npid = $(getpid())\nlong = $(job.long)\nstarted = $(timestamp(now()))\n")
+    return target
+end
+
+function run_in_fresh_module(path)
+    sandbox = Module(:panarctic_job)
+    Core.eval(sandbox, :(eval(x) = Core.eval($sandbox, x)))
+    Core.eval(sandbox, :(include(p::AbstractString) = Base.include($sandbox, p)))
+    Core.eval(sandbox, :(include(mapexpr::Function, p::AbstractString) = Base.include(mapexpr, $sandbox, p)))
+    empty!(ARGS)
+    push!(ARGS, path)
+    try
+        Base.include(sandbox, joinpath(root, "panarctic.jl"))
+    finally
+        clear_globals!(sandbox)
+        free_gpu_memory!()
+        empty!(ARGS)
+        push!(ARGS, string(gpu))
+    end
+    return nothing
+end
+
+function main()
+    recover_stale_claims()
+    say("started in $root; queue $queue_root")
+    loaded = nothing           # the overrides of the jobs run by this process
+    idle_since = time()
+    while true
+        job = next_job()
+        if job === nothing || !isempty(other_processes_on_gpu())
+            if (time() - idle_since) / 60 > idle_minutes
+                say("nothing to run here for $(idle_minutes) min: exiting")
+                exit(0)
+            end
+            job === nothing || say("GPU $gpu is used by process(es) $(join(other_processes_on_gpu(), ", ")): waiting")
+            sleep(job === nothing ? 30 : 60)
+            continue
+        end
+        needed = overrides(job.config)
+        if loaded !== nothing && needed != loaded
+            say("$(job.name) needs other method overrides ($needed; loaded $loaded): restarting Julia")
+            exit(exit_restart)
+        end
+        path = claim(job)
+        path === nothing && continue
+        loaded = needed
+        say("running $(job.name) (experiment $(experiment_of(job.config)))")
+        started = time()
+        ok, message, interrupted = true, "", false
+        try
+            run_in_fresh_module(path)
+        catch err
+            ok = false
+            interrupted = err isa InterruptException
+            message = interrupted ? "interrupted (Ctrl-C)" : first(split(sprint(showerror, err), '\n'))
+            @error "Job $(job.name) failed" exception = (err, catch_backtrace())
+        end
+        if ok && get(get(job.config, "output", Dict{String, Any}()), "post_run_analysis", false) != true
+            say("scorecard of $(job.name)")
+            try
+                scorecard(path)
+            catch err
+                @error "Scorecard of $(job.name) stopped" exception = (err, catch_backtrace())
+            end
+            free_gpu_memory!()
+        end
+        finish_job(path, ok, message, time() - started)
+        say("$(job.name): " * (ok ? "done" : "failed: $message"))
+        interrupted && exit(130)
+        idle_since = time()
+    end
+end
+
+try
+    main()
+catch err
+    err isa InterruptException || rethrow()
+    say("stopped (Ctrl-C)")
+    exit(130)   # runner_loop.sh stops on 130
+end
diff --git a/tools/runner_loop.sh b/tools/runner_loop.sh
new file mode 100755
index 0000000..b98a1b3
--- /dev/null
+++ b/tools/runner_loop.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# One GPU's queue runner (tools/runner.jl), started again whenever Julia exits, except when the queue has been empty
+# (exit 0) or after Ctrl-C (exit 130). Exit 75: the next job needs other method overrides, so a fresh Julia takes it.
+# Any other exit (a crash) restarts after 30 s; the crashed job goes to failed/ when the new runner starts.
+# Started by tools/start_runners.sh in a tmux session per GPU; can also be run by hand:
+#     bash tools/runner_loop.sh <gpu>
+gpu=$1
+[ -n "$gpu" ] || { echo "usage: bash tools/runner_loop.sh <gpu>"; exit 1; }
+cd "$(dirname "$0")/.." || exit 1
+unset CUDA_VISIBLE_DEVICES
+export CUDA_DEVICE_ORDER=PCI_BUS_ID   # CUDA numbers the GPUs as nvidia-smi does
+while true; do
+    julia --project=. tools/runner.jl "$gpu"
+    code=$?
+    case $code in
+        0)   echo "runner GPU $gpu: queue empty, stopping"; break ;;
+        130) echo "runner GPU $gpu: stopped (Ctrl-C)"; break ;;
+        75)  echo "runner GPU $gpu: restarting Julia for the next job's method overrides" ;;
+        *)   echo "runner GPU $gpu: Julia exited with code $code; restarting in 30 s (Ctrl-C to stop)"; sleep 30 || break ;;
+    esac
+done
