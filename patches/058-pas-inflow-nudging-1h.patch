From de3747cf8ff561fe5ab027d332fd2604b82d28b2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 22:23:55 -0500
Subject: [PATCH] Boundary velocities nudged toward GLORYS on inflow over 1
 hour, not 1 day
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With 1 day, the Atlantic open face (25, 1, 4) of the smoke test, a partial bottom cell, drifted to v = −0.9 m/s
against GLORYS's −0.26. Nudging over 1 hour removes it and changes the transports through Fram, the BSO, Bering
and Davis by less than 0.1 Sv (patch 056).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Abhhvkp8Pai9cvvctGUDX5
---
 config.toml                    | 4 +++-
 config_smoke_test.toml         | 4 +++-
 config_smoke_test_sep2005.toml | 4 +++-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/config.toml b/config.toml
index 511baf1..5b8ae3e 100644
--- a/config.toml
+++ b/config.toml
@@ -65,7 +65,9 @@ output_dir = "output"    # model output: time averages (.jld2), checkpoints and
 figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
 
 [boundaries]
-velocity_inflow_days = 1   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
 tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
 relaxation_hours     = 0   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
                            # over this timescale; 0 = off (nested_ocean_model's default is 6)
diff --git a/config_smoke_test.toml b/config_smoke_test.toml
index 5699a0f..ae46c94 100644
--- a/config_smoke_test.toml
+++ b/config_smoke_test.toml
@@ -67,7 +67,9 @@ output_dir = "output"    # model output: time averages (.jld2), checkpoints and
 figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
 
 [boundaries]
-velocity_inflow_days = 1   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
 tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
 relaxation_hours     = 0   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
                            # over this timescale; 0 = off (nested_ocean_model's default is 6)
diff --git a/config_smoke_test_sep2005.toml b/config_smoke_test_sep2005.toml
index 0ce61cc..455a686 100644
--- a/config_smoke_test_sep2005.toml
+++ b/config_smoke_test_sep2005.toml
@@ -66,7 +66,9 @@ output_dir = "output"    # model output: time averages (.jld2), checkpoints and
 figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
 
 [boundaries]
-velocity_inflow_days = 1   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
 tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
 relaxation_hours     = 0   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
                            # over this timescale; 0 = off (nested_ocean_model's default is 6)
