+# One CSV row: the hour, then volume (Sv), heat (TW) and freshwater (mSv) for each section, from fields on any architecture
+function gateway_row(sections, hour, u, v, T, S)
+    u, v, T, S = map(f -> on_architecture(CPU(), f), (u, v, T, S))
+    values = Float64[hour]
+    for s in sections
