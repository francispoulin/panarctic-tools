index 0000000..5709f01
--- /dev/null
+++ b/analysis/mixed_layer_depth.jl
@@ -0,0 +1,233 @@
+# Is the model's mixed layer deeper than GLORYS's, and when? Mixed-layer depth by region through the run, model against
+# GLORYS, both computed the same way from daily-mean T and S on the model grid (GLORYS regridded onto it, as in
+# salinity_drift.jl), so the comparison is not about vertical resolution (8 m top cell at 50 levels): the depth below
+# 10 m where the potential density (TEOS-10, at the surface) first exceeds its value at 10 m by Δσ = 0.03 kg/m³
+# (de Boyer Montégut et al. 2004), linearly interpolated between cell centres; a column that never reaches Δσ is mixed
+# to the bottom; columns shallower than 10 m are left out.
+#
+#   julia --project=. analysis/mixed_layer_depth.jl [config.toml] [every n days, default 5] [Δσ, default 0.03]
+#
+# Reads arctic_ocean.jld2 (daily T and S) from `output_dir`; downloads GLORYS's daily T and S every n days (north of
+# 43°N, ~0.5 GB per variable and day, once) and regrids them on the config's architecture. Writes mixed_layer_depth.md
+# (region means and medians, model / GLORYS, per third of the run, on the days GLORYS is read) to `output_dir`, and
+# mixed_layer_depth_timeseries.png (model daily, GLORYS every n days, by region) and mixed_layer_depth_maps.png (model,
+# GLORYS and model − GLORYS on the last day compared) to `figure_dir`.
+#
+# How to read it: a model mixed layer deeper than GLORYS's from the day the surface starts to cool (day ~9 in the Sep
+# 2005 runs) points to too much convective mixing at freeze-up (CATKE's convective surface flux, or too much surface heat
+# loss); one deeper all month, to shear (wind or ice stress).
+
+include("../config.jl")
+
+using NumericalEarth, Oceananigans, Oceananigans.Units
+using Oceananigans.Architectures: on_architecture
+using Oceananigans.Operators: Azᶜᶜᶜ
+using Oceananigans.OutputReaders: OnDisk
+using Oceananigans.BuoyancyFormulations: SeawaterPolynomials
+using NumericalEarth.DataWrangling: BoundingBox, Metadatum
+using CopernicusMarine   # enables the GLORYS download extension
+using CairoMakie, CUDA, Dates, Printf, Statistics
+
+arch       = config["architecture"] == "GPU" ? GPU() : CPU()
+start_date = DateTime(config["time"]["start_date"])
+end_date   = DateTime(config["time"]["end_date"])
+every      = length(ARGS) ≥ 2 ? parse(Int, ARGS[2]) : 5
+Δσ         = length(ARGS) ≥ 3 ? parse(Float64, ARGS[3]) : 0.03
+z_ref      = -10.0                                            # reference depth (m)
+window     = config["output"]["average_hours"] / 24           # days
+run_days   = Dates.value(end_date - start_date) / 86400e3
+eos        = SeawaterPolynomials.TEOS10.TEOS10EquationOfState()
+
+#####
+##### The model's output and its grid
+#####
+
+St = FieldTimeSeries(ocean_output_file, "S"; backend = OnDisk())
+Tt = FieldTimeSeries(ocean_output_file, "T"; backend = OnDisk())
+grid  = St.grid
+times = St.times ./ 86400              # days; each average is saved at the end of its window
+Nx, Ny, Nz = size(grid)
+
+ug  = grid.underlying_grid
+zf  = Float64.(collect(ug.z.cᵃᵃᶠ[1:Nz+1]))
+bottom_height = grid.immersed_boundary.bottom_height
+hb  = [Float64(bottom_height[i, j, 1]) for i in 1:Nx, j in 1:Ny]
+λ   = mod.(Array(λnodes(ug, Center(), Center(), Center())) .+ 180, 360) .- 180
+φ   = Array(φnodes(ug, Center(), Center(), Center()))
+A   = [Azᶜᶜᶜ(i, j, 1, ug) for i in 1:Nx, j in 1:Ny]
+H   = max.(-hb, 0)
+ocean = H .> 0
+
+# Middle of each cell's wet part (the partial bottom cell's too); NaN where the cell is dry
+zmid = [zf[k+1] > hb[i, j] ? (max(zf[k], hb[i, j]) + zf[k+1]) / 2 : NaN for i in 1:Nx, j in 1:Ny, k in 1:Nz]
+
+# Regions as in salinity_drift.jl
+regions = [("Beaufort Gyre",    (λ, φ, H) -> 70.5 ≤ φ ≤ 80.5 && -170 ≤ λ ≤ -130 && H > 300),
+           ("Central Arctic",   (λ, φ, H) -> φ > 82),
+           ("Siberian shelves", (λ, φ, H) -> 66 ≤ φ ≤ 82 && (λ ≥ 60 || λ ≤ -170) && H < 200),
+           ("Barents Sea",      (λ, φ, H) -> 68 ≤ φ ≤ 80 && 15 ≤ λ < 60),
+           ("Nordic Seas",      (λ, φ, H) -> 62 ≤ φ ≤ 79 && -20 ≤ λ < 15),
+           ("Archipelago",      (λ, φ, H) -> 68 ≤ φ ≤ 82 && -125 ≤ λ ≤ -80),
+           ("Baffin Bay",       (λ, φ, H) -> 67 ≤ φ ≤ 78 && -80 < λ ≤ -55)]
+masks = [[ocean[i, j] && test(λ[i, j], φ[i, j], H[i, j]) for i in 1:Nx, j in 1:Ny] for (_, test) in regions]
+
+#####
+##### Mixed-layer depth of a 3-D T, S (positive, m; NaN where undefined)
+#####
+
+function mixed_layer_depth(T, S, zmid, H, eos, Δσ, z_ref)
+    Nx, Ny, Nz = size(T)
+    mld = fill(NaN, Nx, Ny)
+    σ = zeros(Nz)
+    for j in 1:Ny, i in 1:Nx
+        (H[i, j] > -z_ref && isfinite(zmid[i, j, Nz])) || continue
+        for k in 1:Nz
+            σ[k] = isfinite(zmid[i, j, k]) ? SeawaterPolynomials.ρ′(T[i, j, k], S[i, j, k], 0.0, eos) : NaN
+        end
+        # σ at the reference depth, interpolated between the wet cell centres around it
+        σ_ref = NaN
+        if zmid[i, j, Nz] ≤ z_ref
+            σ_ref = σ[Nz]
+        else
+            for k in Nz-1:-1:1
+                z = zmid[i, j, k]
+                isfinite(z) || break
+                if z ≤ z_ref
+                    w = (z_ref - z) / (zmid[i, j, k+1] - z)
+                    σ_ref = (1 - w) * σ[k] + w * σ[k+1]
+                    break
+                end
+            end
+        end
+        isfinite(σ_ref) || continue
+        # Down from the reference depth to the first centre denser by more than Δσ
+        depth = H[i, j]   # mixed to the bottom unless the criterion is met
+        z_prev, σ_prev = z_ref, σ_ref
+        for k in Nz:-1:1
+            z = zmid[i, j, k]
+            isfinite(z) || break
+            z < z_ref || continue
+            if σ[k] - σ_ref > Δσ
+                w = (σ_ref + Δσ - σ_prev) / (σ[k] - σ_prev)
+                depth = -(z_prev + w * (z - z_prev))
+                break
+            end
+            z_prev, σ_prev = z, σ[k]
+        end
+        mld[i, j] = depth
+    end
+    return mld
+end
+
+function region_stats(mld, mask)
+    m = mask .& isfinite.(mld)
+    any(m) || return (mean = NaN, median = NaN)
+    return (mean = sum(mld[m] .* A[m]) / sum(A[m]), median = median(mld[m]))
+end
+
+#####
+##### Model: every daily average
+#####
+
+saved = findall(>(0), times)               # the initial state (t = 0) is not an average
+t_mid = times[saved] .- window / 2
+model_mld = Dict{Int, Matrix{Float64}}()   # by index n in the time series
+for n in saved
+    model_mld[n] = mixed_layer_depth(Float64.(interior(Tt[n])), Float64.(interior(St[n])), zmid, H, eos, Δσ, z_ref)
+end
+model_series = [[region_stats(model_mld[n], mask) for n in saved] for mask in masks]
+@info "Model: mixed-layer depth of $(length(saved)) daily averages"
+
+#####
+##### GLORYS every n days, on the model grid, paired with the model's average over the same day
+#####
+
+region = BoundingBox(longitude = (-180, 180), latitude = (43, 90))
+target = CenterField(on_architecture(arch, grid))
+function glorys_on_grid(name, date)
+    set!(target, Metadatum(name; dataset = GLORYSDaily(), date, region, dir_kw...))
+    return Float64.(Array(interior(target)))
+end
+
+paired_days = NamedTuple[]   # (day, model index, GLORYS mld)
+for d in 0:every:floor(Int, run_days - window)
+    n = findfirst(τ -> abs(τ - (d + window)) < 1e-3, times)   # the model's average over day d
+    n === nothing && continue
+    date = start_date + Day(d)
+    T = glorys_on_grid(:temperature, date)
+    S = glorys_on_grid(:salinity, date)
+    push!(paired_days, (day = d, n = n, glorys = mixed_layer_depth(T, S, zmid, H, eos, Δσ, z_ref)))
+    @info "GLORYS $(Dates.format(date, "yyyy-mm-dd")): mixed-layer depth on the model grid"
+end
+isempty(paired_days) && error("No model daily average matches a GLORYS day (average_hours = $(window * 24))")
+
+#####
+##### Table: region means and medians per third of the run, on the paired days
+#####
+
+thirds = [(0.0, run_days / 3), (run_days / 3, 2run_days / 3), (2run_days / 3, run_days + 1)]
+io = IOBuffer()
+println(io, "# Mixed-layer depth: $experiment ($(Date(start_date)) to $(Date(end_date)))\n")
+println(io, "Depth below 10 m where the potential density first exceeds its 10 m value by $(Δσ) kg/m³ (TEOS-10), model and ",
+            "GLORYS (daily means regridded onto the model grid), both on the model's levels. Means are area-weighted; ",
+            "medians over the region's columns. Model / GLORYS on the GLORYS days of each third of the run ",
+            "(every $every days from the start; day d is the daily mean of day d).\n")
+println(io, "| Region | Days | MLD mean, model / GLORYS (m) | MLD median, model / GLORYS (m) | Δ mean (m) |")
+println(io, "|---|---|---|---|---|")
+for (r, ((name, _), mask)) in enumerate(zip(regions, masks)), (a, b) in thirds
+    sel = [p for p in paired_days if a ≤ p.day < b]
+    isempty(sel) && continue
+    m = [region_stats(model_mld[p.n], mask) for p in sel]
+    g = [region_stats(p.glorys, mask) for p in sel]
+    mm, gm = mean(getfield.(m, :mean)), mean(getfield.(g, :mean))
+    md, gd = mean(getfield.(m, :median)), mean(getfield.(g, :median))
+    println(io, @sprintf("| %s | %s | %.0f / %.0f | %.0f / %.0f | %+.0f |", name,
+                         join(string.(getfield.(sel, :day)), ", "), mm, gm, md, gd, mm - gm))
+end
+println(io)
+text = String(take!(io))
+print(text)
+table_file = joinpath(output_dir, "mixed_layer_depth.md")
+write(table_file, text)
+@info "Wrote $table_file"
+
+#####
+##### Time series by region
+#####
+
+fig = Figure(size = (1400, 700))
+for (r, ((name, _), mask)) in enumerate(zip(regions, masks))
+    ax = Axis(fig[fldmod1(r, 4)...]; title = name, xlabel = "days since $(Date(start_date))", yreversed = true,
+              ylabel = mod1(r, 4) == 1 ? "mixed-layer depth (m)" : "")
+    lines!(ax, t_mid, getfield.(model_series[r], :mean); color = :red, label = "model, mean")
+    lines!(ax, t_mid, getfield.(model_series[r], :median); color = :red, linestyle = :dash, label = "model, median")
+    gd = [p.day + 0.5 for p in paired_days]
+    scatter!(ax, gd, [region_stats(p.glorys, mask).mean for p in paired_days]; color = :black, label = "GLORYS, mean")
+    scatter!(ax, gd, [region_stats(p.glorys, mask).median for p in paired_days]; color = :black, marker = :utriangle,
+             label = "GLORYS, median")
+    r == 1 && axislegend(ax; position = :lb, framevisible = false, labelsize = 10)
+end
+Label(fig[0, :], "$experiment: mixed-layer depth (Δσ = $Δσ kg/m³ from 10 m)"; fontsize = 18)
+file = joinpath(figure_dir, "mixed_layer_depth_timeseries.png")
+save(file, fig)
+@info "Wrote $file"
+
+#####
+##### Maps on the last day compared
+#####
+
+last_pair = paired_days[end]
+mm = ifelse.(ocean, model_mld[last_pair.n], NaN)
+gm = ifelse.(ocean, last_pair.glorys, NaN)
+fig = Figure(size = (1500, 520))
+for (col, (title, values, colormap, limits)) in enumerate((("model", mm, :deep, (0, 100)), ("GLORYS", gm, :deep, (0, 100)),
+                                                        ("model − GLORYS", mm .- gm, :balance, (-50, 50))))
+    ax = Axis(fig[1, 2col - 1]; title = "$title, day $(last_pair.day)", aspect = DataAspect(), xlabel = "i", ylabel = "j")
+    hm = heatmap!(ax, 1:Nx, 1:Ny, values; colormap, colorrange = limits, highclip = colormap == :deep ? :black : :darkred,
+                  lowclip = :navy, nan_color = :lightgray)
+    Colorbar(fig[1, 2col], hm; label = "m")
+end
+Label(fig[0, :], "$experiment: mixed-layer depth on $(Dates.format(start_date + Day(last_pair.day), "yyyy-mm-dd"))"; fontsize = 18)
+file = joinpath(figure_dir, "mixed_layer_depth_maps.png")
+save(file, fig)
+@info "Wrote $file"
