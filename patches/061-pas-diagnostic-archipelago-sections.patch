index 0000000..7b28c85
--- /dev/null
+++ b/analysis/section_comparison.jl
@@ -0,0 +1,153 @@
+# Transports through every section in [transports.sections], computed offline from the daily output
+# (arctic_transports_offline.jld2, from analysis/transports.jl), against GLORYS (glorys_transports.jld2, from
+# analysis/glorys_transports.jl): calendar-month means of volume, heat and freshwater, and daily series. For sections
+# that a run did not compute online (sections added after the run, such as the Archipelago channels in
+# config_sep2005_15km_nz50_caa.toml).
+#
+#   julia +1.13 --project=. analysis/transports.jl         [config.toml]    (once: offline transports)
+#   julia +1.13 --project=. analysis/glorys_transports.jl  [config.toml]    (once: GLORYS)
+#   julia +1.13 --project=. analysis/section_comparison.jl [config.toml]
+#
+# Writes section_comparison.md (tables, markdown) to `output_dir` and section_comparison.png to `figure_dir`.
+#
+# The offline transports use the daily-averaged u, v, T and S, so they miss the covariance of velocity and tracers
+# within a day. Where the online transports exist (arctic_transports.jld2), their monthly means are listed beside the
+# offline ones: the difference is the size of that error, for judging the sections that only have offline values.
+# Positive into the Arctic; heat relative to [transports] reference_temperature, freshwater to reference_salinity.
+
+include("../config.jl")
+include("../transports.jl")
+
+using CairoMakie, Dates, JLD2, Printf
+
+start_date = Date(config["time"]["start_date"])
+end_date   = Date(config["time"]["end_date"])
+run_days   = Dates.value(end_date - start_date)
+window     = config["output"]["average_hours"] / 24
+section_names = first.(transport_sections(config))
+archipelago   = filter(in(section_names), ["nares_strait", "jones_sound", "lancaster_sound"])
+
+isfile(offline_transport_output_file) ||
+    error("No $offline_transport_output_file: run analysis/transports.jl $config_file first")
+
+# Offline: one value per saved average, at the end of its window; the initial state (time 0), if saved, is left out
+offline_t, offline = jldopen(offline_transport_output_file) do f
+    times = f["times"] ./ 86400
+    keep  = findall(>(0), times)
+    times[keep] .- window / 2, Dict(k => f["transports/$k"][keep] for k in keys(f["transports"]))
+end
+
+# Online, where the run computed them (as in plotting/gateway_transports.jl)
+if isfile(transport_output_file)
+    online_t, online = jldopen(transport_output_file) do f
+        iterations = sort(filter(!=("serialized"), keys(f["timeseries/t"])), by = s -> parse(Int, s))[2:end]
+        t = [f["timeseries/t/$i"] for i in iterations] ./ 86400 .- window / 2
+        t, Dict(key => [only(f["timeseries/$key/$i"]) for i in iterations] for key in keys(f["timeseries"]) if key != "t")
+    end
+else
+    online_t, online = Float64[], Dict{String, Vector{Float64}}()
+end
+
+glorys_file = joinpath(output_dir, "glorys_transports.jld2")
+if isfile(glorys_file)
+    glorys_t, glorys = jldopen(glorys_file) do f
+        Dates.value.(Date.(f["dates"]) .- start_date) .+ 0.5, Dict(k => f["transports/$k"] for k in keys(f["transports"]))
+    end
+else
+    @warn "No $glorys_file: run analysis/glorys_transports.jl $config_file for the GLORYS reference"
+    glorys_t, glorys = Float64[], Dict{String, Vector{Float64}}()
+end
+
+function window_mean(t, values, key, a, b)
+    haskey(values, key) || return NaN
+    inside = findall(τ -> a ≤ τ < b, t)
+    return isempty(inside) ? NaN : sum(values[key][inside]) / length(inside)
+end
+
+# Sum over the Archipelago channels, as one more "section"
+function add_archipelago!(values)
+    isempty(archipelago) && return values
+    for quantity in ("volume", "heat", "freshwater")
+        keys_q = ["$(name)_$quantity" for name in archipelago]
+        all(k -> haskey(values, k), keys_q) && (values["archipelago_total_$quantity"] = sum(values[k] for k in keys_q))
+    end
+    return values
+end
+add_archipelago!(offline); add_archipelago!(glorys)
+rows = isempty(archipelago) ? section_names : [section_names; "archipelago_total"]
+
+fmt(x, digits) = isnan(x) ? "–" : digits == 0 ? @sprintf("%.0f", x) : digits == 2 ? @sprintf("%.2f", x) : @sprintf("%.3f", x)
+label(name) = replace(name, "_" => " ")
+
+months = Date[]
+let m = firstdayofmonth(start_date)
+    while m < end_date
+        push!(months, m)
+        m += Month(1)
+    end
+end
+month_window(m) = (max(Dates.value(m - start_date), 0), min(Dates.value(m + Month(1) - start_date), run_days))
+
+#####
+##### Tables
+#####
+
+io = IOBuffer()
+println(io, "# Section transports: $experiment ($start_date to $end_date)\n")
+println(io, "Offline transports from the daily averages; online (where the run computed them) beside them; GLORYS on its ",
+            "own grid. Positive into the Arctic. Calendar-month means; a month the run covers only partly is marked.\n")
+units = Dict("volume" => "Sv", "heat" => "TW", "freshwater" => "Sv")
+for (quantity, digits) in (("volume", 2), ("heat", 0), ("freshwater", 3))
+    println(io, "**", titlecase(quantity), " ($(units[quantity]))**\n")
+    head = ["Section"]
+    for m in months
+        a, b = month_window(m)
+        tag = b - a == daysinmonth(m) ? Dates.format(m, "u yyyy") : Dates.format(m, "u yyyy") * " [$(b - a) d]"
+        append!(head, ["$tag offline", "online", "GLORYS", "offline − GLORYS"])
+    end
+    println(io, "| ", join(head, " | "), " |")
+    println(io, "|", join(fill("---", length(head)), "|"), "|")
+    for name in rows
+        key = "$(name)_$quantity"
+        row = [label(name)]
+        for m in months
+            a, b = month_window(m)
+            off, on, gl = window_mean(offline_t, offline, key, a, b), window_mean(online_t, online, key, a, b),
+                          window_mean(glorys_t, glorys, key, a, b)
+            append!(row, [fmt(off, digits), fmt(on, digits), fmt(gl, digits), fmt(off - gl, digits)])
+        end
+        println(io, "| ", join(row, " | "), " |")
+    end
+    println(io)
+end
+
+text = String(take!(io))
+print(text)
+table_file = joinpath(output_dir, "section_comparison.md")
+write(table_file, text)
+@info "Wrote $table_file"
+
+#####
+##### Figure: daily series, offline (and online) model against GLORYS
+#####
+
+quantities = ("volume", "heat", "freshwater")
+fig = Figure(size = (280 * length(rows) + 100, 800))
+first_axis = nothing
+for (row, quantity) in enumerate(quantities), (col, name) in enumerate(rows)
+    key = "$(name)_$quantity"
+    ax = Axis(fig[row, col]; xlabel = row == length(quantities) ? "days since $start_date" : "",
+              ylabel = col == 1 ? "$quantity ($(units[quantity]))" : "", title = row == 1 ? label(name) : "")
+    row == 1 && col == 1 && (global first_axis = ax)
+    hlines!(ax, 0; color = :black, linewidth = 0.5)
+    haskey(online, key)  && lines!(ax, online_t, online[key]; color = (:red, 0.4), label = "model, online")
+    haskey(offline, key) && lines!(ax, offline_t, offline[key]; color = :red, label = "model, offline")
+    haskey(glorys, key)  && scatter!(ax, glorys_t, glorys[key]; color = :black, marker = :diamond, markersize = 6,
+                                     label = "GLORYS")
+end
+Legend(fig[length(quantities) + 1, :], first_axis; orientation = :horizontal, framevisible = false, unique = true)
+Label(fig[0, :], "$experiment: transports into the Arctic, offline from the daily output"; fontsize = 16)
+
+file = joinpath(figure_dir, "section_comparison.png")
+save(file, fig)
+@info "Wrote $file"
diff --git a/config_sep2005_15km_nz50_caa.toml b/config_sep2005_15km_nz50_caa.toml
new file mode 100644
index 0000000..688e095
--- /dev/null
+++ b/config_sep2005_15km_nz50_caa.toml
@@ -0,0 +1,92 @@
+# The 15 km, 50-level Sep–Oct 2005 run (config_sep2005_15km_nz50.toml) with three more sections, through the Canadian
+# Arctic Archipelago: Nares Strait (across Kane Basin), Jones Sound and Lancaster Sound. Together they carry the
+# Archipelago throughflow that feeds Davis Strait. For the existing run, compute them offline and for GLORYS:
+#
+#   julia +1.13 --project=. plotting/transport_sections.jl config_sep2005_15km_nz50_caa.toml   (check the lines)
+#   julia +1.13 --project=. analysis/transports.jl          config_sep2005_15km_nz50_caa.toml
+#   julia +1.13 --project=. analysis/glorys_transports.jl   config_sep2005_15km_nz50_caa.toml
+#   julia +1.13 --project=. analysis/section_comparison.jl  config_sep2005_15km_nz50_caa.toml
+#
+# Same experiment name as the run, so these read and write its output folder. Everything else is unchanged.
+
+architecture = "GPU"   # "GPU" or "CPU"
+experiment   = "sep2005_15km_nz50"  # name of the run: output and figures go to output_dir/<experiment> and figure_dir/<experiment>
+
+[grid]
+spacing_km = 15     # largest horizontal grid spacing [km] (at the pole; ~15% finer near the Atlantic edge)
+Nz         = 50     # vertical levels
+depth      = 5000   # maximum depth (m)
+bathymetry       = "GEBCO2026"   # "GEBCO2026" (15″, with IBCAO), "ETOPO" (ETOPO 2022, 60″) or "GLORYS" (GLORYS's own sea floor)
+bottom           = "partial"     # "partial": bottom cells cut at the sea floor; "full": whole cells
+partial_cell_fix = true          # with partial cells: flux-form momentum advection at bottom-cell thickness jumps
+                                 # (Oceananigans.jl#6533), which removes the bottom jets of issue #6532
+
+[time]
+start_date = 2005-09-01   # initial condition (GLORYS); the run starts at 00:00 on this date
+end_date   = 2005-11-01   # the run ends at 00:00 on this date; for short tests a date and time, e.g. 1993-01-01T03:00
+dt_minutes = 10           # time step
+
+[atmosphere]
+jra55 = "multi_year"   # "multi_year": JRA55 for the run's own dates; "repeat_year": the 1990–91 repeat year
+pressure = false           # true: JRA55's sea-level pressure acts on the ocean (nested_pressure_fix.jl). Off for now: with it,
+                           # Fram Strait drifts far from GLORYS (1–5 Jan 1993, 15 km: day 4 −12.4 Sv, GLORYS −2.1, −5.6
+                           # without pressure; the same at 100 km), which looks like an error in the pressure path, not
+                           # physics. Main has had no pressure on the ocean since #43.
+inverse_barometer = false  # with pressure = true: GLORYS's η carries no response to the pressure (issue #37), so add the
+                           # inverse-barometer sea level −(pᵃ − ⟨pᵃ⟩)/(ρ₀g) to GLORYS's η at the open sides (Flather) and
+                           # to the initial free surface; its domain mean is removed, so the volume is unchanged.
+                           # Keep false with pressure = false: then neither the model nor GLORYS feels the pressure
+
+[output]
+average_hours   = 24      # time-averaged output (3D ocean, free surface, sea ice), written to output_dir
+checkpoint_days = 30      # how often the full model state is saved for restarts
+restart         = false   # true: continue from the latest checkpoint in output_dir
+monitor_hours   = 1       # monitor.csv: transports through the open sides, mean η against GLORYS's, volume budget,
+                          # fastest point (plotting/volume_budget.jl, plotting/max_speed.jl); 0 = off
+
+[transports]
+# Volume, heat, salt and freshwater transports through the sections below and the open boundaries (see transports.jl).
+online                = true   # true: computed every time step and averaged over average_hours, written to arctic_transports.jld2
+reference_temperature = 0      # heat transport relative to this temperature (°C)
+reference_salinity    = 34.8   # freshwater transport relative to this salinity (g/kg)
+
+# Each section is a great-circle path through (longitude, latitude) waypoints. Positive transport flows to the right,
+# walking from the first waypoint to the last; these are ordered so that positive is into the Arctic. Both ends should
+# be on land, so the section spans the whole strait on any grid. Check with plotting/transport_sections.jl.
+[transports.sections]
+# Fram Strait follows the mooring array at 78°50′N; intermediate waypoints keep the great circles on that latitude.
+fram_strait         = { lon = [15.0, 10.0, 5.0, 0.0, -5.0, -10.0, -15.0, -20.0],
+                        lat = [78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333, 78.8333] }
+# Barents Sea Opening follows the mooring line from Norway (Fugløya) via Bjørnøya to Sørkapp, Svalbard.
+barents_sea_opening = { lon = [20.0, 19.0, 16.5],  lat = [70.0, 74.45, 77.0] }
+bering_strait       = { lon = [-166.0, -171.0], lat = [66.0, 66.0] }
+davis_strait        = { lon = [-53.0, -63.0],   lat = [67.0, 66.5] }
+# Canadian Arctic Archipelago. Waypoints chosen well inland on both sides, so each line spans the whole channel; a line
+# that also crosses a dead-end inlet adds nothing to the net. Positive westward or northward, into the Arctic.
+nares_strait        = { lon = [-58.0, -62.0, -66.0, -70.0, -74.0, -78.0, -80.0],
+                        lat = [79.5, 79.5, 79.5, 79.5, 79.5, 79.5, 79.5] }      # across Kane Basin, Greenland to Ellesmere
+jones_sound         = { lon = [-84.0, -84.0], lat = [77.0, 75.3] }               # Ellesmere to Devon Island
+lancaster_sound     = { lon = [-88.0, -88.0], lat = [75.3, 73.0] }               # Devon Island to Brodeur Peninsula
+
+[paths]
+data_dir   = ""   # where downloads are stored; "" = each dataset's default cache
+output_dir = "output"    # model output: time averages (.jld2), checkpoints and the config; one folder per experiment
+figure_dir = "figures"   # figures and movies from the plotting/ scripts; one folder per experiment
+
+[boundaries]
+velocity_inflow_days = 0.0417   # oblique radiation on u, v: nudging timescale toward GLORYS on inflow (0.0417 days = 1 hour).
+                                # With 1 day, a partial bottom cell on the Atlantic open face drifted to −0.9 m/s
+                                # (GLORYS −0.26); 1 hour removes it and moves the section transports by < 0.1 Sv
+tracer_inflow_km     = 20  # T, S reservoir inflow relaxation length, both open sides
+relaxation_hours     = 6   # T, S and baroclinic u, v relax toward GLORYS in a ~2/3° band along the open sides
+                           # over this timescale; 0 = off (nested_ocean_model's default is 6)
+
+# Volume control (volume_control.jl): the net inflow through the two open sides together is pinned at every barotropic
+# substep, as NEMO and ROMS do; Flather splits it between the sides. Without it the domain's volume drifts from GLORYS's.
+follow_glorys_volume      = true   # true: the net inflow follows GLORYS's domain-mean η, with the surface freshwater handed back
+volume_relaxation_days    = 1      # with follow_glorys_volume: time over which the remaining drift from GLORYS's mean η is removed
+follow_glorys_tendency    = false  # with follow_glorys_volume: true also follows GLORYS's rate of change exactly
+# net_inflow_Sv           = 0.0    # with follow_glorys_volume = false: a constant net inflow instead (Sv, positive into the domain);
+                                   # with neither, Flather alone (no volume control)
+net_inflow_depth_exponent = 0.5    # the pin's correction to each boundary column ∝ Hᵖ: 0 uniform per length, 1 uniform velocity
+                                   # (NEMO, ROMS), 0.5 a uniform shift of GLORYS's η in Flather
