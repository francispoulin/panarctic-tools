diff --git a/radiation_face_direction.jl b/radiation_face_direction.jl
new file mode 100644
index 0000000..a3096c8
--- /dev/null
+++ b/radiation_face_direction.jl
@@ -0,0 +1,11 @@
+# Diagnostic (patch 056, not for the merge): the radiation condition on the boundary-normal velocity decides inflow
+# versus outflow from the velocity on the boundary face, not on the first interior face.
+#
+# Oceananigans's ObliqueRadiation takes the direction of a NormalFlow boundary condition from the first interior value
+# (`advecting_velocity(::NFBC, …) = ψ`). In the smoke test the Atlantic face (25, 1, 4) holds v = −0.90 m/s (outflow)
+# while the first interior face holds +0.28 m/s (inflow), so the face is treated as inflow: no radiation, and only the
+# 1-day nudging toward GLORYS (−0.26 m/s). Included before the model is built.
+
+@eval Oceananigans.BoundaryConditions begin
+    @inline advecting_velocity(::NFBC, side, model_fields, grid, n, i, j, ψ) = normal_velocity(side, model_fields, grid, 0, i, j)
+end
