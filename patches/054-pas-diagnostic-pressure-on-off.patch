diff --git a/panarctic.jl b/panarctic.jl
index cd72d01..01a8dbd 100644
--- a/panarctic.jl
+++ b/panarctic.jl
@@ -4,7 +4,8 @@
 
 include("setup.jl")
 include("jra55_read_fix.jl")
-include("nested_pressure_fix.jl")
+# Patch 054 (diagnostic): [atmosphere] pressure = false leaves the atmospheric pressure off the ocean, as on main since #43
+get(config["atmosphere"], "pressure", true) && include("nested_pressure_fix.jl")
 
 # Mass-consistent momentum advection at partial bottom cells (Oceananigans.jl#6533), before the model is built
 get(config["grid"], "partial_cell_fix", false) && grid.immersed_boundary isa PartialCellBottom && include("partial_cell_fix.jl")
